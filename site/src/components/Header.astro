---
// 포털형 헤더 — 로고 · 검색 · 전체 메뉴 + 상단 탭.
// 메뉴 내용은 src/data/menu.ts 하나에서 온다. (이전 헤더는 src/legacy/HeaderLegacy.astro 에 보관)
import { SITE } from '../consts';
import { MENU, visibleTabs, allGroups, readyCount, groupHref, ICONS } from '../data/menu';

const path = Astro.url.pathname;
const tabs = visibleTabs();
// 전체 메뉴에는 실제로 들어갈 페이지가 있는 분야·항목만 보여준다(준비 중 항목은 분야 페이지의 '곧 추가돼요'에만 노출)
const groups = allGroups().filter((g) => readyCount(g) > 0).map((g) => ({ ...g, items: g.items.filter((i) => i.href) }));
// 현재 경로가 속한 탭(항목 href 로 역추적) — 없으면 홈
const hrefTab = new Map<string, string>();
for (const t of MENU) {
  hrefTab.set(t.href, t.slug);
  for (const g of t.groups) {
    hrefTab.set(`/hub/${g.slug}/`, t.slug);
    for (const i of g.items) if (i.href) hrefTab.set(i.href, t.slug);
  }
}
const match = [...hrefTab.keys()].filter((h) => h !== '/' && path.startsWith(h)).sort((a, b) => b.length - a.length)[0];
const blogTab = /^\/(blog|category|tag|column|guides|briefing|shorts|authors)(\/|$)/.test(path) ? 'guide' : undefined;
const activeTab = path === '/' ? 'home' : (match ? hrefTab.get(match) : blogTab);
const ico = (name: string) => ICONS[name] ?? ICONS.grid;
---
<header class="ph">
  <div class="ph__top">
    <a href="/" class="ph__logo" aria-label={`${SITE.name} 홈`}>Crama</a>
    <form class="ph__search" action="/search/" method="get" role="search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="search" name="q" placeholder="계산기, 조회, 글 검색" aria-label="검색" autocomplete="off" />
    </form>
    <div class="ph__acts">
      <a href="/search/" class="ph__btn ph__btn--search" aria-label="검색">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </a>
      <button class="ph__btn" id="theme-toggle" type="button" aria-label="다크 모드 전환" title="다크 모드 전환">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3v18a9 9 0 000-18z" fill="currentColor" stroke="none"/></svg>
      </button>
      <button class="ph__btn ph__menu-btn" id="pm-open" type="button" aria-haspopup="dialog" aria-controls="pm" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <span>전체 메뉴</span>
      </button>
    </div>
  </div>
  <nav class="ph__tabs" aria-label="주요 메뉴">
    <div class="ph__tabs-in">
      <a href="/" class:list={['ph__tab', { 'is-on': activeTab === 'home' }]} aria-current={activeTab === 'home' ? 'page' : undefined}>홈</a>
      {tabs.map((t) => (
        <a href={t.href} class:list={['ph__tab', { 'is-on': activeTab === t.slug }]} aria-current={activeTab === t.slug ? 'page' : undefined}>{t.name}</a>
      ))}
    </div>
  </nav>
</header>

<!-- 전체 메뉴: 왼쪽 분야 · 오른쪽 항목 -->
<div class="pm" id="pm" role="dialog" aria-modal="true" aria-label="전체 메뉴" hidden>
  <div class="pm__panel">
    <div class="pm__head">
      <form class="pm__search" action="/search/" method="get" role="search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" name="q" placeholder="검색어를 입력해 주세요" aria-label="검색" autocomplete="off" />
      </form>
      <button type="button" class="pm__close" id="pm-close" aria-label="메뉴 닫기">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="pm__body">
      <div class="pm__rail" id="pm-rail">
        {groups.map((g, i) => (
          <button type="button" class:list={['pm__rail-item', { 'is-on': i === 0 }]} data-target={`pm-g-${g.slug}`} style={`--c:${g.color}`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ico(g.icon)}></svg>
            <span>{g.name}</span>
          </button>
        ))}
      </div>
      <div class="pm__list" id="pm-list">
        {groups.map((g) => (
          <section class="pm__group" id={`pm-g-${g.slug}`} style={`--c:${g.color}`}>
            <h2>
              {readyCount(g) > 0 ? <a href={groupHref(g)}>{g.name}</a> : <span class="pm__gname">{g.name}</span>}
              <span>{readyCount(g)}</span>
            </h2>
            {g.items.map((it) =>
              it.href ? (
                <a class="pm__item" href={it.href}>
                  <span>{it.name}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                </a>
              ) : (
                <div class="pm__item is-soon"><span>{it.name}</span><em>준비 중</em></div>
              )
            )}
          </section>
        ))}
        <section class="pm__group pm__group--info">
          <h2>안내</h2>
          <a class="pm__item" href="/about/"><span>소개</span></a>
          <a class="pm__item" href="/contact/"><span>광고 문의</span></a>
          <a class="pm__item" href="/saved-picks/"><span>내 관심함</span></a>
          <a class="pm__item" href="/privacy/"><span>개인정보처리방침</span></a>
          <a class="pm__item" href="/terms/"><span>이용약관</span></a>
        </section>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // 테마 전환
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const el = document.documentElement;
    const dark = el.dataset.theme === 'dark';
    el.dataset.theme = dark ? '' : 'dark';
    try { localStorage.setItem('theme', dark ? 'light' : 'dark'); } catch (e) {}
  });

  // 전체 메뉴 열기/닫기 + 왼쪽 분야 ↔ 오른쪽 목록 연동
  (() => {
    const pm = document.getElementById('pm');
    const openBtn = document.getElementById('pm-open');
    if (!pm || !openBtn) return;
    const list = document.getElementById('pm-list');
    const rail = document.getElementById('pm-rail');
    const railItems = [...rail.querySelectorAll('.pm__rail-item')];
    const setOn = (id) => railItems.forEach((b) => b.classList.toggle('is-on', b.dataset.target === id));
    const open = (targetId) => {
      pm.hidden = false;
      document.body.style.overflow = 'hidden';
      openBtn.setAttribute('aria-expanded', 'true');
      if (targetId) { const el = document.getElementById(targetId); if (el) { list.scrollTop = el.offsetTop - list.offsetTop; setOn(targetId); } }
      document.getElementById('pm-close').focus({ preventScroll: true });
    };
    const close = () => {
      pm.hidden = true;
      document.body.style.overflow = '';
      openBtn.setAttribute('aria-expanded', 'false');
    };
    window.CramaMenu = { open, close };
    openBtn.addEventListener('click', () => open());
    document.getElementById('pm-close').addEventListener('click', close);
    pm.addEventListener('click', (e) => { if (e.target === pm) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !pm.hidden) close(); });
    document.addEventListener('click', (e) => { const t = e.target.closest('[data-open-menu]'); if (t) { e.preventDefault(); open(t.dataset.openMenu || undefined); } });
    railItems.forEach((b) => b.addEventListener('click', () => {
      const el = document.getElementById(b.dataset.target);
      if (el) list.scrollTo({ top: el.offsetTop - list.offsetTop, behavior: 'smooth' });
      setOn(b.dataset.target);
    }));
    // 목록을 스크롤하면 왼쪽 분야 표시도 따라간다
    let tick = false;
    list.addEventListener('scroll', () => {
      if (tick) return; tick = true;
      requestAnimationFrame(() => {
        tick = false;
        const top = list.scrollTop + 24;
        let cur = null;
        list.querySelectorAll('.pm__group[id]').forEach((s) => { if (s.offsetTop - list.offsetTop <= top) cur = s.id; });
        if (cur) setOn(cur);
      });
    }, { passive: true });
    document.addEventListener('astro:before-preparation', close);
  })();
</script>

<style is:global>
  .ph { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--paper) 94%, transparent); -webkit-backdrop-filter: saturate(150%) blur(12px); backdrop-filter: saturate(150%) blur(12px); border-bottom: 1px solid var(--line); }
  .ph__top { max-width: 76rem; margin: 0 auto; padding: 0.7rem 1.1rem; display: flex; align-items: center; gap: 1rem; }
  .ph__logo { font-size: 1.55rem; font-weight: 800; letter-spacing: -0.03em; color: var(--accent); text-decoration: none; line-height: 1; flex: none; }
  .ph__logo:hover { color: var(--accent); opacity: 0.85; }
  .ph__search { flex: 1; max-width: 30rem; margin-inline: auto; display: flex; align-items: center; gap: 0.5rem; padding: 0 0.95rem; height: 2.6rem; border: 1px solid var(--line); border-radius: 999px; background: var(--paper-2); color: var(--muted); }
  .ph__search:focus-within { border-color: var(--accent); background: var(--paper); }
  .ph__search input { flex: 1; min-width: 0; border: 0; background: none; outline: none; font: inherit; font-size: 0.95rem; color: var(--ink); }
  .ph__acts { display: flex; align-items: center; gap: 0.25rem; flex: none; }
  .ph__btn { display: inline-flex; align-items: center; gap: 0.4rem; height: 2.5rem; padding: 0 0.6rem; border: 0; border-radius: 10px; background: none; color: var(--ink); font: inherit; font-size: 0.9rem; font-weight: 700; cursor: pointer; text-decoration: none; }
  .ph__btn:hover { background: var(--paper-2); color: var(--accent); }
  .ph__btn--search { display: none; }
  .ph__tabs { border-top: 1px solid color-mix(in srgb, var(--line) 60%, transparent); }
  .ph__tabs-in { max-width: 76rem; margin: 0 auto; padding: 0 0.6rem; display: flex; gap: 0.2rem; overflow-x: auto; scrollbar-width: none; }
  .ph__tabs-in::-webkit-scrollbar { display: none; }
  .ph__tab { flex: none; padding: 0.72rem 0.85rem 0.62rem; font-size: 0.98rem; font-weight: 700; color: var(--muted); text-decoration: none; border-bottom: 3px solid transparent; white-space: nowrap; }
  .ph__tab:hover { color: var(--ink); }
  .ph__tab.is-on { color: var(--accent); border-bottom-color: var(--accent); }
  @media (max-width: 720px) {
    .ph__top { padding: 0.55rem 0.9rem; gap: 0.4rem; }
    .ph__search { display: none; }
    .ph__acts { margin-left: auto; }
    .ph__btn--search { display: inline-flex; }
    .ph__menu-btn span { display: none; }
    .ph__tab { padding-inline: 0.7rem; font-size: 0.94rem; }
  }

  /* 전체 메뉴 */
  .pm { position: fixed; inset: 0; z-index: 90; background: rgba(15, 14, 24, 0.5); display: flex; justify-content: center; align-items: flex-start; padding: 3.5vh 1rem; }
  .pm[hidden] { display: none; }
  .pm__panel { width: 100%; max-width: 52rem; max-height: 93vh; display: flex; flex-direction: column; background: var(--paper); border-radius: 20px; overflow: hidden; box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28); }
  .pm__head { display: flex; align-items: center; gap: 0.6rem; padding: 0.9rem 1rem; border-bottom: 1px solid var(--line); }
  .pm__search { flex: 1; display: flex; align-items: center; gap: 0.5rem; height: 2.8rem; padding: 0 1rem; border-radius: 12px; background: var(--paper-2); color: var(--muted); }
  .pm__search input { flex: 1; min-width: 0; border: 0; background: none; outline: none; font: inherit; font-size: 1rem; color: var(--ink); }
  .pm__close { flex: none; width: 2.8rem; height: 2.8rem; display: grid; place-items: center; border: 0; border-radius: 12px; background: none; color: var(--ink); cursor: pointer; }
  .pm__close:hover { background: var(--paper-2); }
  .pm__body { display: flex; min-height: 0; flex: 1; }
  .pm__rail { flex: none; width: 13.5rem; overflow-y: auto; padding: 0.6rem; border-right: 1px solid var(--line); background: var(--paper-2); }
  .pm__rail-item { width: 100%; display: flex; align-items: center; gap: 0.6rem; padding: 0.68rem 0.75rem; border: 0; border-radius: 10px; background: none; font: inherit; font-size: 0.95rem; font-weight: 600; color: var(--ink-soft); text-align: left; cursor: pointer; border-left: 3px solid transparent; }
  .pm__rail-item svg { flex: none; color: var(--c); }
  .pm__rail-item:hover { background: var(--paper); }
  .pm__rail-item.is-on { background: var(--paper); color: var(--ink); font-weight: 800; border-left-color: var(--c); }
  .pm__list { flex: 1; min-width: 0; overflow-y: auto; padding: 0.4rem 1.2rem 2rem; position: relative; }
  .pm__group { padding-top: 1.1rem; }
  .pm__group h2 { display: flex; align-items: baseline; gap: 0.45rem; margin: 0 0 0.3rem; font-size: 1.05rem; font-weight: 800; }
  .pm__group h2 a { color: var(--c, var(--ink)); text-decoration: none; }
  .pm__group h2 .pm__gname { font-size: inherit; font-weight: 800; color: var(--c, var(--ink)); }
  .pm__group h2 span { font-size: 0.8rem; font-weight: 800; color: var(--muted); }
  .pm__item { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; padding: 0.78rem 0.2rem; border-bottom: 1px solid var(--line); font-size: 0.98rem; font-weight: 600; color: var(--ink); text-decoration: none; }
  .pm__item svg { flex: none; color: var(--muted); }
  a.pm__item:hover { color: var(--accent); }
  .pm__item.is-soon { color: var(--muted); font-weight: 500; }
  .pm__item.is-soon em { font-style: normal; font-size: 0.72rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 999px; background: var(--paper-2); color: var(--muted); }
  @media (max-width: 720px) {
    .pm { padding: 0; }
    .pm__panel { max-width: none; max-height: none; height: 100%; border-radius: 0; }
    .pm__rail { width: 7.4rem; padding: 0.4rem; }
    .pm__rail-item { flex-direction: column; gap: 0.25rem; padding: 0.6rem 0.2rem; font-size: 0.76rem; text-align: center; border-left: 0; }
    .pm__rail-item.is-on { box-shadow: inset 3px 0 0 var(--c); }
    .pm__list { padding-inline: 0.9rem; }
  }
</style>
