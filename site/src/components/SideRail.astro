---
// 이어서 볼 콘텐츠 — PC에서는 본문 오른쪽에 붙어 따라오고, 모바일에서는 본문 아래에 일부만 보인다.
// 어느 주소에 붙일지는 data/rail.ts 의 RAIL_RE 가 정한다(BaseLayout 이 판단).
import AdSlot from './AdSlot.astro';
import { POPULAR, FUN, NEW_ITEMS, related, rotate } from '../data/rail';
import { groupHref } from '../data/menu';
import { partnerFor, COUPANG_NOTICE } from '../data/partners';
import '../styles/portal.css';

const path = Astro.url.pathname;
const rel = related(path);
const fun = rotate(FUN, path, 4);
const partners = partnerFor(path);
const news = NEW_ITEMS.filter((x) => !path.startsWith(x.href)).slice(0, 6);
---
<aside class="rail" aria-label="이어서 볼 콘텐츠">
  <div class="pt-box rail-pc">
    <h3>많이 찾는 조회</h3>
    <ol class="pt-rank">{POPULAR.map((p) => <li><a href={p.href}>{p.name}</a></li>)}</ol>
  </div>

  <div class="pt-box">
    <div class="rail-head"><h3>심심풀이 모음</h3><a href="/hub/fun/">전체 →</a></div>
    <div class="rail-fun">
      {fun.map((f) => (
        <a href={f.href}>
          <img src={`/img/portal/${f.img}.webp`} alt="" loading="lazy" width="320" height="320" />
          <b>{f.name}</b>
        </a>
      ))}
    </div>
  </div>

  {rel && rel.items.length > 0 && (
    <div class="pt-box">
      <div class="rail-head"><h3>이런 페이지도 있어요</h3><a href={groupHref(rel.group)}>{rel.group.name} →</a></div>
      <ul class="rail-links">{rel.items.map((it) => <li><a href={it.href}><b>{it.name}</b>{it.desc && <small>{it.desc}</small>}</a></li>)}</ul>
    </div>
  )}

  {partners.length > 0 && (
    <div class="pt-box rail-partner">
      <h3>함께 보면 좋은 상품</h3>
      <ul class="rail-links">{partners.map((p) => <li><a href={p.href} target="_blank" rel="sponsored nofollow noopener"><b>{p.label}</b><small>{p.desc}</small></a></li>)}</ul>
      <p class="rail-notice">{COUPANG_NOTICE}</p>
    </div>
  )}

  <div class="pt-box rail-pc">
    <h3>새로 나왔어요</h3>
    <ul class="rail-links">{news.map((it) => <li><a href={it.href}><b>{it.name}</b><small>{it.desc}</small></a></li>)}</ul>
  </div>

  <div class="pt-box rail-pc" id="rail-recent" hidden>
    <h3>최근 본 페이지</h3>
    <ul class="rail-links" id="rail-recent-list"></ul>
  </div>

  <div class="rail-pc"><AdSlot slot="rail-side" /></div>
</aside>

<style is:global>
  .rail { padding: 0 1.1rem 2rem; max-width: 52rem; margin: 0 auto; }
  .rail-pc { display: none; }
  .rail-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.5rem; }
  .rail-head h3 { margin: 0; }
  .rail-head a { font-size: 0.8rem; font-weight: 700; color: var(--muted); text-decoration: none; white-space: nowrap; }
  .rail-head a:hover { color: var(--accent); }
  .rail-fun { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; padding-bottom: 0.5rem; }
  .rail-fun a { display: block; color: var(--ink); text-decoration: none; min-width: 0; }
  .rail-fun img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 12px; background: var(--paper-2); }
  .rail-fun b { display: block; margin-top: 0.3rem; font-size: 0.8rem; font-weight: 700; line-height: 1.3; }
  .rail-fun a:hover b { color: var(--accent); }
  .rail-links { list-style: none; margin: 0; padding: 0; }
  .rail-links a { display: block; padding: 0.5rem 0; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .rail-links li:first-child a { border-top: 0; }
  .rail-links b { display: block; font-size: 0.92rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rail-notice { margin: 0.4rem 0 0.5rem; font-size: 0.72rem; line-height: 1.5; color: var(--muted); }
  .rail-links small { display: block; font-size: 0.76rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rail-links a:hover b { color: var(--accent); }
  @media (min-width: 1180px) {
    main.has-rail { display: grid; grid-template-columns: minmax(0, 1fr) 19.5rem; gap: 0.6rem; align-items: start; max-width: 82rem; margin: 0 auto; padding-right: 1.1rem; }
    main.has-rail > .rail-main { min-width: 0; }
    .rail { padding: 1.1rem 0 1rem; margin: 0; max-width: none; width: 100%; }
    .rail-pc { display: block; }
    .rail-pc[hidden] { display: none; }
    .rail-fun { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script is:inline>
  (() => {
    // 최근 본 페이지 — 이 기기에만 저장(최대 8개). 지금 페이지는 목록에서 빼고 보여 준다.
    const KEY = 'crama:recent-pages', here = location.pathname;
    let list = [];
    try { list = JSON.parse(localStorage.getItem(KEY) || '[]'); if (!Array.isArray(list)) list = []; } catch (e) {}
    const others = list.filter((x) => x && x.p !== here);
    const box = document.getElementById('rail-recent'), ul = document.getElementById('rail-recent-list');
    if (box && ul && others.length) {
      others.slice(0, 6).forEach((x) => {
        const li = document.createElement('li'), a = document.createElement('a'), b = document.createElement('b');
        a.href = x.p; b.textContent = x.t; a.appendChild(b); li.appendChild(a); ul.appendChild(li);
      });
      box.hidden = false;
    }
    const title = (document.title || '').split(/ [—|·] /)[0].trim().slice(0, 40);
    if (title) { try { localStorage.setItem(KEY, JSON.stringify([{ p: here, t: title }].concat(others).slice(0, 8))); } catch (e) {} }
  })();
</script>
