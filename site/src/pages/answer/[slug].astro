---
// 크라마 앤서 상품 상세 — /answer/health-partner/ 등 4개. 내용은 src/data/answer.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/answer.css';
import { ANSWER_PRODUCTS, type AnswerProduct } from '../../data/answer';
import { ANSWER_ADS, SIDO } from '../../data/answer-ads';

export function getStaticPaths() {
  return ANSWER_PRODUCTS.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props as { p: AnswerProduct };
const IMG = '/img/answer/';
const ask = `/answer/?pick=${encodeURIComponent(p.interest.join('|'))}#an-form`;
const others = ANSWER_PRODUCTS.filter((o) => o.id !== p.id);
const url = `https://crama.app/answer/${p.id}/`;
// 지역 검진 파트너: 빌드 시점 기준으로 계약 중인 시·도
const today = new Date(Date.now() + 9 * 3600e3).toISOString().slice(0, 10);
const taken = new Set(ANSWER_ADS.filter((a) => a.zone === 'health' && a.start <= today && today <= a.end && a.regions !== '*').flatMap((a) => a.regions as string[]));
const openCount = SIDO.length - SIDO.filter((s) => taken.has(s)).length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: `${p.name} (크라마 앤서)`,
      serviceType: '광고',
      description: p.desc,
      provider: { '@type': 'Organization', name: 'Crama', url: 'https://crama.app' },
      areaServed: 'KR',
      url,
    },
    { '@type': 'FAQPage', mainEntity: p.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '홈', item: 'https://crama.app/' },
        { '@type': 'ListItem', position: 2, name: '크라마 앤서', item: 'https://crama.app/answer/' },
        { '@type': 'ListItem', position: 3, name: p.name, item: url },
      ],
    },
  ],
};
---
<BaseLayout title={p.title} description={p.desc} image={`${IMG}${p.imgs[1] ?? p.imgs[0]}.webp`} jsonLd={jsonLd}>
<div class="an">

  <section class="an-dp-hero"><div class="an-wrap">
    <nav class="an-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/answer/">크라마 앤서</a> › {p.name}</nav>
    <div class="an-dp-in">
      <div>
        <p class="an-pd-no">{p.no} · {p.tag}</p>
        <h1>{p.name}</h1>
        <p class="an-lead">{p.lead}</p>
        {p.chips && <div class="an-chips">{p.chips.map((c) => <span>{c}</span>)}</div>}
        {p.tiers && <div class="an-tiers">{p.tiers.map(([t, d], k) => <div class:list={[{ strong: k === 2 }]}><b>{t}</b><span>{d}</span></div>)}</div>}
        <div class="an-cta">
          <a class="an-btn an-btn-p" href={ask}>이 상품 문의하기</a>
          <a class="an-btn an-btn-o" href={ask}>소개서·단가표 받기</a>
        </div>
        <p class="an-dp-sub">단가표와 소개서는 문의 주시면 1영업일 안에 보내 드립니다.</p>
      </div>
      <div class="an-pd-vis">
        {p.imgs.map((im, k) => <figure><img src={`${IMG}${im}.webp`} alt={p.caps[k]} width="600" height="1299" loading={k === 0 ? 'eager' : 'lazy'} /><figcaption>{p.caps[k]}</figcaption></figure>)}
      </div>
    </div>
  </div></section>

  <section class="an-sec an-alt"><div class="an-wrap">
    <div class="an-sh"><h2>이런 광고주에게 맞습니다</h2></div>
    <ul class="an-fit">{p.fit.map((f) => { const [h, ...rest] = f.split(' — '); return <li><b>{h}</b>{rest.length > 0 && <span>{rest.join(' — ')}</span>}</li>; })}</ul>
  </div></section>

  {p.id === 'health-partner' && (
    <section class="an-sec"><div class="an-wrap">
      <div class="an-sh"><h2>지역별 파트너 현황</h2><p>17개 시·도 중 {openCount}곳에서 파트너를 모집하고 있습니다. 시·도마다 한 곳만 계약합니다.</p></div>
      <div class="an-sido">{SIDO.map((s) => <a href={ask} class:list={[{ taken: taken.has(s) }]}><b>{s}</b><span>{taken.has(s) ? '계약 중' : '모집 중'}</span></a>)}</div>
    </div></section>
  )}

  <section class="an-sec"><div class="an-wrap">
    <div class="an-sh"><h2>{p.id === 'custom-plan' ? '어떻게 진행되나요' : '어떻게 노출되나요'}</h2></div>
    <ol class="an-steps2">{p.steps.map(([h, d], i) => <li><small>{String(i + 1).padStart(2, '0')}</small><b>{h}</b><span>{d}</span></li>)}</ol>
  </div></section>

  <section class="an-sec an-alt"><div class="an-wrap">
    <div class="an-two">
      <div><h2>포함 사항</h2><ul class="an-list">{p.include.map((x) => <li>{x}</li>)}</ul></div>
      <div><h2>계약·운영 원칙</h2><ul class="an-list">{p.terms.map((x) => <li>{x}</li>)}</ul></div>
    </div>
  </div></section>

  <section class="an-sec"><div class="an-wrap an-narrow">
    <div class="an-sh"><h2>{p.id === 'custom-plan' ? '연결 기획 예시' : '한눈에 보기'}</h2></div>
    <dl class="an-dl an-dl-lg">{p.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
  </div></section>

  <section class="an-sec an-alt"><div class="an-wrap an-narrow">
    <div class="an-sh"><h2>자주 묻는 질문</h2></div>
    <div class="an-faq">{p.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </div></section>

  <section class="an-sec"><div class="an-wrap">
    <div class="an-band">
      <div><h2>{p.name}, 바로 문의하세요</h2><p>관심 있는 지역·기간을 남겨 주시면 소개서와 단가표를 1영업일 안에 보내 드립니다.</p></div>
      <div class="an-band-btns"><a class="an-btn an-btn-p" href={ask}>이 상품 문의하기</a><a class="an-btn an-btn-o" href="/answer/">전체 상품 보기</a></div>
    </div>
  </div></section>

  <section class="an-sec an-alt"><div class="an-wrap">
    <div class="an-sh"><h2>다른 광고 상품</h2></div>
    <div class="an-others">
      {others.map((o) => <a href={`/answer/${o.id}/`}><small>{o.no} · {o.tag}</small><b>{o.name}</b><span>{o.lead}</span><em>자세히 보기 →</em></a>)}
    </div>
  </div></section>

  <div class="an-bar" id="an-bar">
    <a href={ask}>소개서 받기</a>
    <a href={ask} class="p">이 상품 문의</a>
  </div>
</div>

<script is:inline>
  (() => {
    const bar = document.getElementById('an-bar');
    const hero = document.querySelector('.an-dp-hero');
    if (!bar || !hero) return;
    new IntersectionObserver(([e]) => bar.classList.toggle('show', !e.isIntersecting)).observe(hero);
  })();
</script>
</BaseLayout>
