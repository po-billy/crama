        <p class="an-mail"><span>이메일</span><a href="mailto:ceo@yourteam.kr">ceo@yourteam.kr</a></p>
      </div>
      <form id="an-f" class="an-f" novalidate>
        <label>회사·기관명<input name="company" autocomplete="organization" required /></label>
        <label>담당자<input name="person" autocomplete="name" /></label>
        <label>이메일<input name="email" type="email" autocomplete="email" required /></label>
        <label>연락처 (선택)<input name="phone" type="tel" autocomplete="tel" /></label>
