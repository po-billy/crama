</div>

<script is:inline>
  (() => {
    const form = document.getElementById('an-f');
    const st = document.getElementById('an-st');
    // 버튼 → 양식으로 이동하며 관심 상품 미리 선택
    const goTo = (el) => {
      const hh = document.querySelector('header.ph')?.getBoundingClientRect().height || 0;
      window.scrollTo({ top: el.getBoundingClientRect().top + scrollY - hh - 12, behavior: 'smooth' });
      history.replaceState(null, '', '#' + el.id);
    };
    // 상품 탭 → 해당 상품으로 직접 스크롤
    document.querySelectorAll('.an-ptabs a').forEach((a) => a.addEventListener('click', (e) => {
      const t = document.getElementById(a.dataset.tab);
      if (t) { e.preventDefault(); goTo(t); }
    }));
    document.querySelectorAll('.an [data-go]').forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      goTo(document.getElementById('an-form'));
      const v = a.getAttribute('data-go');
      form.querySelectorAll('input[name=interest]').forEach((c) => { if (c.value === v || (v === '지역 검진 파트너' && c.value === v)) c.checked = true; });
      if (v === '시즌 캠페인 · 브랜드 기획전') ['시즌 캠페인', '브랜드 기획전'].forEach((n) => { const c = form.querySelector(`input[value="${n}"]`); if (c) c.checked = true; });
      if (v === '맞춤 기획') { const c = form.querySelector('input[value="맞춤 기획(여러 구좌·전 구좌)"]'); if (c) c.checked = true; }
      if (v === '소개서') form.querySelector('input[name=kit]').checked = true;
      try { gtag('event', 'answer_cta', { label: v }); } catch (e) {}
    }));
    // 상품 탭: 사이트 헤더(.ph) 바로 아래에 붙이고, 보이는 상품 강조
    const ptabs = document.querySelector('.an-ptabs');
    const ph = document.querySelector('header.ph');
    const fitTabs = () => { if (ptabs && ph) { const h = Math.round(ph.getBoundingClientRect().height); ptabs.style.top = h + 'px'; document.documentElement.style.setProperty('--an-hh', h + 'px'); } };
    fitTabs(); addEventListener('resize', fitTabs);
    const tabs = document.querySelectorAll('.an-ptabs a');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) tabs.forEach((t) => t.classList.toggle('on', t.dataset.tab === e.target.id)); }), { rootMargin: '-45% 0px -45% 0px' });
    document.querySelectorAll('.an-pd').forEach((s) => io.observe(s));
    // 모바일 하단 고정 버튼: 첫 화면·문의 양식에서는 숨김
    const bar = document.getElementById('an-bar');
    const hide = new Set();
    const io2 = new IntersectionObserver((es) => { es.forEach((e) => (e.isIntersecting ? hide.add(e.target) : hide.delete(e.target))); bar.classList.toggle('show', hide.size === 0); });
    [document.querySelector('.an-hero'), document.getElementById('an-form')].forEach((el) => el && io2.observe(el));
    // 보내기 → /api/contact (Slack)
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const email = String(d.get('email') || '').trim();
      const company = String(d.get('company') || '').trim();
      if (!company || !email) { st.textContent = '회사·기관명과 이메일을 입력해 주세요.'; st.className = 'an-st an-full err'; return; }
      const interests = d.getAll('interest').join(', ') || '선택 안 함';
      const message = [
        `[크라마 앤서 광고 문의]`,
        `관심 상품: ${interests}`,
        `소개서·단가표: ${d.get('kit') ? '받기' : '안 받음'}`,
        `담당자: ${d.get('person') || '-'} / 연락처: ${d.get('phone') || '-'}`,
        `내용: ${d.get('message') || '-'}`,
      ].join('\n');
      const btn = form.querySelector('button');
      btn.disabled = true; st.textContent = '보내는 중…'; st.className = 'an-st an-full';
      try {
        const r = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: company, email, type: '광고 문의(크라마 앤서)', message, website: d.get('website') || '' }) });
        const j = await r.json().catch(() => ({}));
        if (r.ok && j.ok) { form.reset(); st.textContent = '문의가 접수됐습니다. 1영업일 안에 소개서와 함께 연락드릴게요.'; st.className = 'an-st an-full ok'; try { gtag('event', 'answer_inquiry'); } catch (e) {} }
        else { st.textContent = j.error || '전송에 실패했습니다. ceo@yourteam.kr로 메일 주세요.'; st.className = 'an-st an-full err'; }
      } catch { st.textContent = '전송에 실패했습니다. ceo@yourteam.kr로 메일 주세요.'; st.className = 'an-st an-full err'; }
      btn.disabled = false;
    });
  })();
</script>

<style>
  .an { --ink:#1E1B3A; --ink2:#4A4763; --muted:#6E6B85; --paper:#FBFAFF; --paper2:#F2F0FC; --line:#E3E0F2; --accent:#6C5CE7; --accent-d:#5141D6; --soft:#ECE9FD; background:var(--paper); color:var(--ink); letter-spacing:-0.2px; }
  .an a { text-decoration:none; }
  .an-wrap { max-width:1200px; margin:0 auto; padding:0 32px; }
  .an-narrow { max-width:860px; }
  .an h1 { font-size:52px; line-height:1.22; font-weight:800; letter-spacing:-1.8px; margin:0 0 20px; color:var(--ink); }
  .an h1 em { font-style:normal; color:var(--accent); }
  .an h2 { font-size:36px; line-height:1.3; font-weight:800; letter-spacing:-1.2px; margin:0; color:var(--ink); }
  .an-eye { font-size:13px; font-weight:800; letter-spacing:2.5px; color:var(--accent); margin:0 0 16px; }
  .an-lead { font-size:18px; line-height:1.7; color:var(--ink2); margin:0 0 28px; }
  .an-btn { display:inline-flex; align-items:center; justify-content:center; height:48px; padding:0 22px; border-radius:12px; font-size:15px; font-weight:700; border:0; cursor:pointer; font-family:inherit; }
  .an-btn-p { background:var(--accent); color:#fff !important; }
  .an-btn-o { background:#fff; color:var(--ink) !important; border:1.5px solid var(--line); }
  .an-cta { display:flex; gap:12px; margin-bottom:24px; }
  .an-rules { display:flex; flex-wrap:wrap; gap:8px; }
  .an-rules span { font-size:13px; font-weight:600; color:var(--ink2); background:#fff; border:1px solid var(--line); border-radius:999px; padding:7px 12px; }

  /* 상단 */
  .an-hero { padding:64px 0 56px; }
  .an-hero-in { display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center; }
  .an-vis { position:relative; display:flex; align-items:center; gap:28px; justify-content:flex-end; padding-bottom:24px; }
  .an-reelwrap { position:relative; flex-shrink:0; }
  .an-reel { position:relative; width:262px; height:568px; border-radius:36px; border:8px solid var(--ink); background:#fff; overflow:hidden; box-shadow:0 40px 70px -30px rgba(30,27,58,.45); }
  .an-scr { position:absolute; inset:0; opacity:0; animation:an-reel 24s cubic-bezier(.3,.7,.3,1) infinite both; animation-delay:calc(var(--i) * 3s); }
  .an-scr img { display:block; width:100%; height:auto; }
  @keyframes an-reel { 0% { opacity:0; transform:translateY(18px) scale(.98); } 2% { opacity:1; transform:none; } 11.5% { opacity:1; transform:none; } 13.5% { opacity:0; transform:translateY(-10px); } 100% { opacity:0; } }
  .an-hud { position:absolute; left:8px; top:8px; width:246px; height:552px; pointer-events:none; overflow:hidden; border-radius:28px; }
  .an-ret { position:absolute; animation:an-track 24s cubic-bezier(.65,0,.35,1) infinite both; }
  @keyframes an-track {
    0%, 2.5%, 11% { left:11.7px; top:241.3px; width:222.5px; height:97.2px; }
    15%, 23.5% { left:7.8px; top:229.5px; width:230.4px; height:106.4px; }
    27.5%, 36% { left:11.7px; top:322.7px; width:222.5px; height:97.2px; }
