---
// 크라마 앤서(Crama Answer) — 광고·제휴 안내. 가격은 싣지 않고 문의 시 소개서·단가표를 보낸다.
// 문의는 기존 /api/contact(Slack 웹훅)로 보낸다. 증거 캡처 기준일이 바뀌면 PROOF_AS_OF만 고칠 것.
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/answer.css';
import { ANSWER_PRODUCTS } from '../../data/answer';

const PROOF_AS_OF = '2026년 11월';
const IMG = '/img/answer/';

// 상단 장면: 이미지 · 목록 이름 · 설명 · 조준선 라벨
const SCENES = [
  { img: 's-health', name: '건강검진', sub: '조회 결과 바로 아래', hud: '조회 결과 바로 아래', alt: '건강검진 조회 결과 아래 검진센터 배너' },
  { img: 's-season', name: '시즌 캠페인', sub: '성수기 홈 첫 화면', hud: '홈 첫 화면 · 시즌 배너', alt: '홈 첫 화면 시즌 캠페인 배너' },
  { img: 's-calc', name: '계산기', sub: '계산 결과 옆 서비스 소개', hud: '계산 결과 바로 아래', alt: '연봉 실수령액 결과 아래 세무 서비스 배너' },
  { img: 's-mom', name: '크라마 맘', sub: '임신 주차별 스폰서', hud: '임신 20주 정보 페이지', alt: '임신 20주 페이지의 육아용품 배너' },
  { img: 's-game', name: '게임', sub: '웹게임 입점', hud: '게임 목록 맨 위', alt: '미니게임 목록의 입점 웹게임' },
  { img: 's-test', name: '운세·테스트', sub: '브랜드 테스트 제작', hud: '테스트 목록 맨 위', alt: '운세·테스트 목록의 브랜드 테스트' },
  { img: 's-gen', name: '출생연도', sub: '세대 타겟 노출', hud: '1975년생 페이지', alt: '1975년생 페이지의 증권사 배너' },
  { img: 's-deals', name: '핫딜', sub: '브랜드 기획전', hud: '핫딜 · 브랜드 기획전', alt: '핫딜 페이지의 브랜드 기획전' },
];

// 증거 캐러셀: 확대 중심점(ox, oy)과 배율(z)은 강조 상자 위치에 맞춤
const PROOFS = [
  { img: 'p-naver-health', ox: '22%', oy: '50%', z: 2.3, cap: '네이버 AI · "1984년생 건강검진" · 첫 문단', alt: '네이버 AI 답변 첫 문단과 출처 1번째에 Crama' },
  { img: 'p-naver-mobile', ox: '50%', oy: '28%', z: 1.5, cap: '네이버 AI 모바일 · 출처 1번째', alt: '네이버 AI 모바일 출처 목록 1번째 Crama' },
  { img: 'p-naver-salary', ox: '78%', oy: '62%', z: 1.7, cap: '네이버 AI · "연봉 4200 실수령액" · 첫 문단', alt: '네이버 AI 연봉 답변 첫 문단에 Crama 인용' },
  { img: 'p-google', ox: '62%', oy: '40%', z: 1.7, cap: '구글 AI 모드 · "1954년생" · 첫 문장 출처', alt: '구글 AI 모드 첫 문장 출처 crama.app', dark: true },
];

// 대표 상품 4개 — 데이터는 src/data/answer.ts(상세 페이지와 공용)
const PRODUCTS = ANSWER_PRODUCTS;

// 구역별 제휴 아이디어
const LINEUP = [
  { img: 's-season', cat: '건강검진', name: '시즌 캠페인', desc: '12월 검진 마감, 1월 연말정산처럼 방문이 몰리는 달에 홈 첫 화면 배너로 집중 노출합니다.', who: '검진센터, 보험, 건강기능식품' },
  { img: 'l-salary', cat: '연봉·세금 계산기', name: '계산 결과 옆 서비스 소개', desc: '실수령액과 세금을 계산한 직후 절세·급여·자산관리 서비스를 소개합니다. 파트너 사이트에 크라마 계산기를 넣는 위젯 제휴도 가능합니다.', who: '세무 서비스, 증권사, HR·급여 솔루션' },
  { img: 'l-mom', cat: '크라마 맘', name: '임신 주차별 스폰서', desc: '4주부터 40주까지 주차별 정보 페이지에서, 그 시기에 필요한 제품과 서비스를 소개합니다.', who: '육아용품, 산후조리원, 태아보험' },
  { img: 'l-sudoku', cat: '게임', name: '웹게임 입점', desc: '직접 만든 웹게임을 크라마 게임 목록에 소개합니다. 크라마 안에서 바로 플레이하거나 게임 페이지로 바로 이동합니다.', who: '인디 게임 개발자, 게임 스튜디오' },
  { img: 'l-fortune', cat: '운세·테스트', name: '브랜드 테스트 제작', desc: '브랜드 주제로 결과 공유형 테스트를 만들어 운세·테스트 구역에 올립니다.', who: '소비재, 앱 서비스, 캠페인' },
  { img: 'l-home', cat: '출생연도·세대', name: '세대 타겟 노출', desc: '삼재, 학번, 국민연금 수령 나이처럼 출생연도별로 나뉜 페이지에서 원하는 세대에만 노출합니다.', who: '금융, 교육, 시니어 서비스' },
  { img: 's-deals', cat: '핫딜', name: '브랜드 기획전', desc: '핫딜 페이지의 기획전 목록 맨 위에 브랜드 기획전을 올립니다. 할인 기간에 맞춰 열고 닫습니다.', who: '리빙, 패션, 식품, 가전 브랜드' },
  { img: 'f-landing', cat: '브랜드관', name: '크라마 안의 전용 페이지', desc: '브랜드 소개, 대표 상품, 진행 중인 혜택을 한 페이지에 모아 크라마 주소로 열어 드립니다.', who: '장기 파트너, 지역 기관, 서비스 브랜드' },
  { img: 'c-article', cat: '보도자료', name: '보도자료 게재', desc: '이미 배포한 보도자료를 크라마 독자에 맞게 다시 정리해 \'보도자료\'로 표기하고, 관련 페이지와 연결합니다.', who: '신제품·신규 서비스 출시, 기관 발표' },
];

// 문의 양식의 관심 상품 — 대표 상품 4개 + 구역별 제휴
const INTERESTS = ['지역 검진 파트너', '협찬 콘텐츠 패키지', '시즌 캠페인', '브랜드 기획전', '맞춤 기획(여러 구좌·전 구좌)', '계산기 서비스 소개', '임신 주차별 스폰서', '웹게임 입점', '브랜드 테스트 제작', '세대 타겟 노출', '브랜드관', '보도자료 게재', '기타 제휴'];

const FAQ = [
  { q: '크라마 앤서는 어떤 광고인가요?', a: '크라마 앤서는 생활 조회 서비스 크라마(crama.app)의 광고 상품입니다. 건강검진 대상, 연봉 실수령액, 출산 예정일처럼 방문자가 자기 상황을 확인한 조회 결과 바로 옆에 그 상황에 맞는 브랜드를 소개합니다.' },
  { q: '광고비는 얼마인가요?', a: '구역과 기간, 지역에 따라 다릅니다. 아래 양식으로 문의를 남기시면 구역별 방문 현황과 단가표가 담긴 소개서를 1영업일 안에 보내 드립니다.' },
  { q: '최소 계약 기간이 있나요?', a: '지역 검진 파트너는 6개월·12개월 단위로 계약합니다. 시즌 캠페인과 브랜드 기획전은 1개월 단위, 협찬 콘텐츠는 건별로 진행합니다.' },
  { q: '병원·검진기관도 광고할 수 있나요?', a: '네. 월 정액 노출형으로만 진행하며 예약·방문 건당 수수료는 받지 않습니다. 광고 문구는 의료광고 규정에 맞게 사실 위주로 쓰고, 모든 광고에 \'광고\'를 표기합니다.' },
  { q: '어떤 기준으로 광고 대상을 고르나요?', a: '쿠키나 개인정보를 쓰지 않습니다. 출생연도·나이·임신 주차·연봉 구간처럼 페이지 주제와, 방문자가 직접 고른 지역만으로 노출 대상을 정합니다.' },
  { q: '광고 성과는 어떻게 확인하나요?', a: '매월 노출·클릭 리포트를 보내 드리고, 모든 광고 링크에 UTM을 붙여 광고주의 분석 도구에서도 크라마 유입을 직접 확인할 수 있습니다.' },
  { q: 'AI 답변에서 크라마가 인용된다는 근거가 있나요?', a: 'Crama 팀은 실제 서비스를 만들며 AI 답변이 크라마를 어떻게 인용하는지 계속 연구하고, 그에 맞춰 콘텐츠를 최적화하고 있습니다.', note: `${PROOF_AS_OF} 기준 네이버 AI 답변에서 '1984년생 건강검진', '연봉 4200 실수령액' 검색 시 답변 첫 문단의 출처로 크라마가 인용됐고, 구글 AI 모드에서도 '1954년생 건강검진' 답변 첫 문장의 출처가 crama.app이었습니다. AI 답변은 시점에 따라 달라질 수 있습니다.` },
] as { q: string; a: string; note?: string }[];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: '크라마 앤서 (Crama Answer)',
      serviceType: '광고·제휴',
      description: '생활 조회 서비스 크라마의 광고 상품. 조회 결과 바로 옆에 방문자 상황에 맞는 브랜드를 소개합니다.',
      provider: { '@type': 'Organization', name: 'Crama', url: 'https://crama.app' },
      areaServed: 'KR',
      url: 'https://crama.app/answer/',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: '크라마 앤서 광고 상품',
        itemListElement: PRODUCTS.map((p) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: p.name, description: p.lead } })),
      },
    },
    { '@type': 'FAQPage', mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.note ? `${f.a} ${f.note}` : f.a } })) },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: '홈', item: 'https://crama.app/' }, { '@type': 'ListItem', position: 2, name: '크라마 앤서 광고·제휴', item: 'https://crama.app/answer/' }] },
  ],
};
---
<BaseLayout
  title="크라마 앤서 — 조회 결과 옆 광고·제휴 안내 | Crama"
  description="건강검진·연봉·출산처럼 방문자가 직접 밝힌 상황 옆에 광고합니다. 네이버·구글 AI 답변이 인용하는 크라마의 지역 검진 파트너, 협찬 콘텐츠, 시즌 캠페인, 맞춤 기획 안내."
  image="/img/answer/s-health.webp"
  jsonLd={jsonLd}
>
<div class="an">

  <section class="an-hero"><div class="an-wrap an-hero-in">
    <div>
      <p class="an-eye">CRAMA ANSWER</p>
      <h1>답을 찾는 <em>순간</em>,<br>브랜드가 보입니다</h1>
      <p class="an-lead">검진·연봉·출산처럼 방문자가 직접 밝힌 상황 옆에 광고합니다.</p>
      <div class="an-cta">
        <a class="an-btn an-btn-p" href="#an-form" data-go="문의">광고 문의하기</a>
        <a class="an-btn an-btn-o" href="#an-form" data-go="소개서">소개서 받기</a>
      </div>
      <div class="an-rules"><span>페이지당 광고 최대 2개</span><span>모든 광고 ‘광고’ 표기</span><span>개인정보 없는 타겟팅</span></div>
    </div>
    <div class="an-vis">
      <div class="an-reelwrap">
        <div class="an-reel">
          {SCENES.map((s, i) => <div class="an-scr" style={`--i:${i}`}><img src={`${IMG}${s.img}.webp`} alt={s.alt} width="600" height="1299" loading={i === 0 ? 'eager' : 'lazy'} /></div>)}
        </div>
        <div class="an-hud" aria-hidden="true">
          <div class="an-ret">
            <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i><i class="scan"></i>
            <div class="an-retl"><span class="live">AD</span>{SCENES.map((s, i) => <span class="lt" style={`--i:${i}`}>{s.hud}</span>)}</div>
          </div>
        </div>
      </div>
      <ol class="an-steps">
        {SCENES.map((s, i) => <li style={`--i:${i}`}><b>{s.name}</b><span>{s.sub}</span></li>)}
      </ol>
      <p class="an-note">실제 크라마 화면에 넣은 광고 예시 · 광고주명은 가상</p>
    </div>
  </div></section>

  <div class="an-stats"><div class="an-wrap">
    <div><b>3배</b><span>직전 90일 대비<br>방문자 성장</span></div>
    <div><b>6,500+</b><span>검색으로 들어오는<br>조회·계산 페이지</span></div>
    <div><b>1947~2007</b><span>출생연도별로 나뉜<br>검진·연금·학번 페이지</span></div>
    <div><b>17개 시·도</b><span>지역별로 다른<br>광고 노출</span></div>
  </div></div>

  <section class="an-ai" id="ai-search"><div class="an-wrap an-ai-in">
    <div>
      <p class="an-eye an-eye-l">AI SEARCH</p>
      <h2>AI가 답하는 시대,<br>그 답의 첫 문장에<br>크라마가 있습니다</h2>
      <ol class="an-flow">
        <li><b>사람들은 이제 AI에게 묻습니다</b><span>링크를 하나씩 열어 보던 검색이, AI가 바로 답을 정리해 주는 검색으로 바뀌고 있습니다.</span></li>
        <li><b>브랜드는 답 밖으로 밀려났습니다</b><span>AI 답변은 몇 개의 출처만 인용합니다. 그 안에 브랜드 이름을 올리기는 점점 어려워집니다.</span></li>
        <li><b>크라마는 답의 출처가 됩니다</b><span>실제 고민을 푸는 정확한 정보를 AI가 읽고 인용하기 좋은 구조로 관리합니다.</span></li>
        <li><b>크라마로 온 고객이, 당신의 고객이 됩니다</b><span>AI 답변을 보고 들어온 사람은 이미 고민의 한가운데에 있습니다. 그 답 바로 옆에서 브랜드를 만납니다.</span></li>
      </ol>
    </div>
    <div>
      <div class="an-ph"><b>네이버·구글 AI 답변, 첫 문장의 출처 Crama</b><span>건강검진·연봉 실수령액 주요 검색어 기준 · {PROOF_AS_OF}</span></div>
      <div class="an-pstage">
        {PROOFS.map((p, i) => <div class:list={['an-pshot', { dark: p.dark }]} style={`--i:${i};--ox:${p.ox};--oy:${p.oy};--z:${p.z}`}><img src={`${IMG}${p.img}.webp`} alt={p.alt} loading="lazy" /></div>)}
        <div class="an-pcaps">{PROOFS.map((p, i) => <span style={`--i:${i}`}>{p.cap}</span>)}</div>
        <div class="an-pdots">{PROOFS.map((_, i) => <i style={`--i:${i}`}></i>)}</div>
      </div>
      <p class="an-pclose">브랜드가 AI 답변에 직접 들어가기는 어렵습니다. 대신, AI가 인용하는 곳에 브랜드를 두세요.</p>
      <a class="an-ailink" href="/blog/ai-search-checkup-center-visibility/">가이드: AI가 답하는 검색에서 검진센터가 보이려면 →</a>
    </div>
  </div></section>

  <section class="an-prod" id="products">
    <div class="an-wrap">
      <div class="an-sh"><h2>대표 광고 상품</h2><p>단가표와 소개서는 문의 주시면 1영업일 안에 보내 드립니다.</p></div>
      <nav class="an-ptabs" aria-label="대표 광고 상품">
        {PRODUCTS.map((p) => <a href={`#${p.id}`} data-tab={p.id}><small>{p.no}</small>{p.name}</a>)}
      </nav>
    </div>
    {PRODUCTS.map((p, pi) => (
      <article class:list={['an-pd', { alt: pi % 2 === 1 }]} id={p.id}>
        <div class="an-wrap an-pd-in">
          <div class="an-pd-vis">
            {p.imgs.map((im, k) => <figure><img src={`${IMG}${im}.webp`} alt={p.caps[k]} loading="lazy" width="600" height="1299" /><figcaption>{p.caps[k]}</figcaption></figure>)}
          </div>
          <div class="an-pd-txt">
            <p class="an-pd-no">{p.no} · {p.tag}</p>
            <h3>{p.name}</h3>
            <p class="an-pd-lead">{p.lead}</p>
            {p.chips && <div class="an-chips">{p.chips.map((c) => <span>{c}</span>)}</div>}
            {p.tiers && <div class="an-tiers">{p.tiers.map(([t, d], k) => <div class:list={[{ strong: k === 2 }]}><b>{t}</b><span>{d}</span></div>)}</div>}
            {p.id === 'custom-plan' && <p class="an-pd-sub">연결 기획 예시: 구역의 순간에서 다음 고민으로</p>}
            <dl class="an-dl">{p.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
            <div class="an-pd-btns">
              <a class="an-btn an-btn-p" href="#an-form" data-go={p.name} data-pick={p.interest.join('|')}>이 상품 문의하기</a>
              <a class="an-btn an-btn-o" href={`/answer/${p.id}/`}>자세히 보기 →</a>
            </div>
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="an-sec an-alt" id="lineup"><div class="an-wrap">
    <div class="an-sh"><h2>구역별 제휴 아이디어</h2><p>크라마의 각 구역은 방문자가 다릅니다. 브랜드에 맞는 구역과 방식을 함께 정합니다.</p></div>
    <div class="an-grid">
      {LINEUP.map((c) => (
        <div class="an-card">
          <div class="an-card-img"><img src={`${IMG}${c.img}.webp`} alt="" loading="lazy" width="600" height="1299" /></div>
          <div class="an-card-b"><p class="cat">{c.cat}</p><h3>{c.name}</h3><p>{c.desc}</p><p class="who"><b>어울리는 곳</b> {c.who}</p></div>
        </div>
      ))}
    </div>
  </div></section>

  <section class="an-sec"><div class="an-wrap">
    <div class="an-sh"><h2>크라마의 광고 운영 원칙</h2><p>광고가 적어야 광고가 보입니다. 방문자의 신뢰가 곧 광고 효과입니다.</p></div>
    <div class="an-prin">
      <div><small>01</small><h3>페이지당 광고 최대 2개</h3><p>팝업, 전면 광고, 자동 재생 광고는 싣지 않습니다.</p></div>
      <div><small>02</small><h3>모든 광고에 ‘광고’ 표기</h3><p>배너와 협찬 글 모두 광고임을 분명히 밝힙니다.</p></div>
      <div><small>03</small><h3>개인정보 없는 타겟팅</h3><p>쿠키나 개인정보 없이, 페이지 주제와 방문자가 고른 지역만으로 대상을 정합니다.</p></div>
      <div><small>04</small><h3>숫자로 보고</h3><p>매월 노출·클릭 리포트를 보내고, 링크에 UTM을 달아 드립니다.</p></div>
    </div>
    <ol class="an-proc">
      <li><b>문의</b><span>관심 구역과 일정을 알려 주세요.</span></li>
      <li><b>소개서·단가 안내</b><span>구역별 방문 현황과 단가표를 보내 드립니다.</span></li>
      <li><b>소재 준비</b><span>이미지 1장과 문구 2줄. 없으면 함께 만듭니다.</span></li>
      <li><b>집행</b><span>정한 기간과 지역에 맞춰 노출을 시작합니다.</span></li>
      <li><b>월간 리포트</b><span>노출·클릭을 정리해 매달 보내 드립니다.</span></li>
    </ol>
  </div></section>

  <section class="an-sec an-alt" id="faq"><div class="an-wrap an-narrow">
    <div class="an-sh"><h2>자주 묻는 질문</h2></div>
    <div class="an-faq">{FAQ.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p>{f.note && <p class="an-faq-note">{f.note}</p>}</details>)}</div>
  </div></section>

  <section class="an-sec" id="an-form"><div class="an-wrap">
    <div class="an-contact">
      <div class="an-contact-l">
        <h2>광고·제휴 문의</h2>
        <p>관심 있는 상품과 일정을 남겨 주시면, 소개서와 단가표를 1영업일 안에 보내 드립니다.</p>
        <p class="an-mail"><span>이메일</span><a href="mailto:ceo@yourteam.kr">ceo@yourteam.kr</a></p>
      </div>
      <form id="an-f" class="an-f" novalidate>
        <label>회사·기관명<input name="company" autocomplete="organization" required /></label>
        <label>담당자<input name="person" autocomplete="name" /></label>
        <label>이메일<input name="email" type="email" autocomplete="email" required /></label>
        <label>연락처 (선택)<input name="phone" type="tel" autocomplete="tel" /></label>
        <fieldset class="an-full"><legend>관심 상품 (여러 개 선택 가능)</legend>
          <div class="an-checks">{INTERESTS.map((t) => <label class="an-chk"><input type="checkbox" name="interest" value={t} /><span>{t}</span></label>)}</div>
        </fieldset>
        <label class="an-chk an-kit an-full"><input type="checkbox" name="kit" value="소개서·단가표 받기" checked /><span>소개서·단가표 받기</span></label>
        <label class="an-full">문의 내용<textarea name="message" rows="4" placeholder="원하는 지역, 기간, 궁금한 점"></textarea></label>
        <input class="an-hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit" class="an-btn an-btn-p an-full">보내기</button>
        <p class="an-st an-full" id="an-st" role="status"></p>
        <p class="an-fine an-full">남겨 주신 정보는 광고 상담에만 사용합니다.</p>
      </form>
    </div>
  </div></section>

  <div class="an-bar" id="an-bar">
    <a href="#an-form" data-go="소개서">소개서 받기</a>
    <a href="#an-form" data-go="문의" class="p">광고 문의</a>
  </div>
</div>

<script is:inline>
  (() => {
    const form = document.getElementById('an-f');
    const st = document.getElementById('an-st');
    // 버튼 → 양식으로 이동하며 관심 상품 미리 선택
    const goTo = (el) => {
      const hh = document.querySelector('header.ph')?.getBoundingClientRect().height || 0;
      window.scrollTo({ top: el.getBoundingClientRect().top + scrollY - hh - 12, behavior: 'smooth' });
      history.replaceState(null, '', '#' + el.id);
    };
    // 관심 상품 미리 체크: 'A|B' 형식
    const pick = (list) => (list || '').split('|').filter(Boolean).forEach((n) => form.querySelectorAll('input[name=interest]').forEach((c) => { if (c.value === n) c.checked = true; }));
    // 상세 페이지에서 /answer/?pick=...#an-form 으로 들어오면 미리 체크 후 양식으로 이동
    const qp = new URLSearchParams(location.search).get('pick');
    if (qp) { pick(qp); addEventListener('load', () => goTo(document.getElementById('an-form'))); }
    // 상품 탭 → 해당 상품으로 직접 스크롤
    document.querySelectorAll('.an-ptabs a').forEach((a) => a.addEventListener('click', (e) => {
      const t = document.getElementById(a.dataset.tab);
      if (t) { e.preventDefault(); goTo(t); }
    }));
    document.querySelectorAll('.an [data-go]').forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      goTo(document.getElementById('an-form'));
      const v = a.getAttribute('data-go');
      pick(a.getAttribute('data-pick'));
      if (v === '소개서') form.querySelector('input[name=kit]').checked = true;
      try { gtag('event', 'answer_cta', { label: v }); } catch (e) {}
    }));
    // 상품 탭: 사이트 헤더(.ph) 바로 아래에 붙이고, 보이는 상품 강조
    const ptabs = document.querySelector('.an-ptabs');
    const ph = document.querySelector('header.ph');
    const fitTabs = () => { if (ptabs && ph) { const h = Math.round(ph.getBoundingClientRect().height); ptabs.style.top = h + 'px'; document.documentElement.style.setProperty('--an-hh', h + 'px'); } };
    fitTabs(); addEventListener('resize', fitTabs);
    const tabs = document.querySelectorAll('.an-ptabs a');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) tabs.forEach((t) => t.classList.toggle('on', t.dataset.tab === e.target.id)); }), { rootMargin: '-45% 0px -45% 0px' });
    document.querySelectorAll('.an-pd').forEach((s) => io.observe(s));
    // 모바일 하단 고정 버튼: 첫 화면·문의 양식에서는 숨김
    const bar = document.getElementById('an-bar');
    const hide = new Set();
    const io2 = new IntersectionObserver((es) => { es.forEach((e) => (e.isIntersecting ? hide.add(e.target) : hide.delete(e.target))); bar.classList.toggle('show', hide.size === 0); });
    [document.querySelector('.an-hero'), document.getElementById('an-form')].forEach((el) => el && io2.observe(el));
    // 보내기 → /api/contact (Slack)
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const email = String(d.get('email') || '').trim();
      const company = String(d.get('company') || '').trim();
      if (!company || !email) { st.textContent = '회사·기관명과 이메일을 입력해 주세요.'; st.className = 'an-st an-full err'; return; }
      const interests = d.getAll('interest').join(', ') || '선택 안 함';
      const message = [
        `[크라마 앤서 광고 문의]`,
        `관심 상품: ${interests}`,
        `소개서·단가표: ${d.get('kit') ? '받기' : '안 받음'}`,
        `담당자: ${d.get('person') || '-'} / 연락처: ${d.get('phone') || '-'}`,
        `내용: ${d.get('message') || '-'}`,
      ].join('\n');
      const btn = form.querySelector('button');
      btn.disabled = true; st.textContent = '보내는 중…'; st.className = 'an-st an-full';
      try {
        const r = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: company, email, type: '광고 문의(크라마 앤서)', message, website: d.get('website') || '' }) });
        const j = await r.json().catch(() => ({}));
        if (r.ok && j.ok) { form.reset(); st.textContent = '문의가 접수됐습니다. 1영업일 안에 소개서와 함께 연락드릴게요.'; st.className = 'an-st an-full ok'; try { gtag('event', 'answer_inquiry'); } catch (e) {} }
        else { st.textContent = j.error || '전송에 실패했습니다. ceo@yourteam.kr로 메일 주세요.'; st.className = 'an-st an-full err'; }
      } catch { st.textContent = '전송에 실패했습니다. ceo@yourteam.kr로 메일 주세요.'; st.className = 'an-st an-full err'; }
      btn.disabled = false;
    });
  })();
</script>


</BaseLayout>
