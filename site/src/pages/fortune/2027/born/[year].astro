---
// 출생연도별 2027 운세 — "1990년생 2027년 운세" 검색어용. 띠 운세(data/fortune-2027) + 2027년 나이대 조언.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/portal.css';
import { zodiacOf } from '../../../../lib/people';
import { Y2027, ageLine } from '../../../../data/fortune-2027';

export function getStaticPaths() { const out = []; for (let y = 1950; y <= 2010; y++) out.push({ params: { year: String(y) }, props: { y } }); return out; }
const { y } = Astro.props as { y: number };
const z = zodiacOf(y);
const f = Y2027.find((x) => x.slug === z.slug)!;
const age = 2027 - y;
const short = String(y).slice(2);
const title = `${y}년생 2027년 운세 — ${short}년생 ${z.name}, ${f.keyword}`;
const desc = `${y}년생(${short}년생 ${z.name}, 2027년 만 ${age}세)의 2027년 정미년 신년운세. 총운, 재물·직장·애정·건강운, 좋은 달과 조심할 달, 행운의 색·숫자를 정리했어요.`;
---
<BaseLayout title={title} description={desc}>
  <div class="pt pt-narrow" style="--c:#dc2626">
    <nav class="pt-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/fortune/2027/">2027 신년운세</a> › <a href={`/fortune/2027/${z.slug}/`}>{z.name}</a> › {y}년생</nav>
    <header class="pt-hubhero">
      <span style="font-size:3.4rem;line-height:1" aria-hidden="true">{z.emoji}</span>
      <div><h1>{y}년생 2027년 운세</h1><p>{short}년생 {z.name} · 2027년 만 {age}세(생일 후)</p></div>
    </header>

    <div class="tl-result">
      <div class="tl-result__label">{short}년생 {z.name}의 2027년</div>
      <div class="tl-result__big" style="font-size:1.6rem">{f.keyword}</div>
      <div class="tl-result__sub">총운 {f.score}점 · 양띠 해와의 관계: {f.rel}</div>
    </div>

    <section class="pt-sec pt-prose">
      <h2>총운</h2>
      <p>{f.summary}</p>
      <p><b>{age}세에게:</b> {ageLine(age)}</p>
    </section>

    <section class="pt-sec">
      <div class="tl-wrap"><table class="tl-table"><tbody>
        <tr><td style="white-space:nowrap"><b>재물운</b></td><td>{f.money}</td></tr>
        <tr><td><b>직장·학업운</b></td><td>{f.work}</td></tr>
        <tr><td><b>애정운</b></td><td>{f.love}</td></tr>
        <tr><td><b>건강운</b></td><td>{f.health}</td></tr>
        <tr><td><b>좋은 달</b></td><td>{f.good.map((m) => `${m}월`).join(' · ')}</td></tr>
        <tr><td><b>조심할 달</b></td><td>{f.care.map((m) => `${m}월`).join(' · ')}</td></tr>
        <tr><td><b>행운</b></td><td>색 {f.color} · 숫자 {f.number} · 방향 {f.dir}</td></tr>
      </tbody></table></div>
    </section>

    <section class="pt-sec">
      <div class="pt-sec__head"><div><h2>{y}년생이 2027년에 챙길 것</h2></div></div>
      <div class="pt-chips">
        {y <= 2007 && <a class="pt-chip" href={`/health-check/${y}/`}>{y}년생 건강검진({y % 2 ? '2027년 대상' : '2028년 대상'})</a>}
        {y <= 2007 && <a class="pt-chip" href={`/born/${y}/`}>{y}년생 모아보기</a>}
        <a class="pt-chip" href="/samjae/">삼재 확인</a>
        <a class="pt-chip" href={`/fortune/${z.slug}/`}>오늘의 {z.name} 운세</a>
      </div>
      <div class="pt-chips" style="margin-top:8px">{[y - 12, y - 1, y + 1, y + 12].filter((x) => x >= 1950 && x <= 2010).map((x) => <a class="pt-chip" href={`/fortune/2027/born/${x}/`}>{x}년생 2027 운세</a>)}</div>
    </section>
    <p class="pp-note">※ 재미로 보는 운세예요. 띠는 설날·입춘 기준이라 1~2월 초에 태어났다면 앞 해 띠 운세를 함께 보세요.</p>
  </div>
</BaseLayout>
