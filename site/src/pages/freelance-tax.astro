---
// 프리랜서 3.3% 계산기 — 원천징수(소득세 3% + 지방소득세 0.3%) 후 실수령액 / 받고 싶은 금액에서 계약 금액 역산.
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import '../styles/portal.css';
const faq = [
  { q: '3.3%는 무엇인가요?', a: '프리랜서처럼 사업소득을 받는 사람에게 돈을 줄 때, 주는 쪽이 소득세 3%와 지방소득세 0.3%를 미리 떼어 국세청에 대신 내는 원천징수입니다. 100만원 계약이면 33,000원을 떼고 967,000원을 받습니다.' },
  { q: '떼인 3.3%는 돌려받을 수 있나요?', a: '다음 해 5월 종합소득세 신고에서 정산합니다. 경비와 공제를 반영해 계산한 실제 세금이 이미 낸 3.3%보다 적으면 차액을 환급받고, 많으면 더 냅니다.' },
  { q: '3.3%만 내면 세금이 끝나나요?', a: '아닙니다. 3.3%는 미리 낸 세금일 뿐이라 5월에 종합소득세 신고를 꼭 해야 합니다. 신고하지 않으면 환급을 못 받거나 무신고 가산세가 붙을 수 있습니다.' },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title="프리랜서 3.3% 계산기 — 원천징수 후 실수령액·계약 금액 역산" description="계약 금액에서 3.3%(소득세 3% + 지방소득세 0.3%)를 뗀 실수령액을 계산하고, 받고 싶은 금액에서 계약 금액을 거꾸로 계산합니다." jsonLd={jsonLd}>
  <div class="pt pt-narrow" style="--c:#10b981">
    <nav class="pt-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/hub/pay/">월급·세금</a> › 프리랜서 3.3% 계산</nav>
    <header class="pt-hubhero">
      <img src="/img/portal/c-salary.webp" alt="" width="200" height="200" />
      <div><h1>프리랜서 3.3% 계산기</h1><p>원천징수 후 통장에 들어오는 금액</p></div>
    </header>

    <section class="pt-sec">
      <div class="tl-card">
        <div class="tl-row">
          <label class="tl-field">계산 방식
            <select id="fr-mode"><option value="gross">계약 금액 → 실수령액</option><option value="net">받고 싶은 금액 → 계약 금액</option></select>
          </label>
          <label class="tl-field"><span id="fr-label">계약 금액(원)</span><input id="fr-amt" type="text" inputmode="numeric" placeholder="예: 1,000,000" /></label>
          <button type="button" class="tl-btn" id="fr-go">계산하기</button>
        </div>
        <div class="tl-quick" id="fr-quick">{[500000, 1000000, 2000000, 3000000, 5000000].map((m) => <button type="button" data-m={m}>{m / 10000}만원</button>)}</div>
      </div>
      <div class="tl-result" id="fr-result" hidden aria-live="polite">
        <div class="tl-result__label" id="fr-rl"></div>
        <div class="tl-result__big" id="fr-big"></div>
        <div class="tl-result__sub" id="fr-sub"></div>
      </div>
      <div class="pp-facts" id="fr-facts" hidden>
        <div><span>계약 금액</span><b id="fr-g"></b></div>
        <div><span>소득세 3%</span><b id="fr-t1"></b></div>
        <div><span>지방소득세 0.3%</span><b id="fr-t2"></b></div>
      </div>
      <p class="pp-note">※ 소득세와 지방소득세는 각각 10원 미만을 버립니다. 건당 소득세가 1,000원 미만이면 원천징수하지 않습니다(계약 금액 약 33,333원 미만).</p>
    </section>

    <div class="pt-ad"><AdSlot slot="freelance-mid" /></div>

    <section class="pt-sec pt-prose">
      <h2>자주 묻는 질문</h2>
      {faq.map((f) => <p><b>{f.q}</b><br />{f.a}</p>)}
    </section>

    <section class="pt-sec pp-links">
      <a class="pp-link" href="/tools/vat-calculator/"><span><b>부가세 계산기</b><span>공급가액·부가세 계산</span></span><svg class="pp-link__go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a>
      <a class="pp-link" href="/tax/"><span><b>세금 캘린더</b><span>종합소득세 신고 기간 확인</span></span><svg class="pp-link__go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a>
    </section>
  </div>

  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const cut = (x) => Math.floor((x + 1e-6) / 10) * 10;
      const won = (n) => Math.round(n).toLocaleString('ko-KR') + '원';
      const num = (s) => Number(String(s).replace(/[^0-9]/g, ''));
      const withhold = (g) => { const t1 = cut(g * 0.03); if (t1 < 1000) return [0, 0]; return [t1, cut(t1 * 0.1)]; };
      $('fr-amt').addEventListener('input', (e) => { const n = num(e.target.value); e.target.value = n ? n.toLocaleString('ko-KR') : ''; });
      $('fr-mode').addEventListener('change', () => { $('fr-label').textContent = $('fr-mode').value === 'gross' ? '계약 금액(원)' : '받고 싶은 금액(원)'; if (num($('fr-amt').value)) calc(); });
      function calc() {
        const v = num($('fr-amt').value); if (!v) { $('fr-amt').focus(); return; }
        let g = v;
        if ($('fr-mode').value === 'net') {
          g = Math.ceil(v / 0.967);
          // 절사 때문에 1~2원 모자랄 수 있어 실수령액이 목표 이상이 될 때까지 올린다
          for (let i = 0; i < 200; i++) { const t = withhold(g); if (g - t[0] - t[1] >= v) break; g += 1; }
        }
        const t = withhold(g), net = g - t[0] - t[1];
        $('fr-rl').textContent = $('fr-mode').value === 'gross' ? '실제로 받는 금액' : '이만큼 계약해야 해요';
        $('fr-big').textContent = won($('fr-mode').value === 'gross' ? net : g);
        $('fr-sub').textContent = $('fr-mode').value === 'gross' ? '3.3% ' + won(t[0] + t[1]) + '을 떼고 받아요' : '3.3%를 떼고 ' + won(net) + '을 받아요';
        $('fr-g').textContent = won(g); $('fr-t1').textContent = won(t[0]); $('fr-t2').textContent = won(t[1]);
        $('fr-result').hidden = false; $('fr-facts').hidden = false;
        try { if (window.gtag) window.gtag('event', 'tool_use', { tool: 'freelance-tax' }); } catch (e) {}
      }
      $('fr-go').addEventListener('click', calc);
      $('fr-amt').addEventListener('keydown', (e) => { if (e.key === 'Enter') calc(); });
      $('fr-quick').addEventListener('click', (e) => { const b = e.target.closest('button'); if (!b) return; $('fr-amt').value = Number(b.dataset.m).toLocaleString('ko-KR'); calc(); });
    })();
  </script>
</BaseLayout>
