---
import BaseLayout from '../../layouts/BaseLayout.astro';

const THIS_YEAR = 2026; // 짝수해 → 짝수년생 일반검진 대상(지역가입자·피부양자·직장 사무직 기준)

export async function getStaticPaths() {
  const list: number[] = [];
  for (let y = 1947; y <= 2006; y++) list.push(y);
  return list.map((y) => ({ params: { year: String(y) } }));
}

const year = Number(Astro.params.year);
const age = THIS_YEAR - year; // 만 나이(생일 지난 기준)
const eligible = year % 2 === THIS_YEAR % 2;
const nextYear = eligible ? THIS_YEAR : THIS_YEAR + 1;

// 연령별 국가암검진(만 나이 기준)
const cancers = [
  { name: '위암', ok: age >= 40, rule: '만 40세부터 2년마다 (위내시경)' },
  { name: '대장암', ok: age >= 50, rule: '만 50세부터 매년 (분변잠혈검사)' },
  { name: '유방암', ok: age >= 40, rule: '만 40세부터 2년마다 (여성)' },
  { name: '자궁경부암', ok: age >= 20, rule: '만 20세부터 2년마다 (여성)' },
  { name: '간암', ok: age >= 40, rule: '만 40세부터, 고위험군 6개월마다' },
  { name: '폐암', ok: age >= 54 && age <= 74, rule: '만 54~74세 고위험군(장기 흡연) 2년마다' },
];
const myCancers = cancers.filter((c) => c.ok);

// 성·연령별 추가 검사 — 국민건강보험공단 일반건강검진 안내(2026년) 기준. 검진 나이는 '검진 연도 - 출생연도'로 센다.
// 해마다 조정되므로 1월에 공단 안내를 확인해 고칠 것(2025년 C형간염, 2026년 폐기능 검사가 새로 들어왔다).
const extras: { name: string; who: string; note: string }[] = [];
const add = (name: string, who: string, note: string) => extras.push({ name, who, note });
const lipidM = age >= 24 && (age - 24) % 4 === 0;
const lipidF = age >= 40 && age % 4 === 0;
if (lipidM || lipidF) add('이상지질혈증(콜레스테롤)', lipidM && lipidF ? '남녀 모두' : lipidM ? '남성' : '여성', '남성 24세·여성 40세부터 4년마다');
if (age === 40) add('B형간염', '남녀 모두', '40세에 한 번(보균자·면역자 제외)');
if (age === 56) add('C형간염', '남녀 모두', '56세에 한 번');
if (age === 56 || age === 66) add('폐기능 검사', '남녀 모두', '56세·66세에 한 번씩');
if ([54, 60, 66].includes(age)) add('골밀도 검사', '여성', '54세·60세·66세');
if (age >= 66) add('인지기능장애 검사', '남녀 모두', '66세부터 2년마다');
if (age >= 20 && age <= 34) add('정신건강검사(우울증·조기정신증)', '남녀 모두', '20~34세 2년마다');
if ([40, 50, 60, 70].includes(age)) add('생활습관평가', '남녀 모두', '40·50·60·70세');
if ([66, 70, 80].includes(age)) add('노인신체기능 검사', '남녀 모두', '66·70·80세');
if (age === 40) add('치면세균막 검사(구강)', '남녀 모두', '40세');
const depressionBand = age >= 35 && age <= 79;
const isTransition = age === 40 || age === 56 || age === 66; // 추가 검사가 여러 개 붙는 나이

const pageTitle = `${year}년생 건강검진 — ${THIS_YEAR}년 대상${eligible ? '입니다' : ' 아님(내년)'} · 검진 항목`;
const pageDesc = `${year}년생(${String(year).slice(2)}년생, 만 ${age}세)은 ${THIS_YEAR}년 국가건강검진 대상${eligible ? '입니다' : `이 아니며 ${nextYear}년 대상입니다`}. 받을 수 있는 암검진 ${myCancers.length}종과 일반검진 항목, 신청 방법까지 정리했어요.`;
---
<BaseLayout title={pageTitle} description={pageDesc}>
  <div class="wrap hc">
    <nav class="hc-crumb"><a href="/">홈</a><span>›</span><a href="/health-check/">건강검진 조회</a><span>›</span><b>{year}년생</b></nav>
    <h1>{year}년생, 올해 건강검진 대상일까?</h1>

    <div class={`hc-hero ${eligible ? 'is-yes' : 'is-no'}`}>
      <b>{eligible ? `✅ ${THIS_YEAR}년 검진 대상입니다` : `⏳ 올해는 아니에요 — ${nextYear}년 대상`}</b>
      <span>만 {age}세 · {THIS_YEAR}년은 {THIS_YEAR % 2 === 0 ? '짝수' : '홀수'}해라 {THIS_YEAR % 2 === 0 ? '짝수' : '홀수'}년생이 대상 {isTransition ? `· 만 ${age}세 확대 검진(추가 항목) 해당` : ''}</span>
      {eligible && <em>12월 31일까지 받으면 됩니다 — 연말엔 예약이 몰려요</em>}
    </div>

    <section class="hc-sec">
      <h2>받을 수 있는 국가암검진 {myCancers.length}종</h2>
      {myCancers.length ? (
        <ul class="hc-list">
          {myCancers.map((c) => <li><b>{c.name}</b><span>{c.rule}</span></li>)}
        </ul>
      ) : <p class="hc-empty">아직 암검진 대상 연령(만 20세~)이 아니에요. 일반검진(진찰·혈액·소변 등)은 만 20세부터!</p>}
      <p class="hc-note">※ 유방암·자궁경부암은 여성 대상. 간암·폐암은 고위험군 기준. 비사무직 직장가입자는 일반검진을 매년 받아요.</p>
    </section>

    <section class="hc-sec">
      <h2>{year}년생 일반건강검진 항목</h2>
      <ul class="hc-list">
        <li><b>진찰·상담</b><span>문진, 과거 병력과 생활 습관 확인</span></li>
        <li><b>신체 계측</b><span>키, 몸무게, 허리둘레, 체질량지수</span></li>
        <li><b>혈압·시력·청력</b><span>기본 측정</span></li>
        <li><b>흉부 방사선 촬영</b><span>폐와 심장 상태 확인</span></li>
        <li><b>혈액 검사</b><span>빈혈, 공복혈당, 간 기능, 신장 기능</span></li>
        <li><b>소변 검사</b><span>요단백</span></li>
        <li><b>구강 검진</b><span>치과에서 따로 받음</span></li>
      </ul>
      <p class="hc-note">※ 모든 대상자가 받는 공통 항목입니다.</p>

      <h3 class="hc-h3">{year}년생이 {THIS_YEAR}년에 추가로 받는 검사</h3>
      {extras.length ? (
        <ul class="hc-list">
          {extras.map((e) => <li><b>{e.name}</b><span>{e.who} · {e.note}</span></li>)}
        </ul>
      ) : <p class="hc-empty">{THIS_YEAR}년 검진 나이 {age}세에는 나이로 정해진 추가 검사가 없어요. 공통 항목만 받습니다.</p>}
      <p class="hc-note">※ 검진 나이는 {THIS_YEAR}년에서 출생연도를 뺀 {age}세로 계산했습니다(국민건강보험공단 {THIS_YEAR}년 안내 기준).{depressionBand ? ' 우울증 검사는 30대 후반부터 70대까지 연령대마다 한 번씩 받는데, 받는 해는 검진표에 표시됩니다.' : ''}{eligible ? '' : ` ${year}년생은 2년 주기로는 ${nextYear}년 대상이라, 위 항목은 비사무직 직장가입자처럼 올해 검진을 받는 경우에 해당합니다.`} 실제 항목은 공단이 보내는 검진표가 기준이니, 검진표나 건강보험25시 앱(옛 The건강보험), 공단 고객센터(1577-1000)에서 확인하세요. 자세한 설명은 <a href="/blog/health-checkup-items-by-age-2026/">나이별 건강검진 항목 정리</a>에 있습니다.</p>
    </section>

    <section class="hc-sec">
      <h2>어떻게 받나</h2>
      <ul class="hc-steps">
        <li><b>대상 확인</b> — 국민건강보험공단에서 검진표 발송(모바일 확인 가능)</li>
        <li><b>병원 예약</b> — 공단 홈페이지·앱에서 가까운 검진기관 검색 후 예약</li>
        <li><b>무료</b> — 국가검진 항목은 본인부담 없음(추가 선택 항목만 유료)</li>
      </ul>
    </section>

    <section class="hc-sec">
      <h2>함께 읽으면 좋은 글</h2>
      <ul class="hc-reads">
        <li><a href="/blog/health-checkup-items-by-age-2026/">{THIS_YEAR}년 건강검진 항목, 나이별·성별 정리</a></li>
        <li><a href="/blog/health-checkup-deadline-missed-2026/">12월 31일까지 못 받으면 어떻게 되나</a></li>
        <li><a href="/blog/health-checkup-eligibility-check-how-to/">건강검진 대상인지 확인하는 법</a></li>
        <li><a href="/blog/health-checkup-office-vs-non-office-worker/">사무직·비사무직 검진 주기 차이</a></li>
        <li><a href="/blog/office-or-non-office-worker-checkup-criteria/">나는 사무직일까 비사무직일까, 직종별 기준</a></li>
        <li><a href="/blog/national-cancer-screening-by-age/">국가 암검진 6종, 나이별로 받는 것</a></li>
        <li><a href="/blog/colon-stomach-cancer-screening-where-cost/">대장암·위암 검진 받는 곳과 비용</a></li>
        <li><a href="/blog/employee-health-checkup-employer-duties/">직원 건강검진, 회사가 챙길 일</a></li>
        {!eligible && <li><a href="/blog/health-checkup-2027-odd-year-born/">2027년 건강검진 대상은 홀수년생</a></li>}
      </ul>
    </section>

    <div class="hc-pn">
      {year > 1947 && <a href={`/health-check/${year - 1}/`}>← {year - 1}년생</a>}
      <a href="/health-check/">전체 표</a>
      {year < 2006 && <a href={`/health-check/${year + 1}/`}>{year + 1}년생 →</a>}
    </div>
    <div class="hc-cross">
      <a href={`/born/${year}/`}>{year}년생 나이·띠·같은 해 인물 →</a>
      <a href={`/pension-age/${year}/`}>{year}년생 국민연금 수령 나이 →</a>
      <a href={`/samjae/${year}/`}>{year}년생 삼재 →</a>
      <a href="/health-check/cancer/">암검진 대상 조회 →</a>
      <a href="/welfare/">의료비 지원 복지 찾기 →</a>
      <a href="/benefits/">내 지원금 매칭 →</a>
    </div>
  </div>

  <style>
    .hc { max-width: 40rem; }
    .hc-crumb { display: flex; gap: 0.45rem; font-size: 0.8rem; color: var(--muted); margin: 0.4rem 0 1.1rem; }
    .hc-crumb a { color: var(--muted); text-decoration: none; }
    .hc h1 { font-family: var(--font-serif); font-size: clamp(1.4rem, 4.5vw, 2rem); margin: 0 0 1rem; }
    .hc-hero { border-radius: 16px; padding: 1.2rem 1.4rem; display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 1.6rem; }
    .hc-hero.is-yes { background: color-mix(in srgb, #22c55e 12%, var(--paper)); border: 1.5px solid #22c55e; }
    .hc-hero.is-no { background: var(--paper-2); border: 1px solid var(--line); }
    .hc-hero b { font-size: 1.15rem; }
    .hc-hero span { font-size: 0.86rem; color: var(--ink-soft); }
    .hc-hero em { font-style: normal; font-size: 0.82rem; color: #16a34a; font-weight: 700; }
    .hc-sec { margin-bottom: 1.7rem; }
    .hc-sec h2 { font-size: 1.1rem; margin: 0 0 0.7rem; }
    .hc-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
    .hc-list li { display: flex; justify-content: space-between; gap: 0.8rem; align-items: baseline; padding: 0.6rem 0.85rem; border: 1px solid var(--line); border-radius: 10px; }
    .hc-list b { font-size: 0.92rem; }
    .hc-list span { font-size: 0.78rem; color: var(--muted); text-align: right; }
    .hc-h3 { font-size: 1rem; margin: 1.3rem 0 0.6rem; }
    .hc-note a { color: var(--accent); }
    .hc-reads { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.45rem; font-size: 0.93rem; }
    .hc-reads a { color: var(--accent); font-weight: 700; text-decoration: none; }
    .hc-reads a:hover { text-decoration: underline; }
    .hc-empty { font-size: 0.9rem; color: var(--ink-soft); }
    .hc-note { font-size: 0.78rem; color: var(--muted); margin: 0.7rem 0 0; line-height: 1.5; }
    .hc-steps { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.5rem; font-size: 0.92rem; color: var(--ink-soft); line-height: 1.55; }
    .hc-pn { display: flex; justify-content: space-between; gap: 0.6rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
    .hc-pn a { font-size: 0.86rem; font-weight: 700; color: var(--accent); text-decoration: none; }
    .hc-cross { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; margin: 1.6rem 0 1rem; }
    .hc-cross a { font-size: 0.88rem; font-weight: 700; color: var(--accent); text-decoration: none; padding: 0.5rem 1rem; border: 1px solid var(--line); border-radius: 999px; }
    .hc-cross a:hover { border-color: var(--accent); }
  </style>
</BaseLayout>
