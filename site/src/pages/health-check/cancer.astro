---
// 국가 암검진 대상 조회 — 출생연도·성별로 올해 받을 수 있는 6대 암검진을 알려준다.
// 기준: 국가암검진사업(위·간·대장·유방·자궁경부·폐). 연령은 만 나이, 2년 주기 검진은 출생연도 홀짝으로 대상 연도가 정해진다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import '../../styles/portal.css';
const THIS_YEAR = 2026;
const years: number[] = [];
for (let y = 2006; y >= 1940; y--) years.push(y);
const RULES = [
  { name: '위암', from: 40, to: 200, sex: 'all', cycle: 2, how: '위내시경(또는 위장조영검사)', note: '' },
  { name: '대장암', from: 50, to: 200, sex: 'all', cycle: 1, how: '분변잠혈검사 → 이상 시 대장내시경', note: '매년' },
  { name: '간암', from: 40, to: 200, sex: 'all', cycle: 0.5, how: '간 초음파 + 혈액검사(AFP)', note: '고위험군만(B·C형 간염, 간경변 등) · 6개월마다' },
  { name: '유방암', from: 40, to: 200, sex: 'f', cycle: 2, how: '유방촬영술', note: '' },
  { name: '자궁경부암', from: 20, to: 200, sex: 'f', cycle: 2, how: '자궁경부세포검사', note: '' },
  { name: '폐암', from: 54, to: 74, sex: 'all', cycle: 2, how: '저선량 흉부 CT', note: '고위험군만(30갑년 이상 흡연력)' },
];
const faq = [
  { q: '국가 암검진은 무료인가요?', a: '위암·간암·대장암·유방암·폐암은 본인부담 10%(건강보험료 하위 50%와 의료급여 수급권자는 무료)이고, 자궁경부암과 대장암(분변잠혈검사)은 전액 무료입니다.' },
  { q: '올해 대상인지 어떻게 정해지나요?', a: `2년 주기 검진은 출생연도 끝자리로 정해집니다. ${THIS_YEAR}년은 ${THIS_YEAR % 2 === 0 ? '짝수' : '홀수'}년생이 대상입니다. 대장암은 만 50세부터 매년, 간암은 고위험군에 한해 6개월마다 받습니다.` },
  { q: '대상인데 올해 못 받으면 어떻게 되나요?', a: '일반적으로 그해 12월 말까지 받아야 하고, 놓치면 다음 대상 연도까지 기다려야 합니다. 다만 건강보험공단에 신청하면 다음 해에 추가 검진 대상으로 등록할 수 있는 경우가 있으니 공단(1577-1000)에 문의하세요.' },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title={`암검진 대상 조회 ${THIS_YEAR} — 출생연도로 보는 국가 암검진 6종`} description={`출생연도와 성별만 고르면 ${THIS_YEAR}년에 받을 수 있는 국가 암검진(위암·대장암·간암·유방암·자궁경부암·폐암)을 바로 알려드립니다.`} jsonLd={jsonLd}>
  <div class="pt pt-narrow" style="--c:#ef4444">
    <nav class="pt-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/hub/health/">건강검진·건강</a> › 암검진 대상 조회</nav>
    <header class="pt-hubhero">
      <img src="/img/portal/c-checkup.webp" alt="" width="200" height="200" />
      <div><h1>암검진 대상 조회</h1><p>{THIS_YEAR}년에 받을 수 있는 국가 암검진 6종</p></div>
    </header>

    <section class="pt-sec">
      <div class="tl-card">
        <div class="tl-row">
          <label class="tl-field">출생연도<select id="cc-year">{years.map((y) => <option value={y} selected={y === 1980}>{y}년생</option>)}</select></label>
          <label class="tl-field">성별<select id="cc-sex"><option value="f">여성</option><option value="m">남성</option></select></label>
          <button type="button" class="tl-btn" id="cc-go">조회하기</button>
        </div>
      </div>
      <div class="tl-result" id="cc-result" hidden aria-live="polite">
        <div class="tl-result__label" id="cc-label"></div>
        <div class="tl-result__big" id="cc-big"></div>
        <div class="tl-result__sub" id="cc-sub"></div>
      </div>
      <div class="tl-wrap" id="cc-wrap" hidden style="margin-top:0.8rem">
        <table class="tl-table"><thead><tr><th>암검진</th><th>올해</th><th>검사 방법</th></tr></thead><tbody id="cc-body"></tbody></table>
      </div>
      <p class="pp-note">※ 국가암검진사업 기준(만 나이는 {THIS_YEAR}년에 도달하는 나이로 계산). 간암·폐암은 고위험군으로 확인된 경우에만 대상이며, 실제 대상 여부는 건강보험공단이 보내는 검진표나 <a href="https://www.nhis.or.kr" target="_blank" rel="noopener nofollow">국민건강보험공단</a>(1577-1000)에서 확인하세요.</p>
    </section>

    <div class="pt-ad"><AdSlot slot="cancer-mid" /></div>

    <section class="pt-sec">
      <div class="pt-sec__head"><div><h2>국가 암검진 6종 기준</h2></div></div>
      <div class="tl-wrap">
        <table class="tl-table">
          <thead><tr><th>암</th><th>대상</th><th>주기</th></tr></thead>
          <tbody>
            <tr><td>위암</td><td>만 40세 이상</td><td>2년</td></tr>
            <tr><td>대장암</td><td>만 50세 이상</td><td>1년</td></tr>
            <tr><td>간암</td><td>만 40세 이상 고위험군</td><td>6개월</td></tr>
            <tr><td>유방암</td><td>만 40세 이상 여성</td><td>2년</td></tr>
            <tr><td>자궁경부암</td><td>만 20세 이상 여성</td><td>2년</td></tr>
            <tr><td>폐암</td><td>만 54~74세 고위험군</td><td>2년</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="pt-sec pt-prose">
      <h2>자주 묻는 질문</h2>
      {faq.map((f) => <p><b>{f.q}</b><br />{f.a}</p>)}
    </section>

    <section class="pt-sec pp-links">
      <a class="pp-link" href="/health-check/"><span><b>일반 건강검진 대상 조회</b><span>출생연도별 {THIS_YEAR}년 대상 여부</span></span><svg class="pp-link__go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a>
      <a class="pp-link" href="/health/bmi/"><span><b>BMI 계산기</b><span>키·몸무게로 비만도 확인</span></span><svg class="pp-link__go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a>
    </section>
  </div>

  <script is:inline define:vars={{ RULES, THIS_YEAR }}>
    (() => {
      const $ = (id) => document.getElementById(id);
      function calc() {
        const y = Number($('cc-year').value), sex = $('cc-sex').value, age = THIS_YEAR - y;
        const evenMatch = (y % 2) === (THIS_YEAR % 2);
        const body = $('cc-body'); body.textContent = ''; let n = 0;
        RULES.forEach((r) => {
          let state = '', on = false;
          if (r.sex === 'f' && sex !== 'f') state = '해당 없음';
          else if (age < r.from) state = '만 ' + r.from + '세부터';
          else if (age > r.to) state = '대상 연령 지남';
          else if (r.cycle === 2 && !evenMatch) state = '내년 대상';
          else { state = r.note ? '대상 · ' + r.note : '대상'; on = true; n++; }
          const tr = document.createElement('tr');
          [r.name, state, r.how].forEach((c, i) => { const td = document.createElement('td'); td.textContent = c; if (i === 1 && on) td.className = 'is-on'; tr.appendChild(td); });
          body.appendChild(tr);
        });
        $('cc-label').textContent = y + '년생 ' + (sex === 'f' ? '여성' : '남성') + ' · ' + THIS_YEAR + '년 만 ' + age + '세';
        $('cc-big').textContent = n ? '암검진 ' + n + '종 대상' : '올해 대상 없음';
        $('cc-sub').textContent = n ? '고위험군 조건이 붙은 항목은 해당할 때만 받아요' : '아래 표에서 다음 대상 시기를 확인하세요';
        $('cc-result').hidden = false; $('cc-wrap').hidden = false;
        try { if (window.gtag) window.gtag('event', 'tool_use', { tool: 'cancer-check' }); } catch (e) {}
      }
      $('cc-go').addEventListener('click', calc);
      $('cc-year').addEventListener('change', calc); $('cc-sex').addEventListener('change', calc);
    })();
  </script>
</BaseLayout>
