---
// 건강검진 결과 수치 해석기 — 결과지 숫자를 넣으면 공식 판정기준으로 정상·경계·질환의심을 보여 준다.
// 입력값은 저장하지도 보내지도 않는다(브라우저 안에서만 계산).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnswerSlot from '../../../components/AnswerSlot.astro';
import '../../../styles/portal.css';
import '../../../styles/lab.css';
import { LAB } from '../../../lib/lab';

const FIELDS = [
  { set: '혈압·비만', items: [['sbp', '수축기 혈압', 'mmHg', '예: 128'], ['dbp', '이완기 혈압', 'mmHg', '예: 82'], ['height', '키', 'cm', '예: 170'], ['weight', '몸무게', 'kg', '예: 72'], ['waist', '허리둘레', 'cm', '예: 86']] },
  { set: '혈당·콜레스테롤', items: [['fasting-glucose', '공복혈당', 'mg/dL', '예: 104'], ['total-cholesterol', '총콜레스테롤', 'mg/dL', '예: 210'], ['ldl', 'LDL 콜레스테롤', 'mg/dL', '예: 135'], ['hdl', 'HDL 콜레스테롤', 'mg/dL', '예: 52'], ['triglyceride', '중성지방', 'mg/dL', '예: 160'], ['hemoglobin', '혈색소', 'g/dL', '예: 14.2']] },
  { set: '간·신장', items: [['ast', 'AST(SGOT)', 'U/L', '예: 28'], ['alt', 'ALT(SGPT)', 'U/L', '예: 41'], ['ggt', '감마지티피', 'U/L', '예: 55'], ['creatinine', '혈청크레아티닌', 'mg/dL', '예: 0.9'], ['egfr', 'eGFR', 'mL/min', '예: 95']] },
];
const faq = [
  { q: '결과지의 정상A, 정상B, 질환의심은 무슨 뜻인가요?', a: '정상A는 건강한 상태, 정상B(경계)는 정상 범위를 벗어나기 시작해 생활 관리가 필요한 단계, 질환의심은 해당 질환이 있을 가능성이 있어 진료나 추가 검사가 필요한 단계입니다. 보건복지부 건강검진 실시기준의 검사항목별 판정기준을 따릅니다.' },
  { q: '입력한 수치는 저장되나요?', a: '아니요. 모든 계산은 이 브라우저 안에서만 하고 어디에도 저장하거나 보내지 않습니다. 창을 닫으면 사라집니다.' },
  { q: '고혈압·당뇨병 질환의심이 나오면 어떻게 하나요?', a: '일반건강검진에서 고혈압·당뇨병 질환의심이 나오면 병·의원에서 확진검사(고혈압은 진찰, 당뇨병은 진찰과 혈당검사)를 본인부담 없이 받을 수 있습니다. 기한은 결과통보서에 적힌 날짜를 따르세요.' },
  { q: '수치 하나만 높아도 병원에 가야 하나요?', a: '경계 한두 개는 생활 습관을 점검하고 다음 검진에서 다시 보는 경우가 많습니다. 질환의심이 있거나 여러 항목이 함께 나쁘면 진료로 확인하는 것이 좋습니다.' },
];
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'WebApplication', name: '건강검진 결과 수치 해석', applicationCategory: 'HealthApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' }, url: 'https://crama.app/health-check/result/' },
] };
---
<BaseLayout title="건강검진 결과 해석 — 혈압·혈당·콜레스테롤·간수치 정상인지 한 번에 (판정기준)" description="건강검진 결과지의 혈압, 공복혈당, 콜레스테롤, 중성지방, 간수치(AST·ALT·감마지티피), 신장 수치를 넣으면 국가건강검진 판정기준으로 정상·경계·질환의심을 바로 알려 줍니다. 입력값은 저장하지 않아요." jsonLd={jsonLd}>
<div class="pt pt-narrow lb" style="--c:#DC2626">
  <nav class="pt-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/health-check/">건강검진</a> › 결과 수치 해석</nav>
  <header class="lb-hero">
    <small>건강검진 결과</small>
    <h1>건강검진 결과지, 수치로 해석하기</h1>
    <p>결과지에 적힌 숫자를 아는 것만 넣으세요. 국가건강검진 판정기준으로 정상·경계·질환의심을 나누고, 무엇을 하면 되는지 알려 드려요. 입력값은 저장하지도 보내지도 않아요.</p>
  </header>

  <section class="pt-sec lb-form">
    <div class="lb-sex" id="sex"><button type="button" data-v="m" class="on">남성</button><button type="button" data-v="f">여성</button></div>
    {FIELDS.map((f) => (
      <fieldset>
        <legend>{f.set}</legend>
        <div class="lb-grid">
          {f.items.map(([id, label, unit, ph]) => <label>{label} <small style="font-weight:600;color:#94a3b8">{unit}</small><input id={`in-${id}`} inputmode="decimal" placeholder={ph} autocomplete="off" /></label>)}
          {f.set === '간·신장' && <label>요단백<select id="in-protein"><option value="">모름</option><option value="A">음성(-)</option><option value="B">약양성(±)</option><option value="D">양성(+1 이상)</option></select></label>}
        </div>
      </fieldset>
    ))}
    <button type="button" class="lb-go" id="go">결과 해석하기</button>
  </section>

  <section class="lb-out" id="out" hidden aria-live="polite">
    <div class="lb-sum"><div class="D"><b id="n-D">0</b><span>질환의심</span></div><div class="B"><b id="n-B">0</b><span>경계</span></div><div class="A"><b id="n-A">0</b><span>정상</span></div></div>
    <p id="headline" style="font-weight:800;line-height:1.6"></p>
    <div class="lb-cards" id="cards"></div>
    <p class="lb-warn" id="confirm" hidden><b>확진검사는 본인부담 없이:</b> 고혈압·당뇨병 질환의심이면 병·의원에서 확진검사(고혈압은 진찰, 당뇨병은 진찰과 혈당검사)를 본인부담 없이 받을 수 있어요. 기한은 결과통보서에 적힌 날짜를 따르세요.</p>
  </section>

  <AnswerSlot zone="health" />

  <section class="pt-sec">
    <h2>항목별 정상수치</h2>
    <div class="lb-vals">{LAB.map((o) => <a href={`/health-check/result/${o.slug}/`}>{o.short}</a>)}</div>
  </section>

  <section class="pt-sec pt-prose">
    <h2>결과지 읽는 법</h2>
    <ul>
      <li><b>종합판정</b>은 정상A, 정상B(경계), 일반질환의심, 고혈압·당뇨병 질환의심, 유질환자 같은 말로 적혀요. 이 페이지는 항목별 수치를 다시 확인할 때 쓰세요.</li>
      <li>검사 전 금식이 부족했거나 전날 술·과식·심한 운동을 했다면 혈당·중성지방·간수치가 높게 나올 수 있어요.</li>
      <li>당뇨병이 있다면 LDL은 100 미만을 목표로 한다는 단서가 판정기준표에 있어요.</li>
    </ul>
    <h2>자주 묻는 질문</h2>
    {faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
  </section>
  <p class="lb-warn">국가건강검진 판정기준(보건복지부 「건강검진 실시기준」 별표 4의 별첨)으로 수치를 설명하는 도구이며 의학적 진단이 아닙니다. 결과가 걱정되면 의사와 상담하세요.</p>
</div>

<script>
  import { LAB, LEVEL_SHORT, josa, type Sex, type Level } from '../../../lib/lab';
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  let sex: Sex = 'm';
  $('sex').querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { $('sex').querySelectorAll('button').forEach((x) => x.classList.remove('on')); b.classList.add('on'); sex = (b as HTMLElement).dataset.v as Sex; if (!$('out').hidden) run(); }));
  const num = (id: string) => { const el = document.getElementById(`in-${id}`) as HTMLInputElement | null; if (!el) return NaN; const v = parseFloat(el.value.replace(/,/g, '')); return Number.isFinite(v) ? v : NaN; };
  type Row = { name: string; val: string; lv: Level; note: string; href?: string };

  function run() {
    const rows: Row[] = [];
    // 혈압: 수축기·이완기 중 나쁜 쪽
    const sbp = num('sbp'), dbp = num('dbp');
    if (!isNaN(sbp) || !isNaN(dbp)) {
      const ls = isNaN(sbp) ? 'A' : sbp < 120 ? 'A' : sbp <= 139 ? 'B' : 'D';
      const ld = isNaN(dbp) ? 'A' : dbp < 80 ? 'A' : dbp <= 89 ? 'B' : 'D';
      const lv = (ls === 'D' || ld === 'D') ? 'D' : (ls === 'B' || ld === 'B') ? 'B' : 'A';
      rows.push({ name: '혈압', val: `${isNaN(sbp) ? '-' : sbp}/${isNaN(dbp) ? '-' : dbp} mmHg`, lv, note: lv === 'A' ? '정상(120/80 미만)이에요.' : lv === 'B' ? '고혈압 전단계예요. 집에서 여러 번 재 보세요.' : '고혈압 의심이에요(140/90 이상).', href: '/health-check/result/blood-pressure/' });
    }
    // BMI
    const h = num('height'), w = num('weight');
    if (!isNaN(h) && !isNaN(w) && h > 50) {
      const bmi = w / ((h / 100) ** 2);
      const lv: Level = bmi >= 30 ? 'D' : (bmi >= 25 || bmi < 18.5) ? 'B' : 'A';
      rows.push({ name: '체질량지수(BMI)', val: bmi.toFixed(1), lv, note: lv === 'A' ? '정상 체중(18.5~24.9)이에요.' : bmi < 18.5 ? '저체중(18.5 미만)이에요.' : lv === 'B' ? '비만(25~29.9) 구간이에요.' : '고도비만(30 이상) 구간이에요.', href: '/health/bmi/' });
    }
    const waist = num('waist');
    if (!isNaN(waist)) { const cut = sex === 'm' ? 90 : 85; const lv: Level = waist >= cut ? 'D' : 'A'; rows.push({ name: '허리둘레', val: `${waist} cm`, lv, note: lv === 'A' ? `복부비만 기준(${cut}cm) 미만이에요.` : `복부비만(${sex === 'm' ? '남 90' : '여 85'}cm 이상)이에요.` }); }
    for (const it of LAB) {
      if (it.slug === 'blood-pressure') continue;
      const v = num(it.slug); if (isNaN(v)) continue;
      const lv = it.judge(v, sex);
      const band = it.table(sex).find((b) => b.level === lv);
      rows.push({ name: it.name, val: `${v} ${it.unit}`, lv, note: lv === 'X' ? '기준표의 정상 상한보다 높아요. 결과지 소견을 확인하세요.' : `${band?.label} 구간(${band?.range})이에요.${lv === 'B' ? ' 생활 습관을 점검하고 다음 검진에서 다시 확인하세요.' : lv === 'D' ? ' 진료나 추가 검사로 확인해 보세요.' : ''}`, href: `/health-check/result/${it.slug}/` });
    }
    const pr = (document.getElementById('in-protein') as HTMLSelectElement).value as Level | '';
    if (pr) rows.push({ name: '요단백', val: pr === 'A' ? '음성' : pr === 'B' ? '약양성' : '양성', lv: pr, note: pr === 'A' ? '정상이에요.' : pr === 'B' ? '경계예요. 운동·발열 뒤에 일시적으로 나올 수 있어 다시 검사해 보세요.' : '신장질환 의심이에요. eGFR과 함께 진료로 확인하세요.' });

    if (!rows.length) { alert('결과지의 수치를 하나 이상 넣어 주세요.'); return; }
    const order: Record<string, number> = { D: 0, X: 1, B: 2, A: 3 };
    rows.sort((a, b) => order[a.lv] - order[b.lv]);
    const n = { A: 0, B: 0, D: 0 } as Record<string, number>;
    rows.forEach((r) => { if (r.lv in n) n[r.lv]++; });
    (['A', 'B', 'D'] as const).forEach((k) => { $(`n-${k}`).textContent = String(n[k]); });
    const bad = rows.filter((r) => r.lv === 'D').map((r) => r.name);
    const warn = rows.filter((r) => r.lv === 'B').map((r) => r.name);
    $('headline').textContent = bad.length
      ? `${josa(bad.join(', '), '이', '가')} 질환의심 구간이에요. 진료나 추가 검사로 확인해 보세요.`
      : warn.length ? `질환의심은 없어요. ${josa(warn.join(', '), '은', '는')} 경계라 생활 관리가 필요해요.` : '넣은 수치는 모두 정상 범위예요.';
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    $('cards').innerHTML = rows.map((r) => `<div class="lb-card ${r.lv}"><b>${esc(r.name)}</b><strong>${esc(r.val)}</strong><i>${LEVEL_SHORT[r.lv]}</i><p>${esc(r.note)}</p>${r.href ? `<a href="${r.href}">${esc(r.name)} 자세히 →</a>` : ''}</div>`).join('');
    $('confirm').hidden = !rows.some((r) => r.lv === 'D' && (r.name === '혈압' || r.name === '공복혈당'));
    $('out').hidden = false;
    $('out').scrollIntoView({ behavior: 'smooth', block: 'start' });
    try { (window as any).gtag?.('event', 'lab_check', { items: rows.length, d: n.D, b: n.B }); } catch { /* 무시 */ }
  }
  $('go').addEventListener('click', run);
</script>
</BaseLayout>
