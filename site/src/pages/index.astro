---
import { POPULAR as popular, POPULAR_FUN, HOT_GAMES, NEW_ITEMS } from '../data/rail';
import { HOLIDAY_YEARS, holidaysOf } from '../lib/holidays';
// 포털형 홈 — 오늘의 발견 → 출생연도 바로가기 → 전체 분야 → 가이드. 오른쪽(PC)에는 많이 찾는 조회·최근 본 글.
// 메뉴·분야는 src/data/menu.ts 에서 읽는다. (이전 홈은 src/legacy/HomeLegacy.astro 에 보관)
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, CATEGORIES } from '../consts';
import { allGroups, readyCount, groupHref } from '../data/menu';
import PersonChip from '../components/PersonChip.astro';
import { PEOPLE } from '../lib/people';
import ratesData from '../data/rates.json';
import policyEvents from '../data/policy-events.json';
import '../styles/portal.css';

const THIS_YEAR = 2026;
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const thumb = (h?: string) => (h && /-hero\.webp$/.test(h) ? h.replace(/-hero\.webp$/, '-hero-thumb.webp') : h);
const latest = posts.slice(0, 6);

// 오늘의 최고금리(12개월 우대) — rates.json 은 크론이 매일 갱신
function bestRate(list: any[]) {
  let best: { rate: number; bank: string } | null = null;
  for (const p of list || []) for (const o of p.options || [])
    if (o.trm === 12 && o.rate2 != null && (!best || o.rate2 > best.rate)) best = { rate: o.rate2, bank: p.bank };
  return best;
}
const bestDep = bestRate((ratesData as any).deposits);
const bestSav = bestRate((ratesData as any).savings);

// 다가오는 마감 계산용 — 제목·날짜만 슬림하게 넘긴다
const deadlines = (policyEvents as any[]).map((e) => ({ m: e.month, d: e.day, t: e.title }));

const evenYear = THIS_YEAR % 2 === 0;
// 다음 공휴일 D-day 계산용
const holidays = HOLIDAY_YEARS.flatMap((y) => holidaysOf(y).map((h) => [h.date, h.name]));
const cards = [
  { href: '/health-check/', img: 'c-checkup', tag: '건강검진', color: '#16a34a', title: `올해 건강검진 대상은 ${evenYear ? '짝수' : '홀수'}년생`, desc: '출생연도만 누르면 바로 확인' },
  bestDep && { href: '/rates/', img: 'c-rates', tag: '예금·대출', color: '#0ea5e9', title: `오늘의 최고금리 예금 연 ${bestDep.rate}%`, desc: bestSav ? `적금은 연 ${bestSav.rate}% · 전체 비교` : '은행별 금리 비교' },
  { href: '/policy-calendar/', img: 'c-deadline', tag: '일정', color: '#ef4444', title: '다가오는 신청·마감', desc: '놓치면 손해인 일정 모아보기', id: 'home-deadline' },
  { href: '/age/', img: 'g-date', tag: '나이·날짜', color: '#3b82f6', title: '만 나이 계산기', desc: '생년월일로 오늘 기준 나이' },
  { href: '/salary/', img: 'c-salary', tag: '월급·세금', color: '#10b981', title: '연봉 실수령액', desc: '세후 한 달에 얼마 받는지' },
  { href: '/benefits/', img: 'c-benefits', tag: '지원금·정책', color: '#f97316', title: '내 혜택 찾기', desc: '조건만 넣으면 받을 수 있는 지원금' },
  { href: '/fortune/', img: 'c-fortune', tag: '운세', color: '#8b5cf6', title: '오늘의 운세', desc: '띠별 운세가 매일 바뀌어요' },
  { href: '/tarot/', img: 'c-tarot', tag: '운세', color: '#8b5cf6', title: '타로 보기', desc: '카드 한 장 뽑아 보기' },
  { href: '/name-match/', img: 'c-name-match', tag: '테스트', color: '#ec4899', title: '이름 궁합', desc: '두 사람의 이름만 넣으면 끝' },
  { href: '/quiz/money-character/', img: 'c-quiz-money', tag: '테스트', color: '#8b5cf6', title: '머니 캐릭터 테스트', desc: '10가지 질문으로 보는 내 돈 성향' },
  { href: '/briefing/', img: 'c-briefing', tag: '읽을거리', color: '#10b981', title: 'Today 브리핑', desc: '오늘 챙길 것만 3분에' },
  latest[0] && { href: `/blog/${latest[0].id}/`, src: thumb(latest[0].data.heroImage), tag: '새 글', color: '#6c5ce7', title: latest[0].data.title, desc: CATEGORIES[latest[0].data.category].name },
].filter(Boolean) as { href: string; img?: string; src?: string; tag: string; color: string; title: string; desc: string; id?: string }[];

const games = [
  { href: '/games/sudoku/', img: 'c-sudoku', title: '오늘의 스도쿠' },
  { href: '/games/mines/', img: 'c-minesweeper', title: '지뢰 찾기' },
  { href: '/games/bricks/', img: 'c-breakout', title: '벽돌깨기' },
  { href: '/games/quiz/', img: 'c-quiz', title: '상식 퀴즈' },
  { href: '/games/omok/', img: 'c-omok', title: '오목' },
  { href: '/games/memory/', img: 'c-memory', title: '카드 짝 맞추기' },
  { href: '/pick/ladder/', img: 'c-ladder', title: '사다리 타기' },
  { href: '/pick/wheel/', img: 'c-wheel', title: '돌림판 돌리기' },
];

// 출생연도 바로가기 — 실제 조회가 많은 순서(GA 기준)로 앞에 배치
const hotYears = [1984, 1976, 1986, 1988, 1972, 1978, 1994, 1998, 1980, 1974, 1982, 1996];

// 생활 조회 분야를 먼저, 운세·테스트와 가이드는 뒤에
const ready = allGroups().filter((g) => readyCount(g) > 0);
const fields = [...ready.filter((g) => g.tab.slug === 'life'), ...ready.filter((g) => g.tab.slug !== 'life')];
---
<BaseLayout title={SITE.title} description={SITE.description} image="/og-home.png">
  <div class="pt">
    <div class="pt-cols">
      <div class="pt-main">
        <a class="pt-hero" href="/health-check/">
          <img src="/img/portal/hero-today.webp" alt="" width="1400" height="933" fetchpriority="high" />
          <span class="pt-hero__txt">
            <span class="pt-hero__date" id="home-date">오늘의 크라마</span>
            <span class="pt-hero__sub" id="home-hero-sub">{THIS_YEAR}년 건강검진은 <b>{evenYear ? '짝수' : '홀수'}년생</b> 대상이에요</span>
          </span>
        </a>

        <section class="pt-sec">
          <div class="pt-sec__head"><div><h2>오늘의 발견</h2><p>매일 바뀌는 숫자와 지금 볼 만한 것</p></div></div>
          <div class="pt-cards">
            {cards.map((c) => (
              <a class="pt-card" href={c.href} style={`--c:${c.color}`}>
                <img class="pt-card__img" src={c.src ?? `/img/portal/${c.img}.webp`} alt="" loading="lazy" width="640" height="400" />
                <span class="pt-card__body">
                  <span class="pt-card__tag">{c.tag}</span>
                  <span class="pt-card__title">{c.title}</span>
                  <span class="pt-card__desc" id={c.id}>{c.desc}</span>
                </span>
              </a>
            ))}
          </div>
        </section>

        <section class="pt-sec">
          <div class="pt-sec__head"><div><h2>출생연도로 바로 확인</h2><p>{THIS_YEAR}년 건강검진 대상인지 한 번에</p></div><a class="pt-more" href="/born/">연도별 나이표 →</a></div>
          <div class="pt-chips">
            {hotYears.map((y) => (
              <a class="pt-chip" href={`/health-check/${y}/`}>{y}년생{(y % 2 === 0) === evenYear && <small>대상</small>}</a>
            ))}
          </div>
        </section>

        <section class="pt-sec">
          <div class="pt-sec__head"><div><h2>게임·뽑기</h2><p>설치 없이 바로 한 판, 내기는 사다리로</p></div><a class="pt-more" href="/hub/games/">전체 →</a></div>
          <div class="pt-cards pt-cards--4">
            {games.map((c) => (
              <a class="pt-card" href={c.href} style="--c:#f59e0b">
                <img class="pt-card__img" src={`/img/portal/${c.img}.webp`} alt="" loading="lazy" width="640" height="400" />
                <span class="pt-card__body"><span class="pt-card__title">{c.title}</span></span>
              </a>
            ))}
          </div>
        </section>

        <section class="pt-sec">
          <div class="pt-sec__head"><div><h2>인물</h2><p>나이·생일·띠·별자리로 찾아보기</p></div><a class="pt-more" href="/people/">전체 {PEOPLE.length}명 →</a></div>
          <div class="pp-row">{PEOPLE.slice(0, 14).map((p) => <PersonChip p={p} />)}</div>
        </section>

        <section class="pt-sec">
          <div class="pt-sec__head"><div><h2>전체 분야</h2><p>필요한 계산기와 조회를 분야별로</p></div><button type="button" class="pt-more" data-open-menu style="border:0;background:none;font:inherit;font-weight:700;cursor:pointer">전체 메뉴 →</button></div>
          <div class="pt-fields">
            {fields.map((g) => (
              <a class="pt-field" href={groupHref(g)} style={`--c:${g.color}`}>
                <img src={`/img/portal/g-${g.slug}.webp`} alt="" loading="lazy" width="96" height="96" />
                <span><b>{g.name}</b><span>{readyCount(g)}개</span></span>
              </a>
            ))}
          </div>
        </section>

        <div class="pt-ad"><AdSlot slot="home-mid" /></div>

        <section class="pt-sec">
          <div class="pt-sec__head"><div><h2>읽을거리</h2><p>새로 올라온 글</p></div><a class="pt-more" href="/hub/guide/">더보기 →</a></div>
          <div class="pt-cards">
            {latest.map((p) => (
              <a class="pt-card" href={`/blog/${p.id}/`}>
                {p.data.heroImage && <img class="pt-card__img" src={thumb(p.data.heroImage)} alt="" loading="lazy" width="640" height="400" />}
                <span class="pt-card__body">
                  <span class="pt-card__tag">{CATEGORIES[p.data.category].name}</span>
                  <span class="pt-card__title">{p.data.title}</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      </div>

      <aside class="pt-side hm-side">
        <a class="hm-next" href="/holidays/" id="hm-next" hidden>
          <span>다음 공휴일</span><b id="hm-next-d"></b><small id="hm-next-n"></small>
        </a>
        <div class="pt-box">
          <div class="rail-head"><h3>많이 찾는 조회</h3><a href="/hub/">전체 →</a></div>
          <ol class="pt-rank">
            {popular.slice(0, 7).map((p) => <li><a href={p.href}>{p.name}</a></li>)}
          </ol>
        </div>
        <div class="pt-box">
          <div class="rail-head"><h3>많이 찾는 운세·테스트</h3><a href="/hub/fun/">전체 →</a></div>
          <ol class="pt-rank">
            {POPULAR_FUN.map((p) => <li><a href={p.href}>{p.name}</a></li>)}
          </ol>
        </div>
        <div class="pt-box">
          <div class="rail-head"><h3>지금 핫한 게임</h3><a href="/hub/games/">전체 →</a></div>
          <ul class="pt-list">
            {HOT_GAMES.map((g) => (
              <li><a href={g.href}><img src={`/img/portal/${g.img}.webp`} alt="" loading="lazy" width="96" height="96" /><span><b>{g.name}</b><small>{g.desc}</small></span></a></li>
            ))}
          </ul>
        </div>
        <div class="pt-box">
          <h3>새로 나왔어요</h3>
          <ul class="rail-links">{NEW_ITEMS.slice(0, 5).map((it) => <li><a href={it.href}><b>{it.name}</b><small>{it.desc}</small></a></li>)}</ul>
        </div>
        <div class="pt-box" id="home-pages" hidden>
          <h3>최근 본 페이지</h3>
          <ul class="rail-links" id="home-pages-list"></ul>
        </div>
        <div class="pt-box" id="home-recent" hidden>
          <h3>최근 본 글</h3>
          <ul class="pt-list" id="home-recent-list"></ul>
        </div>
        <AdSlot slot="home-side" />
      </aside>
    </div>
  </div>

  <script is:inline define:vars={{ deadlines, holidays }}>
    (() => {
      // 오늘 날짜 + 가장 가까운 신청·마감(D-day)
      var now = new Date();
      var days = ['일', '월', '화', '수', '목', '금', '토'];
      var dateEl = document.getElementById('home-date');
      if (dateEl) dateEl.textContent = (now.getMonth() + 1) + '월 ' + now.getDate() + '일 ' + days[now.getDay()] + '요일';
      var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      var best = null;
      deadlines.forEach(function (e) {
        var d = new Date(today.getFullYear(), e.m - 1, e.d);
        var n = Math.round((d - today) / 864e5);
        if (n >= 0 && (!best || n < best.n)) best = { n: n, t: e.t };
      });
      if (best) {
        var t = best.t.length > 26 ? best.t.slice(0, 26) + '…' : best.t;
        var dl = document.getElementById('home-deadline');
        if (dl) { dl.textContent = ''; var b2 = document.createElement('b'); b2.textContent = best.n === 0 ? 'D-Day' : 'D-' + best.n; dl.appendChild(b2); dl.appendChild(document.createTextNode(' · ' + t)); }
      }
      // 다음 공휴일
      try {
        var pad = function (n) { return String(n).padStart(2, '0'); };
        var ymd = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());
        var nh = holidays.filter(function (h) { return h[0] >= ymd; })[0];
        if (nh) {
          var hd = new Date(Number(nh[0].slice(0, 4)), Number(nh[0].slice(5, 7)) - 1, Number(nh[0].slice(8, 10)));
          var gap = Math.round((hd - today) / 864e5);
          document.getElementById('hm-next-d').textContent = gap === 0 ? '오늘' : 'D-' + gap;
          document.getElementById('hm-next-n').textContent = nh[1] + ' · ' + (hd.getMonth() + 1) + '월 ' + hd.getDate() + '일(' + days[hd.getDay()] + ')';
          document.getElementById('hm-next').hidden = false;
        }
      } catch (e) {}
      // 최근 본 페이지(조회·계산기·게임)
      try {
        var rp = JSON.parse(localStorage.getItem('crama:recent-pages') || '[]');
        var pul = document.getElementById('home-pages-list');
        if (Array.isArray(rp)) rp.slice(0, 5).forEach(function (x) {
          if (!x || !x.p || !x.t || x.p.charAt(0) !== '/') return;
          var li = document.createElement('li'); var a = document.createElement('a'); a.href = x.p; var b3 = document.createElement('b'); b3.textContent = x.t; a.appendChild(b3); li.appendChild(a); pul.appendChild(li);
        });
        if (pul.children.length) document.getElementById('home-pages').hidden = false;
      } catch (e) {}
      // 최근 본 글(이 기기에 저장된 기록)
      try {
        var r = JSON.parse(localStorage.getItem('crama:recent') || '[]');
        if (Array.isArray(r) && r.length) {
          var ul = document.getElementById('home-recent-list');
          r.slice(0, 4).forEach(function (x) {
            if (!x || !x.href || x.href.indexOf('/blog/') !== 0) return;
            var li = document.createElement('li'); var a = document.createElement('a'); a.href = x.href;
            if (x.thumb) { var im = document.createElement('img'); im.src = x.thumb; im.alt = ''; im.loading = 'lazy'; a.appendChild(im); }
            var s = document.createElement('span'); var bb = document.createElement('b'); bb.textContent = x.title || ''; s.appendChild(bb);
            if (x.cat) { var sm = document.createElement('small'); sm.textContent = x.cat; s.appendChild(sm); }
            a.appendChild(s); li.appendChild(a); ul.appendChild(li);
          });
          if (ul.children.length) document.getElementById('home-recent').hidden = false;
        }
      } catch (e) {}
    })();
  </script>
</BaseLayout>
