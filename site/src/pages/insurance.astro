---
// 4대보험 계산기 — 근로자 부담·회사 부담을 나란히. 요율은 lib/salary 와 같은 값을 쓴다.
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { NP_RATE, NP_CAP_MONTH, NP_FLOOR_MONTH, HI_RATE, LTC_RATE, EI_RATE } from '../lib/salary';
import '../styles/portal.css';
const R = { NP_RATE, NP_CAP_MONTH, NP_FLOOR_MONTH, HI_RATE, LTC_RATE, EI_RATE };
const faq = [
  { q: '4대보험료는 월급의 몇 %인가요?', a: '2026년 기준 근로자 부담은 국민연금 4.75%, 건강보험 3.595%, 장기요양보험(건강보험료의 13.14%), 고용보험 0.9%로 합쳐서 월급의 약 9.7%입니다. 산재보험은 회사가 전액 부담합니다.' },
  { q: '회사는 얼마를 더 내나요?', a: '국민연금과 건강보험·장기요양은 근로자와 같은 금액을 회사가 냅니다. 고용보험은 근로자 0.9%에 더해 회사가 실업급여분 0.9%와 고용안정·직업능력개발 부담금(사업 규모에 따라 0.25~0.85%)을 냅니다.' },
  { q: '국민연금에는 상한이 있나요?', a: '네. 2026년 7월부터 기준소득월액 상한은 659만원, 하한은 41만원입니다. 월급이 659만원을 넘어도 국민연금은 659만원 기준으로만 계산됩니다.' },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title="4대보험 계산기 2026 — 내 부담·회사 부담 한 번에" description="세전 월급을 넣으면 국민연금·건강보험·장기요양·고용보험의 근로자 부담과 회사 부담을 바로 계산합니다. 2026년 요율(국민연금 4.75%, 건강보험 3.595%) 반영." jsonLd={jsonLd}>
  <div class="pt pt-narrow" style="--c:#10b981">
    <nav class="pt-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/hub/pay/">월급·세금</a> › 4대보험 계산기</nav>
    <header class="pt-hubhero">
      <img src="/img/portal/g-pay.webp" alt="" width="200" height="200" />
      <div><h1>4대보험 계산기</h1><p>내 월급에서 빠지는 보험료와 회사가 내는 금액</p></div>
    </header>

    <section class="pt-sec">
      <div class="tl-card">
        <div class="tl-row">
          <label class="tl-field">세전 월급(만원)<input id="in-pay" type="number" inputmode="numeric" min="0" step="10" placeholder="예: 300" /></label>
          <label class="tl-field">비과세 수당(만원)<input id="in-free" type="number" inputmode="numeric" min="0" step="1" value="0" /></label>
          <button type="button" class="tl-btn" id="in-go">계산하기</button>
        </div>
        <div class="tl-quick" id="in-quick">{[220, 250, 300, 400, 500, 700].map((m) => <button type="button" data-m={m}>{m}만원</button>)}</div>
      </div>
      <div class="tl-result" id="in-result" hidden aria-live="polite">
        <div class="tl-result__label">내가 내는 4대보험료(월)</div>
        <div class="tl-result__big" id="in-big"></div>
        <div class="tl-result__sub" id="in-sub"></div>
      </div>
      <div class="tl-wrap" id="in-wrap" hidden style="margin-top:0.8rem">
        <table class="tl-table">
          <thead><tr><th>보험</th><th>근로자</th><th>회사</th></tr></thead>
          <tbody id="in-body"></tbody>
        </table>
      </div>
      <p class="pp-note">※ 2026년 요율 기준. 식대(월 20만원 한도) 같은 비과세 수당은 보험료 계산에서 빠집니다. 회사 부담 고용보험은 150인 미만 사업장 기준(실업급여 0.9% + 고용안정·직능 0.25%)이며, 산재보험은 업종별 요율이 달라 제외했습니다.</p>
    </section>

    <div class="pt-ad"><AdSlot slot="insurance-mid" /></div>

    <section class="pt-sec pt-prose">
      <h2>자주 묻는 질문</h2>
      {faq.map((f) => <p><b>{f.q}</b><br />{f.a}</p>)}
    </section>

    <section class="pt-sec pp-links">
      <a class="pp-link" href="/salary/monthly/"><span><b>월급 실수령액</b><span>세금까지 뺀 세후 금액</span></span><svg class="pp-link__go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a>
      <a class="pp-link" href="/freelance-tax/"><span><b>프리랜서 3.3% 계산</b><span>원천징수 후 받는 금액</span></span><svg class="pp-link__go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a>
    </section>
  </div>

  <script is:inline define:vars={{ R }}>
    (() => {
      const $ = (id) => document.getElementById(id);
      const cut = (x) => Math.floor((x + 1e-6) / 10) * 10;
      const won = (n) => n.toLocaleString('ko-KR') + '원';
      function calc() {
        const pay = Number($('in-pay').value) * 10000, free = Number($('in-free').value || 0) * 10000;
        if (!pay) { $('in-pay').focus(); return; }
        const base = Math.max(0, pay - free);
        const npBase = Math.min(Math.max(base, R.NP_FLOOR_MONTH), R.NP_CAP_MONTH);
        const np = cut(npBase * R.NP_RATE), hi = cut(base * R.HI_RATE), ltc = cut(hi * R.LTC_RATE), ei = cut(base * R.EI_RATE);
        const eiCo = cut(base * (0.009 + 0.0025));
        const rows = [['국민연금', np, np], ['건강보험', hi, hi], ['장기요양보험', ltc, ltc], ['고용보험', ei, eiCo]];
        const me = np + hi + ltc + ei, co = np + hi + ltc + eiCo;
        const body = $('in-body'); body.textContent = '';
        rows.concat([['합계', me, co]]).forEach((r, i) => {
          const tr = document.createElement('tr');
          r.forEach((v, k) => { const td = document.createElement('td'); td.textContent = k ? won(v) : v; if (i === rows.length) td.style.fontWeight = '800'; tr.appendChild(td); });
          body.appendChild(tr);
        });
        $('in-big').textContent = won(me);
        $('in-sub').textContent = '월급의 ' + (Math.round((me / pay) * 1000) / 10) + '% · 회사는 ' + won(co) + '을 따로 내요';
        $('in-result').hidden = false; $('in-wrap').hidden = false;
        try { if (window.gtag) window.gtag('event', 'tool_use', { tool: 'insurance' }); } catch (e) {}
      }
      $('in-go').addEventListener('click', calc);
      $('in-pay').addEventListener('keydown', (e) => { if (e.key === 'Enter') calc(); });
      $('in-quick').addEventListener('click', (e) => { const b = e.target.closest('button'); if (!b) return; $('in-pay').value = b.dataset.m; calc(); });
    })();
  </script>
</BaseLayout>
