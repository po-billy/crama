---
// 이자 역산 — "월 100만원 이자 받으려면 예금 얼마" 검색어용. 세후 월 이자 목표 → 필요한 예치금(금리별). 오늘 최고금리는 rates.json.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/portal.css';
import rates from '../../../data/rates.json';

import { GOALS, needFor, grossYearly, eok, bestDeposit } from '../../../lib/interest-goal';

export function getStaticPaths() { return GOALS.map((m, i) => ({ params: { man: String(m) }, props: { man: m, prev: GOALS[i - 1] ?? null, next: GOALS[i + 1] ?? null } })); }
const { man, prev, next } = Astro.props as { man: number; prev: number | null; next: number | null };
const best = bestDeposit(rates);
const need = (r: number) => needFor(man, r);
const RATES = [2.5, 3.0, 3.5, 4.0, 4.5, 5.0];
const base = best?.rate ?? 3.0;
const yearlyGross = grossYearly(man);
const title = `월 ${man.toLocaleString('ko-KR')}만원 이자 받으려면 예금 얼마? — 연 ${base}%면 약 ${eok(need(base))}`;
const desc = `세후 매달 ${man}만원 이자를 받으려면 연 ${base}% 예금 기준 약 ${eok(need(base))}이 필요합니다. 금리 2.5~5%별 필요 금액, 이자소득세 15.4%, 금융소득 종합과세 기준까지 정리했어요.`;
const faq = [
  { q: `월 ${man}만원 이자를 받으려면 얼마를 예금해야 하나요?`, a: `이자소득세 15.4%를 뺀 세후 기준으로 연 ${base}%면 약 ${eok(need(base))}, 연 3%면 약 ${eok(need(3))}, 연 4%면 약 ${eok(need(4))}이 필요합니다.` },
  { q: '이자가 많으면 세금이 더 붙나요?', a: '이자·배당 같은 금융소득이 한 해 2,000만원을 넘으면 넘는 부분은 다른 소득과 합쳐 종합과세됩니다. 이 페이지의 계산은 15.4% 분리과세만 반영했어요.' },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title={title} description={desc} jsonLd={jsonLd}>
  <div class="pt pt-narrow" style="--c:#0ea5e9">
    <nav class="pt-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/interest/">예금 이자 계산</a> › 월 {man}만원 이자</nav>
    <h1 style="font-size:1.7rem;font-weight:800;letter-spacing:-0.02em;margin:0 0 0.9rem">매달 이자 {man.toLocaleString('ko-KR')}만원 받으려면</h1>

    <div class="tl-result">
      <div class="tl-result__label">{best ? `오늘 12개월 예금 최고 연 ${best.rate}%(${best.bank}) 기준` : '연 3% 기준'}</div>
      <div class="tl-result__big">약 {eok(need(base))}</div>
      <div class="tl-result__sub">세전 이자 연 {eok(yearlyGross)} → 세금 15.4% 빼고 연 {eok(man * 10_000 * 12)} · 월 {man}만원</div>
    </div>

    <section class="pt-sec">
      <div class="pt-sec__head"><div><h2>금리별 필요한 예금</h2></div></div>
      <div class="tl-wrap"><table class="tl-table">
        <thead><tr><th>연 금리</th><th>필요한 예금</th></tr></thead>
        <tbody>{RATES.map((r) => <tr><td class={Math.abs(r - base) < 0.26 ? 'is-on' : ''}>{r.toFixed(1)}%</td><td>{eok(need(r))}</td></tr>)}</tbody>
      </table></div>
      {yearlyGross > 20_000_000 && <p class="pp-note">※ 세전 이자가 연 {eok(yearlyGross)}로 금융소득 종합과세 기준(연 2,000만원)을 넘어요. 넘는 부분은 다른 소득과 합쳐 세율이 더 높아질 수 있어요.</p>}
      <p class="pp-note">※ 1년 만기 단리, 이자소득세 15.4% 기준. 금리는 크라마가 매일 받는 금융감독원 금리 정보예요.</p>
    </section>

    <section class="pt-sec">
      <div class="pt-chips">
        {prev && <a class="pt-chip" href={`/interest/goal/${prev}/`}>월 {prev}만원</a>}
        {next && <a class="pt-chip" href={`/interest/goal/${next}/`}>월 {next}만원</a>}
        <a class="pt-chip" href="/rates/">오늘의 예금 금리 비교</a>
        <a class="pt-chip" href="/hidden-money/">숨은 돈 찾기</a>
      </div>
    </section>

    <section class="pt-sec pt-prose">
      <h2>자주 묻는 질문</h2>
      {faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
    </section>
  </div>
</BaseLayout>
