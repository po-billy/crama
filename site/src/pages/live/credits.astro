---
// 엔딩 크레딧 — 방송 마무리에 시청자·후원자 이름이 영화처럼 올라간다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/portal.css';
import '../../styles/party.css';
import '../../styles/live.css';

const faq = [
  { q: '이름은 어떻게 넣나요?', a: '"# 제목"으로 시작하는 줄이 묶음 제목이 되고, 그 아래 줄마다 이름 하나씩 들어갑니다. 예를 들어 "# 오늘의 후원" 아래에 후원자, "# 함께한 시청자" 아래에 채팅 참여자를 적으면 됩니다. 채팅 참여 추첨에서 "참여자 목록 복사"로 받은 목록을 그대로 붙여 넣어도 됩니다.' },
  { q: '크레딧이 끝나면 어떻게 되나요?', a: '마지막에 끝인사 문구가 가운데 남습니다. "반복"을 켜면 처음부터 다시 올라갑니다. 방송 화면에서 스페이스바(상호작용)를 누르면 처음부터 다시 시작합니다.' },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const SAMPLE = `# 오늘의 후원
별빛고양이
치즈냥이
# 함께한 시청자
밤하늘
라면왕
새벽감성
도토리
# 오늘의 구슬 레이스 1등
치즈냥이`;
---
<BaseLayout title="엔딩 크레딧 오버레이 — 방송 마무리 시청자 이름 올리기 (OBS)" description="방송 끝에 후원자·시청자 이름이 영화 엔딩처럼 올라가는 크레딧 오버레이. 이름을 붙여 넣고 주소만 복사해 OBS에 넣으세요. 투명 배경, 속도·끝인사 설정." jsonLd={jsonLd}>
<div class="pt pt-narrow py lv" style="--c:#FF4D6D">
  <nav class="pt-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/live/">방송 도구</a> › 엔딩 크레딧</nav>
  <div class="py-head">
    <div><h1>엔딩 크레딧</h1><p>방송 마무리에 오늘 함께한 이름들을 영화처럼 올립니다.</p></div>
    <div class="py-tools"><button type="button" class="py-tool hot" id="stream">방송 모드</button></div>
  </div>

  <div class="py-stage lv-stage checker lvc" id="stage">
    <div class="lvc-roll" id="roll"></div>
    <div class="py-streambar"><button type="button" class="p" id="s-re">처음부터 (Space)</button><button type="button" id="s-exit">나가기</button></div>
  </div>

  <section class="lv-card">
    <h2>설정</h2>
    <div class="lv-grid">
      <label class="lv-full">이름 ('# 제목' 줄로 묶음을 나눔)<textarea id="c" spellcheck="false" style="min-height:180px">{SAMPLE}</textarea></label>
      <label>맨 위 제목<input id="h" value="오늘도 함께해 주셔서 감사합니다" maxlength="40" /></label>
      <label>끝인사<input id="bye" value="다음 방송에서 만나요!" maxlength="40" /></label>
      <label>속도<span class="py-seg" id="sp"><button type="button" data-v="40">느리게</button><button type="button" data-v="70" class="on">보통</button><button type="button" data-v="110">빠르게</button></span></label>
      <label>반복<span class="py-seg" id="lp"><button type="button" data-v="0" class="on">한 번</button><button type="button" data-v="1">계속 반복</button></span></label>
    </div>
    <div class="lv-url"><input id="url" readonly /><button type="button" class="lv-btn p" id="copy">OBS 주소 복사</button></div>
  </section>

  <section class="pt-sec pt-prose">
    <h2>자주 묻는 질문</h2>
    {faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
  </section>
</div>

<style is:global>
  .lvc { overflow:hidden; color:#fff; }
  .lvc-roll { position:absolute; left:0; right:0; top:0; text-align:center; will-change:transform; text-shadow:0 2px 10px rgba(0,0,0,.65); }
  .lvc-roll h3, .lvc-roll p { color:#fff; }
  .lvc-roll h3 { margin:0 0 40px; font-size:clamp(1.3rem, 3.6vw, 2.2rem); font-weight:900; letter-spacing:-.03em; }
  .lvc-roll h4 { margin:44px 0 12px; font-size:clamp(.8rem, 1.8vw, 1rem); font-weight:900; letter-spacing:.2em; color:#FFC83D; }
  .lvc-roll p { margin:0 0 10px; font-size:clamp(1rem, 2.6vw, 1.5rem); font-weight:800; }
  .lvc-bye { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:clamp(1.6rem, 5vw, 3rem); font-weight:900; text-shadow:0 3px 14px rgba(0,0,0,.7); opacity:0; transition:opacity 1.2s; }
  .lvc-bye.on { opacity:1; }
  .lvc.is-stream .lvc-roll { transform-origin:top center; }
  .lvc.is-stream .lvc-roll h3 { font-size:3.4rem; } .lvc.is-stream .lvc-roll h4 { font-size:1.4rem; } .lvc.is-stream .lvc-roll p { font-size:2.2rem; margin-bottom:16px; }
  .lvc.is-stream .lvc-bye { font-size:4.4rem; }
  .lvc.is-stream:not([data-bg]) { background:#14112B; }
</style>

<script>
  import { initStream, track } from '../../party/kit';
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const stage = $('stage'), roll = $('roll');
  const q = new URLSearchParams(location.search);
  const c = $('c') as HTMLTextAreaElement, h = $('h') as HTMLInputElement, bye = $('bye') as HTMLInputElement;
  if (q.get('c') !== null) c.value = q.get('c')!; if (q.get('h') !== null) h.value = q.get('h')!; if (q.get('bye') !== null) bye.value = q.get('bye')!;
  let speed = +(q.get('sp') || 70), loop = q.get('lp') === '1';
  const seg = (id: string, get: () => string, set: (v: string) => void) => {
    const box = $(id); const paint = () => box.querySelectorAll('button').forEach((b) => b.classList.toggle('on', (b as HTMLElement).dataset.v === get()));
    box.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { set((b as HTMLElement).dataset.v!); paint(); build(); })); paint();
  };
  seg('sp', () => String(speed), (v) => { speed = +v; });
  seg('lp', () => (loop ? '1' : '0'), (v) => { loop = v === '1'; });
  const byeEl = document.createElement('div'); byeEl.className = 'lvc-bye'; stage.appendChild(byeEl);

  let y = 0, last = performance.now(), ended = false;
  function build() {
    let html = `<h3>${esc(h.value)}</h3>`;
    for (const line of c.value.split(/\r?\n/)) {
      const t = line.trim(); if (!t) continue;
      html += t.startsWith('#') ? `<h4>${esc(t.replace(/^#+\s*/, ''))}</h4>` : `<p>${esc(t.replace(/\s*[xX×*]\s*\d{1,3}$/, ''))}</p>`;
    }
    roll.innerHTML = html; byeEl.textContent = bye.value;
    restart();
    const u = new URL(location.origin + location.pathname);
    u.searchParams.set('c', c.value); u.searchParams.set('h', h.value); u.searchParams.set('bye', bye.value);
    u.searchParams.set('sp', String(speed)); if (loop) u.searchParams.set('lp', '1');
    u.searchParams.set('stream', '1'); u.searchParams.set('bg', 'transparent');
    ($('url') as HTMLInputElement).value = u.toString();
  }
  function restart() { y = stage.clientHeight; lastH = y; ended = false; byeEl.classList.remove('on'); }
  function frame(t: number) {
    const dt = Math.min(0.05, (t - last) / 1000); last = t;
    const k = stage.classList.contains('is-stream') ? innerHeight / 540 : 1;
    if (!ended) {
      y -= speed * k * dt;
      roll.style.transform = `translateY(${y}px)`;
      if (y < -roll.offsetHeight) { if (loop) restart(); else { ended = true; byeEl.classList.add('on'); } }
    }
    requestAnimationFrame(frame);
  }
  [c, h, bye].forEach((el) => el.addEventListener('input', build));
  addEventListener('keydown', (e) => { if (e.code === 'Space' && !(document.activeElement && ['TEXTAREA', 'INPUT'].includes(document.activeElement.tagName))) { e.preventDefault(); restart(); } });
  $('s-re').addEventListener('click', restart);
  $('copy').addEventListener('click', async (e) => { const b = e.currentTarget as HTMLElement; try { await navigator.clipboard.writeText(($('url') as HTMLInputElement).value); b.textContent = '복사했어요!'; } catch { prompt('이 주소를 복사하세요', ($('url') as HTMLInputElement).value); } setTimeout(() => { b.textContent = 'OBS 주소 복사'; }, 1600); track('live_tool_url', { tool: 'credits' }); });
  initStream(stage, $('stream'), null, () => location.href);
  $('s-exit').addEventListener('click', () => $('stream').click());
  let lastH = 0;
  addEventListener('resize', () => { const hh = stage.clientHeight; if (Math.abs(hh - lastH) > 40) { lastH = hh; restart(); } });
  build(); requestAnimationFrame(frame);
</script>
</BaseLayout>
