---
// 연도별 최저임금 표 — 시급·일급·월급·연봉 환산과 인상률. 금액은 고용노동부 고시 기준.
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import '../styles/portal.css';

// [적용 연도, 시간급(원)] — 매년 8월 초 다음 해 금액이 고시되면 한 줄 추가
const WAGES: [number, number][] = [
  [2009, 4000], [2010, 4110], [2011, 4320], [2012, 4580], [2013, 4860], [2014, 5210], [2015, 5580], [2016, 6030], [2017, 6470], [2018, 7530],
  [2019, 8350], [2020, 8590], [2021, 8720], [2022, 9160], [2023, 9620], [2024, 9860], [2025, 10030], [2026, 10320], [2027, 10700],
];
const thisYear = new Date().getFullYear();
const rows = WAGES.slice(1).map(([y, w], i) => ({ y, w, prev: WAGES[i][1], rate: Math.round(((w - WAGES[i][1]) / WAGES[i][1]) * 1000) / 10, month: w * 209, year: w * 209 * 12 })).reverse();
const cur = rows.find((r) => r.y === thisYear) || rows[0];
const next = rows.find((r) => r.y === thisYear + 1);
const won = (n: number) => n.toLocaleString('ko-KR') + '원';
const maxW = rows[0].w;
const faq = [
  { q: `${cur.y}년 최저임금은 얼마인가요?`, a: `${cur.y}년 최저임금은 시간당 ${won(cur.w)}입니다. 주 40시간 일하면 주휴수당을 포함해 월 209시간 기준 ${won(cur.month)}이 됩니다.` },
  ...(next ? [{ q: `${next.y}년 최저임금은 얼마로 정해졌나요?`, a: `${next.y}년 적용 최저임금은 시간당 ${won(next.w)}으로, ${cur.y}년보다 ${won(next.w - cur.w)}(${next.rate}%) 올랐습니다. 월 환산액은 ${won(next.month)}(209시간 기준)입니다.` }] : []),
  { q: '월급으로 환산할 때 왜 209시간을 곱하나요?', a: '주 40시간 근로에 유급 주휴 8시간을 더한 48시간에, 한 달 평균 주 수(약 4.345주)를 곱하면 약 209시간이 됩니다. 그래서 주 40시간 근로자의 최저 월급은 시급 × 209로 계산합니다.' },
  { q: '수습 기간에는 최저임금보다 적게 줘도 되나요?', a: '1년 이상 근로계약을 맺은 경우에 한해 수습 시작 후 3개월까지는 최저임금의 90%를 지급할 수 있습니다. 다만 단순 노무 업무는 수습이어도 감액할 수 없습니다.' },
  { q: '최저임금에 식대나 상여금도 포함되나요?', a: '2024년부터 매달 정기적으로 지급하는 상여금과 식비·교통비 같은 복리후생비는 전액 최저임금 계산에 포함됩니다. 연장·야간·휴일 수당은 포함되지 않습니다.' },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title={`연도별 최저임금 표 (${rows[rows.length - 1].y}~${rows[0].y}) — 시급·월급·인상률`} description={`${cur.y}년 최저임금은 시급 ${won(cur.w)}, 월 ${won(cur.month)}(209시간).${next ? ` ${next.y}년은 시급 ${won(next.w)}.` : ''} 연도별 최저시급과 월 환산액, 인상률을 한 표로 정리했습니다.`} jsonLd={jsonLd}>
  <div class="pt pt-narrow" style="--c:#eab308">
    <nav class="pt-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/hub/tables/">한눈에 보기</a> › 연도별 최저임금</nav>
    <header class="pt-hubhero">
      <img src="/img/portal/g-tables.webp" alt="" width="200" height="200" />
      <div><h1>연도별 최저임금</h1><p>시급·월급 환산액과 인상률을 한 표로</p></div>
    </header>

    <section class="pt-sec">
      <div class="tl-result" style="margin-top:0">
        <div class="tl-result__label">{cur.y}년 최저임금 (시간급)</div>
        <div class="tl-result__big">{won(cur.w)}</div>
        <div class="tl-result__sub">월 {won(cur.month)} (209시간) · 전년 대비 +{cur.rate}%</div>
      </div>
      <div class="pp-facts pp-facts--4">
        <div><span>일급 (8시간)</span><b>{won(cur.w * 8)}</b></div>
        <div><span>주급 (주휴 포함 48시간)</span><b>{won(cur.w * 48)}</b></div>
        <div><span>월급 (209시간)</span><b>{won(cur.month)}</b></div>
        <div><span>연봉 환산</span><b>{won(cur.year)}</b></div>
      </div>
      {next && (
        <a class="pp-link" href="#mw-table" style="margin-top:0.9rem">
          <span><b>{next.y}년 최저임금은 시급 {won(next.w)}</b><span>{cur.y}년보다 {won(next.w - cur.w)}(+{next.rate}%) 인상 · 월 {won(next.month)}</span></span>
        </a>
      )}
    </section>

    <section class="pt-sec" id="mw-table">
      <div class="pt-sec__head"><div><h2>연도별 최저임금 표</h2><p>월급은 주 40시간·월 209시간 기준</p></div></div>
      <div class="tl-wrap" style="overflow-x:auto">
        <table class="tl-table mw-table">
          <thead><tr><th>연도</th><th>시급</th><th>인상률</th><th class="mw-wide">인상액</th><th>월급 (209시간)</th></tr></thead>
          <tbody>
            {rows.map((r) => (
              <tr class={r.y === thisYear ? 'mw-now' : ''}>
                <td><b>{r.y}년</b>{r.y === thisYear && <span class="mw-tag">올해</span>}{r.y === thisYear + 1 && <span class="mw-tag mw-tag--next">내년</span>}</td>
                <td><b>{won(r.w)}</b></td>
                <td>{r.rate}%</td>
                <td class="mw-wide">+{(r.w - r.prev).toLocaleString('ko-KR')}원</td>
                <td>{won(r.month)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pp-note">※ 고용노동부 최저임금 고시 기준. 월급은 시급 × 209시간(주 40시간 + 주휴 8시간)으로 환산한 금액이며, 주 15시간 미만으로 일하면 주휴수당이 없어 실제 금액이 달라집니다.</p>
    </section>

    <div class="pt-ad"><AdSlot slot="minimum-wage-mid" /></div>

    <section class="pt-sec">
      <div class="pt-sec__head"><div><h2>최저시급 변화</h2><p>{rows[rows.length - 1].y}년 {won(rows[rows.length - 1].w)} → {rows[0].y}년 {won(rows[0].w)}</p></div></div>
      <div class="mw-bars" role="img" aria-label="연도별 최저시급 막대 그래프">
        {rows.slice().reverse().map((r) => (
          <div class={`mw-bar${r.y === thisYear ? ' is-now' : ''}`}><i style={`--h:${(r.w / maxW).toFixed(3)}`}></i><span>{String(r.y).slice(2)}</span></div>
        ))}
      </div>
    </section>

    <section class="pt-sec pt-prose">
      <h2>자주 묻는 질문</h2>
      {faq.map((f) => <p><b>{f.q}</b><br />{f.a}</p>)}
    </section>

    <section class="pt-sec">
      <div class="pt-sec__head"><div><h2>함께 보면 좋은 계산기</h2></div></div>
      <div class="pt-chips"><a class="pt-chip" href="/wage/">시급 → 월급 환산</a><a class="pt-chip" href="/salary/monthly/">월급 실수령액</a><a class="pt-chip" href="/insurance/">4대보험 계산기</a><a class="pt-chip" href="/severance/">퇴직금</a><a class="pt-chip" href="/unemployment/">실업급여</a></div>
    </section>
  </div>

  <style is:global>
    .mw-table td, .mw-table th { white-space: nowrap; }
    @media (max-width: 520px) { .mw-wide { display: none; } .mw-table td, .mw-table th { padding-left: 0.3rem; padding-right: 0.3rem; font-size: 0.88rem; } }
    .mw-now td { background: color-mix(in srgb, var(--accent) 8%, var(--paper)); }
    .mw-tag { display: inline-block; margin-left: 0.35rem; padding: 0.05rem 0.45rem; border-radius: 999px; background: var(--accent); color: #fff; font-size: 0.68rem; font-weight: 800; vertical-align: middle; }
    .mw-tag--next { background: var(--ink); }
    .mw-bars { display: flex; align-items: flex-end; gap: 3px; height: 11rem; padding: 0.8rem 0.6rem 0; border: 1px solid var(--line); border-radius: 16px; background: var(--paper); }
    .mw-bar { flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 0.25rem; min-width: 0; }
    .mw-bar i { display: block; flex: none; height: calc((100% - 1.6rem) * var(--h)); width: 100%; border-radius: 5px 5px 0 0; background: color-mix(in srgb, var(--accent) 45%, var(--paper)); }
    .mw-bar.is-now i { background: var(--accent); }
    .mw-bar span { font-size: 0.66rem; color: var(--muted); padding-bottom: 0.4rem; }
  </style>
</BaseLayout>
