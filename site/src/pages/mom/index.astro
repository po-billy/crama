---
// 크라마 맘 — 임신 주수·출산예정일 계산기(서비스 첫 화면).
// 처음 온 사람: 큰 하늘 + '터치하여 시작' → 바텀시트에서 날짜 입력
// 다시 온 사람(localStorage 'crama:mom'): 낮은 하늘에 오늘 주수 + 몽이 한마디, 바로 아래 D-day·여정·할 일·타임라인
import MomLayout from '../../mom/MomLayout.astro';
import Sky from '../../mom/Sky.astro';
import Mascot from '../../mom/Mascot.astro';
import Icon from '../../mom/Icon.astro';
import { MOM_BRAND, TASKS, WEEK_FROM, WEEK_TO } from '../../mom/lib';
import { WEEKS, emoOf } from '../../mom/weeks';

const slimWeeks = WEEKS.map((w) => ({ w: w.w, like: w.like, len: w.len, wt: w.wt, emo: emoOf(w.like) }));
const weeks = WEEKS.map((w) => w.w);
const faq = [
  { q: '출산예정일은 어떻게 계산하나요?', a: '마지막 생리 시작일에 280일(40주)을 더합니다. 생리 주기가 28일보다 길거나 짧으면 그 차이만큼 예정일을 늦추거나 당겨요. 초음파로 잰 크기에 따라 병원에서 예정일을 조정하기도 해요.' },
  { q: '임신 주수는 언제부터 세나요?', a: '수정된 날이 아니라 마지막 생리 시작일을 0주 0일로 셉니다. 그래서 임신 사실을 알게 되는 시점이 보통 4~5주예요.' },
  { q: '시험관 시술은 어떻게 계산하나요?', a: '이식일을 기준으로 3일 배아는 17일, 5일 배아는 19일을 빼서 마지막 생리 시작일로 바꾼 뒤 280일을 더합니다.' },
  { q: '임신 몇 주가 몇 개월인가요?', a: '흔히 4주를 한 달로 셉니다. 0~3주가 1개월, 4~7주가 2개월이고, 36주부터는 10개월이에요.' },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const monthRows = Array.from({ length: 10 }, (_, i) => ({ m: i + 1, from: i * 4, to: i === 9 ? 40 : i * 4 + 3 })).map((r) => ({ ...r, stage: r.to < 14 ? '초기' : r.from >= 28 ? '후기' : r.from < 14 ? '초기·중기' : '중기' }));
---
<MomLayout
  tab="home"
  heading={MOM_BRAND}
  title="출산예정일 계산기 · 임신 주수 계산 — 오늘 몇 주 며칠, 몇 개월"
  description="마지막 생리일, 수정일, 시험관 이식일 중 하나만 넣으면 출산예정일과 오늘 임신 몇 주 며칠인지, 이번 주에 받을 검사와 할 일까지 날짜로 정리해 드려요."
  jsonLd={jsonLd}
>
  <Sky size="tall" class="mo-sky--home">
    <p class="mo-logo mo-only-new">{MOM_BRAND}</p>
    <h1 class="mo-h1 mo-h1--home">출산예정일 · 임신 주수 계산기</h1>
    <p class="mo-sub mo-only-new">날짜 하나면 오늘 몇 주 며칠인지, 이번 주 할 일까지 알려 드려요</p>
    <span class="mo-chip mo-only-due" id="mm-tri">-</span>
    <p class="mo-logo mo-logo--week mo-only-due" id="mm-week">-</p>
    <p class="mo-sub mo-only-due" id="mm-sub">-</p>
    <div class="mo-chars">
      <p class="mo-say" id="mm-say">반가워요! 나는 몽이예요.<br />날짜를 알려 주면 오늘 몇 주인지 알려 줄게요</p>
      <Mascot char="mong" pose="hi" size="clamp(110px, 30vw, 180px)" />
      <Mascot char="kong" pose="idle" size="clamp(74px, 20vw, 116px)" />
    </div>
    <button type="button" class="mo-start mo-only-new" data-sheet-open="mm-sheet">터치하여 시작<Icon name="back" size={20} /></button>
  </Sky>

  <div class="mo-page">
    <!-- 다시 온 사람: 대시보드 -->
    <div class="mo-grid2 mo-only-due">
      <div class="mo-col">
        <div class="mo-card">
          <div class="mo-cardhead"><span id="mm-basis">-</span><button type="button" class="mo-mini" data-sheet-open="mm-sheet">날짜 바꾸기</button></div>
          <div class="mo-stats">
            <div class="mo-stat mo-stat--pink"><span>남은 날</span><b id="mm-left">-</b></div>
            <div class="mo-stat mo-stat--blue"><span>출산예정일</span><b id="mm-due">-</b></div>
            <div class="mo-stat mo-stat--mint"><span>임신 개월</span><b id="mm-month">-</b></div>
          </div>
          <div class="mo-journey mo-journey-top">
            <div class="mo-journey-track">
              <i id="mm-bar"></i>
              <span class="mo-journey-walker" id="mm-walker"><Mascot char="mong" pose="idle" size={44} label="" /></span>
            </div>
            <div class="mo-journey-steps"><span>임신</span><span>초기</span><span>중기</span><span>후기</span><span>출산</span></div>
          </div>
        </div>
        <a class="mo-card mo-baby mo-press" id="mm-baby" href="/mom/week/4/">
          <i class="mo-bubble" id="mm-baby-e">🌱</i>
          <div><b id="mm-baby-t">-</b><span id="mm-baby-s">-</span><em>이번 주 자세히 보기 →</em></div>
        </a>
        <section class="mo-card">
          <h2 class="mo-h2"><Mascot char="mong" pose="hold" size={34} label="" />지금 챙길 것</h2>
          <div class="mm-tasks" id="mm-now-tasks"></div>
        </section>
      </div>
      <div class="mo-col">
        <section class="mo-card">
          <h2 class="mo-h2"><Icon name="cal" size={22} />내 일정</h2>
          <button type="button" class="mo-fold" id="mm-fold" hidden>지난 일정 보기</button>
          <ol class="mo-tl is-folded" id="mm-plan"></ol>
          <p class="mm-note">※ 일반적인 산전관리 일정이에요. 실제 검사 시기는 다니는 병원 안내를 따르세요.</p>
        </section>
      </div>
    </div>

    <!-- 처음 온 사람: 무엇을 해 주는지 + 시작 버튼 -->
    <section class="mo-card mo-only-new">
      <h2>크라마 맘이 해 드리는 것</h2>
      <ul class="mo-feat">
        <li><i class="q-pink">🗓️</i><div><b>오늘 몇 주 며칠</b><span>예정일 D-day와 임신 개월까지</span></div></li>
        <li><i class="q-butter">🍋</i><div><b>이번 주 아기 크기</b><span>과일·채소로 보는 주차별 성장</span></div></li>
        <li><i class="q-mint">✅</i><div><b>챙길 검사·신청</b><span>내 날짜로 계산한 일정표</span></div></li>
      </ul>
      <button type="button" class="mo-btn" data-sheet-open="mm-sheet">날짜 넣고 시작하기</button>
    </section>

    <aside class="mo-card mo-install" id="mo-install" hidden>
      <Mascot char="kong" pose="hi" size={56} label="" />
      <div><b>홈 화면에 크라마 맘 추가</b><span id="mo-install-t">앱처럼 바로 열 수 있어요</span></div>
      <button type="button" class="mo-mini" id="mo-install-btn" hidden>추가</button>
      <button type="button" class="mo-x" id="mo-install-x" aria-label="닫기">×</button>
    </aside>

    <section class="mo-card">
      <h2>바로가기</h2>
      <div class="mo-quick mo-quick--4">
        <a href="/mom/baby/" class="q-butter"><i><Icon name="baby" /></i><span>아기 100일·돌<small>예방접종·검진 날짜</small></span></a>
        <a href="/mom/support/" class="q-pink"><i><Icon name="gift" /></i><span>임신·출산 지원금<small>받는 순서대로</small></span></a>
        <a href="/mom/checklist/" class="q-mint"><i><Icon name="bag" /></i><span>출산가방 체크<small>하나씩 눌러 챙기기</small></span></a>
        <a href="/welfare/" class="q-blue"><i><Icon name="pin" /></i><span>우리 동네 지원<small>지자체 출산 지원 찾기</small></span></a>
      </div>
    </section>

    <section class="mo-card">
      <h2>임신 주차별 정보</h2>
      <p>주차를 누르면 아기 크기, 엄마 몸의 변화, 그 주에 받는 검사를 볼 수 있어요.</p>
      <div class="mm-weeks mm-weeks--wrap" id="mm-weekstrip">{weeks.map((w) => <a href={`/mom/week/${w}/`} data-w={w}>{w}주</a>)}</div>
    </section>

    <div class="mo-grid2">
      <section class="mo-card">
        <h2>임신 몇 주는 몇 개월?</h2>
        <table class="mm-table">
          <thead><tr><th>개월</th><th>주수</th><th>시기</th></tr></thead>
          <tbody>{monthRows.map((r) => <tr><td>{r.m}개월</td><td>{r.from}~{r.to}주</td><td>{r.stage}</td></tr>)}</tbody>
        </table>
        <p class="mm-note">※ 4주를 한 달로 세는 방식이에요. 초기는 13주까지, 중기는 14~27주, 후기는 28주부터예요.</p>
      </section>
      <section class="mo-card">
        <h2>자주 묻는 질문</h2>
        <div class="mm-faq">{faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
      </section>
    </div>
  </div>

  <div class="mo-sheet" id="mm-sheet" slot="sheets" hidden role="dialog" aria-modal="true" aria-labelledby="mm-sheet-t">
    <div class="mo-sheet-dim" data-sheet-close></div>
    <div class="mo-sheet-panel">
      <div class="mo-sheet-grab"><i></i></div>
      <div class="mo-sheet-head">
        <Mascot char="mong" pose="hold" size={52} label="" />
        <div><h2 id="mm-sheet-t">언제부터 셀까요?</h2><p>아는 날짜 하나만 골라 주세요</p></div>
        <button type="button" class="mo-x" data-sheet-close aria-label="닫기">×</button>
      </div>
      <div class="mo-seg mm-tabs" role="tablist">
        <button type="button" data-mode="lmp" class="is-on">마지막<br />생리일</button>
        <button type="button" data-mode="conc">수정일<br />(배란일)</button>
        <button type="button" data-mode="ivf">시험관<br />이식일</button>
        <button type="button" data-mode="due">예정일을<br />알아요</button>
      </div>
      <div class="mo-fields">
        <label class="mo-field"><span id="mm-label">마지막 생리 시작일</span><input id="mm-date" type="date" data-autofocus /></label>
        <label class="mo-field" id="mm-cycle-wrap">생리 주기
          <select id="mm-cycle">{Array.from({ length: 15 }, (_, i) => 21 + i).map((d) => <option value={d} selected={d === 28}>{d}일</option>)}</select>
        </label>
        <label class="mo-field" id="mm-ivf-wrap" hidden>배아 일수
          <select id="mm-ivf"><option value="3">3일 배아</option><option value="5" selected>5일 배아</option></select>
        </label>
      </div>
      <p class="mo-err" id="mm-err" hidden>날짜를 골라 주세요</p>
      <button type="button" class="mo-btn" id="mm-go">우리 아기 만나러 가기</button>
      <p class="mm-note" style="text-align:center">입력한 날짜는 이 기기에만 저장돼요.</p>
      <button type="button" class="mm-reset mo-only-due" id="mm-reset" style="display:block;margin:4px auto 0">저장한 날짜 지우기</button>
    </div>
  </div>

  <script is:inline define:vars={{ TASKS, slimWeeks, WEEK_FROM, WEEK_TO }}>
    (() => {
      const M = window.CramaMom;
      const $ = (id) => document.getElementById(id);
      const LABEL = { lmp: '마지막 생리 시작일', conc: '수정일(배란일)', ivf: '이식일', due: '출산예정일' };
      const BASIS = { lmp: '마지막 생리일', conc: '수정일', ivf: '이식일', due: '출산예정일' };
      const KIND = { check: '검사', admin: '신청', prep: '준비' };
      let mode = 'lmp';
      const add = M.add;
      const fmt = (d) => `${d.getFullYear()}.${d.getMonth() + 1}.${d.getDate()}`;
      const fmtM = (d) => `${d.getMonth() + 1}.${d.getDate()}`;
      const fmtS = (d) => `${String(d.getFullYear()).slice(2)}.${d.getMonth() + 1}.${d.getDate()}`;
      const fmtK = (d) => `${d.getFullYear()}년 ${d.getMonth() + 1}월 ${d.getDate()}일`;
      const setMode = (m) => {
        mode = m;
        document.querySelectorAll('.mm-tabs button').forEach((b) => b.classList.toggle('is-on', b.dataset.mode === m));
        $('mm-label').textContent = LABEL[m];
        $('mm-cycle-wrap').hidden = m !== 'lmp';
        $('mm-ivf-wrap').hidden = m !== 'ivf';
      };
      function render(st) {
        const { base, due, days, week: w, day: d, left } = M.status(st);
        const t = M.today();
        $('mm-basis').textContent = `${BASIS[st.mode] || '날짜'} ${fmt(M.parse(st.date))} 기준`;
        const cw = Math.max(WEEK_FROM, Math.min(WEEK_TO, w));
        const wk = slimWeeks.find((x) => x.w === cw);
        const nowT = TASKS.filter((x) => w >= x.from && w <= x.to);
        if (days < 0) { $('mm-week').textContent = '시작 전'; $('mm-sub').textContent = '입력한 날짜를 다시 확인해 주세요.'; }
        else if (w > 42) { $('mm-week').textContent = '출산 후'; $('mm-sub').textContent = '아기 날짜는 아기 탭에서 볼 수 있어요.'; }
        else { $('mm-week').textContent = `${w}주 ${d}일`; $('mm-sub').textContent = `오늘이 임신 ${days + 1}일째예요`; }
        const tri = w < 14 ? '임신 초기' : w < 28 ? '임신 중기' : '임신 후기';
        $('mm-tri').textContent = days >= 0 && w <= 42 ? `${tri} · ${Math.min(10, Math.floor(w / 4) + 1)}개월` : '크라마 맘';
        // 몽이 한마디 — 이번 주 검사가 있으면 그걸, 없으면 아기 크기
        const chk = nowT.find((x) => x.kind === 'check' && x.from >= w - 1) || nowT.find((x) => x.kind === 'check');
        $('mm-say').innerHTML = days < 0 || w > 42 ? '날짜를 한 번 더 확인해 줄래요?'
          : left <= 14 && left >= 0 ? `곧 만나요! 예정일까지 <b>${left}일</b>`
          : chk ? `이번 주는 <b>${chk.title}</b> 기간이에요`
          : wk ? `아기가 <b>${wk.like}</b>만큼 컸어요 ${wk.emo}` : '오늘도 수고했어요';
        const pct = Math.max(0, Math.min(100, (days / 280) * 100));
        $('mm-bar').style.width = pct + '%';
        $('mm-walker').style.left = Math.max(4, Math.min(96, pct)) + '%';
        $('mm-due').textContent = fmtS(due);
        $('mm-left').textContent = left > 0 ? `D-${left}` : left === 0 ? 'D-day' : `D+${-left}`;
        $('mm-month').textContent = days >= 0 ? `${Math.min(10, Math.floor(w / 4) + 1)}개월` : '-';
        if (wk) {
          $('mm-baby').href = `/mom/week/${cw}/`;
          $('mm-baby-e').textContent = wk.emo;
          $('mm-baby-t').textContent = `${cw}주 아기는 ${wk.like}만 해요`;
          $('mm-baby-s').textContent = `키 ${wk.len}${wk.wt !== '-' ? ' · 몸무게 ' + wk.wt : ''}`;
        }
        $('mm-now-tasks').innerHTML = nowT.length
          ? nowT.map((x) => `<div class="mm-task"><em class="k-${x.kind}">${KIND[x.kind]}</em><b>${x.title} <small>~${fmtM(add(base, x.to * 7 + 6))}</small></b><span>${x.desc}</span></div>`).join('')
          : '<p class="mm-note">이번 주에 정해진 일정은 없어요. 아래 내 일정에서 다음 일정을 확인해 보세요.</p>';
        // 타임라인 — 지난 일정은 접어 두고 지금·다음 일정부터
        let nextMarked = false, pastN = 0;
        $('mm-plan').innerHTML = TASKS.map((x) => {
          const s1 = add(base, x.from * 7), e = add(base, x.to * 7 + 6);
          const past = e < t, cur = !past && s1 <= t;
          let cls = past ? 'is-past' : cur ? 'is-now' : '';
          if (past) pastN++;
          if (!past && !cur && !nextMarked) { cls = 'is-next'; nextMarked = true; }
          const range = x.from === x.to ? `${x.from}주` : `${x.from}~${x.to}주`;
          const tag = past ? '지남' : cur ? '지금' : `D-${Math.round((s1 - t) / M.DAY)}`;
          return `<li class="${cls}"><i></i><div><b>${x.title}</b><span>${range} · ${x.from === x.to ? fmt(s1) : fmtM(s1) + ' ~ ' + fmtM(e)}</span></div><em>${tag}</em></li>`;
        }).join('') + `<li class="is-goal"><i></i><div><b>출산예정일</b><span>40주 0일 · ${fmtK(due)}</span></div><em>${left > 0 ? 'D-' + left : '🎉'}</em></li>`;
        $('mm-fold').hidden = pastN === 0;
        $('mm-fold').textContent = `지난 일정 ${pastN}개 보기`;
        $('mm-plan').classList.add('is-folded');
        document.querySelectorAll('#mm-weekstrip a').forEach((a) => a.classList.toggle('is-cur', Number(a.dataset.w) === cw));
      }
      function go() {
        const v = $('mm-date').value;
        if (!v) { $('mm-err').hidden = false; $('mm-date').focus(); M.buzz(30); return; }
        $('mm-err').hidden = true;
        const st = { mode, date: v, cycle: $('mm-cycle').value, ivf: $('mm-ivf').value };
        try { localStorage.setItem(M.KEY, JSON.stringify(st)); } catch (e) {}
        render(st);
        window.dispatchEvent(new Event('mom:update'));
        M.buzz(12);
        M.sheet('mm-sheet', false);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
      document.querySelectorAll('.mm-tabs button').forEach((b) => b.addEventListener('click', () => { setMode(b.dataset.mode); M.buzz(); }));
      $('mm-go').addEventListener('click', go);
      $('mm-date').addEventListener('change', () => { $('mm-err').hidden = true; });
      $('mm-fold').addEventListener('click', () => {
        const ol = $('mm-plan'); const folded = ol.classList.toggle('is-folded');
        $('mm-fold').textContent = folded ? $('mm-fold').textContent.replace('접기', '보기') : $('mm-fold').textContent.replace('보기', '접기');
      });
      $('mm-reset').addEventListener('click', () => {
        if (!confirm('저장한 날짜를 지울까요?')) return;
        try { localStorage.removeItem(M.KEY); } catch (e) {}
        $('mm-date').value = '';
        $('mm-say').innerHTML = '반가워요! 나는 몽이예요.<br />날짜를 알려 주면 오늘 몇 주인지 알려 줄게요';
        window.dispatchEvent(new Event('mom:update'));
        M.sheet('mm-sheet', false);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      const st = M.load();
      if (st) { setMode(st.mode || 'lmp'); $('mm-date').value = st.date; if (st.cycle) $('mm-cycle').value = st.cycle; if (st.ivf) $('mm-ivf').value = st.ivf; render(st); }

      // 홈 화면에 추가 안내 — 안드로이드 크롬은 설치 창, 아이폰 사파리는 방법 안내. 이미 앱으로 열었거나 닫았으면 안 보인다
      const IK = 'crama:mom-install';
      let dismissed = false; try { dismissed = !!localStorage.getItem(IK); } catch (e) {}
      const card = $('mo-install');
      const standalone = document.documentElement.classList.contains('mo-standalone');
      if (!standalone && !dismissed) {
        const ua = navigator.userAgent;
        const ios = /iPhone|iPad|iPod/.test(ua) && !/CriOS|FxiOS|EdgiOS/.test(ua);
        if (ios) { $('mo-install-t').innerHTML = '아래 <b>공유</b> 버튼 → <b>홈 화면에 추가</b>'; card.hidden = false; }
        let deferred = null;
        window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); deferred = e; $('mo-install-btn').hidden = false; card.hidden = false; });
        $('mo-install-btn').addEventListener('click', async () => { if (!deferred) return; deferred.prompt(); try { await deferred.userChoice; } catch (e) {} deferred = null; card.hidden = true; });
      }
      $('mo-install-x').addEventListener('click', () => { card.hidden = true; try { localStorage.setItem(IK, '1'); } catch (e) {} });
    })();
  </script>
</MomLayout>
