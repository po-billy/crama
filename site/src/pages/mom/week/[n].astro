---
// 임신 N주 — "임신 20주 몇 개월", "임신 24주 검사" 검색을 받는다. 4~40주.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/mom.css';
import { MOM_BRAND, WEEK_FROM, WEEK_TO, monthOfWeek, trimesterOf, tasksOf } from '../../../lib/mom';
import { WEEKS } from '../../../data/mom-weeks';

export function getStaticPaths() {
  return WEEKS.map((w) => ({ params: { n: String(w.w) } }));
}
const n = Number(Astro.params.n);
const wk = WEEKS.find((w) => w.w === n)!;
const month = monthOfWeek(n);
const tri = trimesterOf(n);
const tasks = tasksOf(n);
const KIND = { check: '검사', admin: '신청', prep: '준비' } as const;
const daysLeft = 280 - n * 7;
const lenNote = n < 20 ? '19주까지는 머리~엉덩이 길이로 재요.' : '20주부터는 머리~발끝 길이로 재요.';
const title = `임신 ${n}주 몇 개월? ${month}개월 · 아기 크기 ${wk.like}${tasks.some((t) => t.kind === 'check') ? ' · 이번 주 검사' : ''}`;
const desc = `임신 ${n}주는 ${month}개월, ${tri.name}예요. 아기는 키 ${wk.len}${wk.wt !== '-' ? `, 몸무게 ${wk.wt}` : ''}로 ${wk.like}만 해요. ${wk.baby}`;
const faq = [
  { q: `임신 ${n}주는 몇 개월인가요?`, a: `4주를 한 달로 세면 임신 ${n}주는 ${month}개월이고, ${tri.name}에 해당해요. 출산예정일(40주)까지는 약 ${Math.max(0, daysLeft)}일 남았어요.` },
  { q: `임신 ${n}주 아기는 얼마나 큰가요?`, a: `평균적으로 키 ${wk.len}${wk.wt !== '-' ? `, 몸무게 ${wk.wt}` : ''} 정도로 ${wk.like}만 해요. 아기마다 차이가 크니 초음파 결과는 담당 의사와 상의하세요.` },
];
if (tasks.length) faq.push({ q: `임신 ${n}주에 받는 검사나 할 일이 있나요?`, a: tasks.map((t) => `${t.title}(${t.from}~${t.to}주)`).join(', ') + '을 챙길 시기예요.' });
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title={title} description={desc} jsonLd={jsonLd}>
  <div class="wrap mm">
    <nav class="mm-crumb"><a href="/mom/">{MOM_BRAND}</a> › 임신 {n}주</nav>
    <span class="mm-brand">{tri.name} · {month}개월</span>
    <h1>임신 {n}주, 아기는 {wk.like}만 해요</h1>
    <p class="mm-lead">임신 {n}주 0일부터 {n}주 6일까지의 이야기예요. 출산예정일까지 약 {Math.max(0, daysLeft)}일 남았어요.</p>
    <div class="mm-hide" id="mm-mine" hidden><p class="mm-note" id="mm-mine-t"></p></div>

    <div class="mm-size">
      <div><span>키</span><b>{wk.len}</b></div>
      <div><span>몸무게</span><b>{wk.wt}</b></div>
      <div><span>크기 비유</span><b>{wk.like}</b></div>
    </div>
    <p class="mm-note">※ 평균치예요. {lenNote}</p>

    <section class="mm-sec">
      <h2>아기는 지금</h2>
      <p>{wk.baby}</p>
    </section>
    <section class="mm-sec">
      <h2>엄마 몸은</h2>
      <p>{wk.mom}</p>
    </section>

    <section class="mm-sec">
      <h2>임신 {n}주에 챙길 것</h2>
      {tasks.length ? (
        <div class="mm-tasks">
          {tasks.map((t) => <div class="mm-task"><em class={`k-${t.kind}`}>{KIND[t.kind]}</em><b>{t.title} <small>{t.from === t.to ? `${t.from}주` : `${t.from}~${t.to}주`}</small></b><span>{t.desc}</span></div>)}
        </div>
      ) : <p>이번 주에 정해진 검사는 없어요. 다음 진료 날짜만 확인해 두세요.</p>}
      <p class="mm-note">※ 일반적인 산전관리 일정이에요. 실제 검사 시기는 다니는 병원 안내를 따르세요.</p>
    </section>

    <section class="mm-sec">
      <h2>내 예정일로 날짜 보기</h2>
      <p>출산예정일 계산기에 날짜를 넣으면 이번 주가 정확히 며칠부터 며칠까지인지, 지금 몇 주 며칠인지 바로 보여 드려요.</p>
      <div class="mm-chips"><a href="/mom/">출산예정일 · 주수 계산하기 →</a></div>
    </section>

    <section class="mm-sec">
      <h2>자주 묻는 질문</h2>
      <div class="mm-faq">{faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </section>

    <div class="mm-pn">
      {n > WEEK_FROM ? <a href={`/mom/week/${n - 1}/`}>← {n - 1}주</a> : <span></span>}
      <a href="/mom/">계산기</a>
      {WEEK_TO > n ? <a href={`/mom/week/${n + 1}/`}>{n + 1}주 →</a> : <a href="/mom/baby/">태어난 뒤 →</a>}
    </div>
    <div class="mm-weeks">{WEEKS.map((w) => <a href={`/mom/week/${w.w}/`} class={w.w === n ? 'is-cur' : ''}>{w.w}주</a>)}</div>
  </div>

  <script is:inline define:vars={{ n }}>
    (() => {
      try {
        const st = JSON.parse(localStorage.getItem('crama:mom') || 'null');
        if (!st || !st.date) return;
        const [y, m, d] = st.date.split('-').map(Number);
        let base = new Date(y, m - 1, d);
        const add = (x, k) => new Date(x.getFullYear(), x.getMonth(), x.getDate() + k);
        if (st.mode === 'lmp') base = add(base, Number(st.cycle || 28) - 28);
        else if (st.mode === 'conc') base = add(base, -14);
        else if (st.mode === 'ivf') base = add(base, -(Number(st.ivf || 5) + 14));
        else base = add(base, -280);
        const s = add(base, n * 7), e = add(base, n * 7 + 6);
        const f = (x) => `${x.getMonth() + 1}월 ${x.getDate()}일`;
        document.getElementById('mm-mine-t').textContent = `내 예정일 기준으로 임신 ${n}주는 ${s.getFullYear()}년 ${f(s)} ~ ${f(e)}이에요.`;
        document.getElementById('mm-mine').hidden = false;
      } catch (e) {}
    })();
  </script>
</BaseLayout>
