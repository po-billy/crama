---
// 월별 손없는 날 — "12월 손없는날", "2027년 3월 손없는날 이사" 검색어용. 계산은 lib/sonless(음력 9·0일).
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/portal.css';
import { monthDays, MONTHS, DOW, isOff } from '../../lib/sonless';

export function getStaticPaths() { return MONTHS.map((x, i) => ({ params: { ym: x.key }, props: { y: x.y, m: x.m, prev: MONTHS[i - 1] ?? null, next: MONTHS[i + 1] ?? null } })); }
const { y, m, prev, next } = Astro.props as { y: number; m: number; prev: any; next: any };
const days = monthDays(y, m);
const sl = days.filter((d) => d.sonless);
const offSl = sl.filter(isOff);
const first = days[0].dow;
const cells: (typeof days[number] | null)[] = [...Array(first).fill(null), ...days];
const lab = (d: typeof days[number]) => `${m}월 ${d.d}일(${DOW[d.dow]})`;
const title = `${y}년 ${m}월 손없는날 — 이사하기 좋은 날 ${sl.length}일${offSl.length ? `, 주말·휴일 ${offSl.length}일` : ''}`;
const desc = `${y}년 ${m}월 손없는 날은 ${sl.map((d) => `${d.d}일`).join(', ')}입니다.${offSl.length ? ` 이 가운데 주말·공휴일은 ${offSl.map((d) => `${d.d}일(${DOW[d.dow]})`).join(', ')}이에요.` : ''} 음력 날짜와 함께 달력으로 보고, 이사 비용·전입신고 일정까지 확인하세요.`;
const faq = [
  { q: `${y}년 ${m}월 손없는 날은 언제인가요?`, a: `${sl.map((d) => `${lab(d)} 음력 ${d.lm}월 ${d.ld}일`).join(', ')}입니다.` },
  { q: '손없는 날은 어떻게 정하나요?', a: '음력 날짜의 끝자리가 9나 0인 날(9·10·19·20·29·30일)을 손없는 날로 봅니다. 민속에서 "손"은 날짜에 따라 방향을 옮겨 다니며 해를 끼친다는 귀신인데, 이날은 손이 하늘로 올라가 없다고 여겼습니다.' },
  { q: '손없는 날에 이사하면 비용이 더 드나요?', a: '손없는 날, 특히 주말과 겹치는 날은 이사 수요가 몰려 비용이 오르고 예약도 일찍 찹니다. 날짜에 얽매이지 않는다면 평일이나 손 있는 날이 더 저렴한 경우가 많습니다.' },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title={title} description={desc} jsonLd={jsonLd}>
  <div class="pt pt-narrow sl" style="--c:#8b5cf6">
    <nav class="pt-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/moving-day/">손없는 날</a> › {y}년 {m}월</nav>
    <h1 style="font-size:1.7rem;font-weight:800;letter-spacing:-0.02em;margin:0 0 0.9rem">{y}년 {m}월 손없는 날</h1>

    <div class="tl-result">
      <div class="tl-result__label">이사하기 좋은 손없는 날</div>
      <div class="tl-result__big">{sl.length}일</div>
      <div class="tl-result__sub">{offSl.length ? `주말·공휴일과 겹치는 날: ${offSl.map((d) => `${d.d}일(${DOW[d.dow]})`).join(', ')}` : '이달에는 주말과 겹치는 손없는 날이 없어요'}</div>
    </div>

    <section class="pt-sec">
      <div class="sl-cal">
        {DOW.map((w, i) => <b class={i === 0 ? 'sun' : i === 6 ? 'sat' : ''}>{w}</b>)}
        {cells.map((c) => c ? (
          <div class={`${c.sonless ? 'on' : ''} ${c.dow === 0 || c.holiday ? 'sun' : c.dow === 6 ? 'sat' : ''}`}>
            <span>{c.d}</span><small>{c.ld === 1 ? `${c.lm}.1` : c.ld}</small>{c.holiday && <em>{c.holiday.replace(/대체공휴일\((.+)\)/, '대체')}</em>}
          </div>
        ) : <div class="blank"></div>)}
      </div>
      <p class="pp-note">※ 보라색 칸이 손없는 날, 작은 숫자는 음력 날짜예요. 손없는 날은 민속 풍습이라 과학적 근거는 없어요.</p>
    </section>

    <section class="pt-sec">
      <div class="pt-sec__head"><div><h2>{m}월 손없는 날 목록</h2></div></div>
      <div class="tl-wrap"><table class="tl-table">
        <thead><tr><th>양력</th><th>음력</th><th></th></tr></thead>
        <tbody>{sl.map((d) => <tr><td class={isOff(d) ? 'is-on' : ''}>{lab(d)}</td><td>{d.lm}월 {d.ld}일</td><td>{d.holiday || (d.dow === 0 || d.dow === 6 ? '주말' : '평일')}</td></tr>)}</tbody>
      </table></div>
    </section>

    <section class="pt-sec">
      <div class="pt-sec__head"><div><h2>이사 날짜 잡을 때</h2></div></div>
      <ul style="line-height:1.8;color:#334155;padding-left:1.1rem;margin:0">
        <li>주말 손없는 날은 이사 업체 예약이 가장 먼저 차요. 한 달 전에는 견적을 받아 두세요.</li>
        <li>이사한 날부터 14일 안에 전입신고를 해야 해요. 전세·월세라면 전입신고와 함께 확정일자를 받아 두세요.</li>
        <li>중개보수가 궁금하면 <a href="/realty-fee/">부동산 중개보수 계산기</a>로 미리 확인하세요.</li>
      </ul>
    </section>

    <section class="pt-sec">
      <div class="pt-chips">
        {prev && <a class="pt-chip" href={`/moving-day/${prev.key}/`}>← {prev.y}년 {prev.m}월</a>}
        {next && <a class="pt-chip" href={`/moving-day/${next.key}/`}>{next.y}년 {next.m}월 →</a>}
        <a class="pt-chip" href="/moving-day/">전체 달 보기</a>
        <a class="pt-chip" href="/lunar/">음력 변환</a>
      </div>
    </section>

    <section class="pt-sec pt-prose">
      <h2>자주 묻는 질문</h2>
      {faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
    </section>
  </div>
  <style>
    .sl-cal { display:grid; grid-template-columns:repeat(7, 1fr); gap:4px; }
    .sl-cal > b { text-align:center; font-size:.78rem; font-weight:800; color:#64748B; padding:4px 0; }
    .sl-cal > b.sun { color:#DC2626; } .sl-cal > b.sat { color:#2563EB; }
    .sl-cal > div { min-height:58px; border-radius:10px; border:1px solid var(--line, #e5e7eb); background:#fff; padding:5px 6px; display:flex; flex-direction:column; gap:1px; }
    .sl-cal > div.blank { border:0; background:transparent; }
    .sl-cal span { font-weight:800; font-size:.95rem; }
    .sl-cal small { font-size:.68rem; color:#94A3B8; }
    .sl-cal em { font-style:normal; font-size:.62rem; color:#DC2626; font-weight:700; line-height:1.2; }
    .sl-cal div.sun span { color:#DC2626; } .sl-cal div.sat span { color:#2563EB; }
    .sl-cal div.on { background:#8B5CF6; border-color:#8B5CF6; }
    .sl-cal div.on span, .sl-cal div.on small, .sl-cal div.on em { color:#fff; }
  </style>
</BaseLayout>
