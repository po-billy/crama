---
// 야근·휴일근로 수당 계산기 — 근로기준법 제56조: 연장 50% 가산, 야간(22~06시) 50% 가산, 휴일 8시간 이내 50%·초과 100% 가산. 상시 5명 미만 사업장은 가산 없음.
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/portal.css';

const faq = [
  { q: '야근수당은 몇 배인가요?', a: '하루 8시간 또는 주 40시간을 넘는 연장근로는 통상임금의 1.5배입니다. 밤 10시부터 다음 날 오전 6시 사이에 일하면 야간근로로 50%가 더 붙어, 연장이면서 야간이면 2배가 됩니다.' },
  { q: '휴일근로수당은 어떻게 계산하나요?', a: '휴일에 일한 시간 중 8시간까지는 1.5배, 8시간을 넘는 시간은 2배입니다. 야간이면 50%가 더 붙습니다.' },
  { q: '5인 미만 회사도 가산수당을 받나요?', a: '상시 근로자 5명 미만 사업장에는 연장·야간·휴일 가산 규정이 적용되지 않습니다. 일한 시간만큼 통상임금(1배)은 받아야 합니다.' },
  { q: '통상시급은 어떻게 구하나요?', a: '월 통상임금을 월 소정근로시간(주 40시간이면 209시간)으로 나눕니다. 기본급과 매달 고정으로 받는 수당이 통상임금에 들어갑니다.' },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title="야근수당 계산기 — 연장·야간·휴일근로 수당 1.5배·2배 계산 (2026)" description="통상시급(또는 월급)과 연장·야간·휴일 근로시간을 넣으면 야근수당을 바로 계산합니다. 연장 1.5배, 야간 50% 가산, 휴일 8시간 초과 2배까지 근로기준법 기준. 5인 미만 사업장 계산도." jsonLd={jsonLd}>
  <div class="pt pt-narrow" style="--c:#4f46e5">
    <nav class="pt-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/hub/pay/">월급·세금</a> › 야근수당 계산기</nav>
    <header class="pt-hubhero">
      <img src="/img/portal/g-pay.webp" alt="" width="200" height="200" />
      <div><h1>야근수당 계산기</h1><p>연장·야간·휴일에 일한 시간을 넣으면 받을 수당을 계산해요. 근로기준법 제56조 기준이에요.</p></div>
    </header>

    <section class="pt-sec">
      <div class="tl-card">
        <div class="tl-row">
          <label class="tl-field">월 통상임금 (만원, 기본급+고정수당)<input id="monthly" type="number" inputmode="numeric" placeholder="예: 300" /></label>
          <label class="tl-field">또는 통상 시급 (원)<input id="hourly" type="number" inputmode="numeric" placeholder="예: 14354" /></label>
        </div>
        <div class="tl-row">
          <label class="tl-field">연장근로 (시간)<input id="ot" type="number" inputmode="decimal" value="10" /></label>
          <label class="tl-field">그중 밤 10시~오전 6시 (시간)<input id="otn" type="number" inputmode="decimal" value="0" /></label>
        </div>
        <div class="tl-row">
          <label class="tl-field">휴일근로 (시간)<input id="hol" type="number" inputmode="decimal" value="0" /></label>
          <label class="tl-field">그중 밤 10시~오전 6시 (시간)<input id="holn" type="number" inputmode="decimal" value="0" /></label>
        </div>
        <div class="tl-row">
          <label class="tl-field">회사 규모<select id="size"><option value="5">상시 5명 이상</option><option value="4">5명 미만(가산 없음)</option></select></label>
        </div>
        <button type="button" class="tl-btn" id="go">수당 계산하기</button>
      </div>
      <div class="tl-result" id="res" hidden aria-live="polite">
        <div class="tl-result__label">받을 수당(세전)</div>
        <div class="tl-result__big" id="big"></div>
        <div class="tl-result__sub" id="sub"></div>
      </div>
      <div class="tl-wrap" id="tw" hidden style="margin-top:.8rem"><table class="tl-table"><thead><tr><th>구분</th><th>시간</th><th>배율</th><th>금액</th></tr></thead><tbody id="tb"></tbody></table></div>
      <p class="pp-note">※ 근로기준법 제56조 기준 근사 계산. 휴일근로는 8시간까지 1.5배, 넘는 시간 2배로 계산했어요(휴일 야간 시간은 휴일 8시간 이내에 든다고 가정). 포괄임금 계약이면 이미 월급에 들어 있을 수 있어요.</p>
    </section>

    <section class="pt-sec">
      <div class="tl-wrap"><table class="tl-table">
        <thead><tr><th>근로 형태</th><th>5명 이상</th><th>5명 미만</th></tr></thead>
        <tbody>
          <tr><td>연장(1일 8시간·주 40시간 초과)</td><td>1.5배</td><td>1배</td></tr>
          <tr><td>야간(22시~06시)</td><td>+0.5배</td><td>1배</td></tr>
          <tr><td>연장 + 야간</td><td>2배</td><td>1배</td></tr>
          <tr><td>휴일 8시간 이내</td><td>1.5배</td><td>1배</td></tr>
          <tr><td>휴일 8시간 초과</td><td>2배</td><td>1배</td></tr>
        </tbody>
      </table></div>
      <div class="pt-chips" style="margin-top:10px"><a class="pt-chip" href="/pay-counter/">실시간 월급 카운터</a><a class="pt-chip" href="/annual-leave/">연차 계산기</a><a class="pt-chip" href="/wage/">시급 → 월급</a></div>
    </section>

    <section class="pt-sec pt-prose">
      <h2>자주 묻는 질문</h2>
      {faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
    </section>
  </div>
  <style>#tw[hidden] { display:none; }</style>
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const won = (n: number) => `${Math.round(n).toLocaleString('ko-KR')}원`;
    $('monthly').addEventListener('input', () => { const m = +$('monthly').value; if (m) $('hourly').value = String(Math.round((m * 10_000) / 209)); });
    $('go').addEventListener('click', () => {
      const h = +$('hourly').value || ((+$('monthly').value || 0) * 10_000) / 209;
      if (!h) { alert('월 통상임금이나 시급을 넣어 주세요.'); return; }
      const small = $('size').value === '4';
      const ot = +$('ot').value || 0, otn = Math.min(+$('otn').value || 0, ot), hol = +$('hol').value || 0, holn = Math.min(+$('holn').value || 0, hol);
      const holIn = Math.min(8, hol), holOver = Math.max(0, hol - 8);
      const rows = small
        ? [['연장근로', ot, 1], ['휴일근로', hol, 1]]
        : [['연장근로', ot, 1.5], ['연장 중 야간 가산', otn, 0.5], ['휴일근로 8시간 이내', holIn, 1.5], ['휴일근로 8시간 초과', holOver, 2], ['휴일 중 야간 가산', holn, 0.5]];
      const list = (rows as [string, number, number][]).filter((r) => r[1] > 0);
      const total = list.reduce((s, r) => s + r[1] * r[2] * h, 0);
      (document.getElementById('big') as HTMLElement).textContent = won(total);
      (document.getElementById('sub') as HTMLElement).textContent = `통상시급 ${won(h)} 기준${small ? ' · 5명 미만이라 가산 없음' : ''}`;
      (document.getElementById('tb') as HTMLElement).innerHTML = list.map((r) => `<tr><td>${r[0]}</td><td>${r[1]}시간</td><td>${r[2]}배</td><td>${won(r[1] * r[2] * h)}</td></tr>`).join('');
      (document.getElementById('res') as HTMLElement).hidden = false; (document.getElementById('tw') as HTMLElement).hidden = false;
      try { (window as any).gtag?.('event', 'overtime_pay', { small }); } catch { /* 무시 */ }
    });
  </script>
</BaseLayout>
