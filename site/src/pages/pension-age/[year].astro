---
// 출생연도별 국민연금 수령 나이 — 노령연금을 받기 시작하는 나이·연도, 조기·연기 수령 시 지급률.
// 금액은 가입 이력마다 달라 다루지 않는다(나이·연도·지급률만).
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { THIS_YEAR, pensionAge, bornYears, BORN_FROM, BORN_TO } from '../../lib/people';
import { pensionOptions, PENSION_BANDS } from '../../lib/life';
import '../../styles/portal.css';

export function getStaticPaths() { return bornYears().map((y) => ({ params: { year: String(y) }, props: { year: y } })); }
const { year } = Astro.props as { year: number };
const short = String(year).slice(2);
const pAge = pensionAge(year);
const start = year + pAge;
const left = start - THIS_YEAR;
const opts = pensionOptions(year);
const early = opts[0];
const late = opts[opts.length - 1];
const myBand = PENSION_BANDS.find((b) => b.age === pAge)!;
const when = left > 0 ? `${left}년 뒤` : left === 0 ? '올해' : `${-left}년 전`;

const title = `${year}년생 국민연금 수령 나이 — 만 ${pAge}세, ${start}년부터`;
const description = `${year}년생은 국민연금(노령연금)을 만 ${pAge}세가 되는 ${start}년부터 받습니다. 조기 수령은 만 ${early.age}세(${early.year}년)부터 가능하고, 최대 만 ${late.age}세까지 늦추면 ${late.rate}%를 받습니다. 나이별 지급률을 표로 정리했습니다.`;
const faq = [
  { q: `${year}년생은 국민연금을 몇 살부터 받나요?`, a: `만 ${pAge}세부터입니다. ${year}년생은 ${start}년에 만 ${pAge}세가 되며, 생일이 속한 달의 다음 달부터 노령연금이 지급됩니다. 가입 기간이 10년 이상이어야 합니다.` },
  { q: `${year}년생은 조기 수령을 언제부터 할 수 있나요?`, a: `만 ${early.age}세가 되는 ${early.year}년부터 신청할 수 있습니다. 가입 기간이 10년 이상이고 소득이 있는 업무에 종사하지 않아야 하며, 1년 앞당길 때마다 6%씩 줄어 5년을 당기면 ${early.rate}%를 받습니다. 줄어든 비율은 평생 유지됩니다.` },
  { q: `${year}년생이 연금을 늦춰 받으면 얼마나 늘어나나요?`, a: `받는 시기를 1년 늦출 때마다 7.2%(한 달에 0.6%)씩 늘어납니다. 최대 5년까지 늦출 수 있어, 만 ${late.age}세(${late.year}년)부터 받으면 ${late.rate}%가 됩니다.` },
  { q: '수령 나이가 출생연도마다 다른 이유는 무엇인가요?', a: '국민연금법에 따라 노령연금을 받기 시작하는 나이가 만 60세에서 65세로 단계적으로 늦춰지고 있기 때문입니다. 1953~56년생 61세, 1957~60년생 62세, 1961~64년생 63세, 1965~68년생 64세, 1969년생 이후는 65세입니다.' },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="pt pt-narrow">
    <nav class="pt-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/pension-age/">국민연금 수령 나이</a> › {year}년생</nav>
    <header class="pt-hubhero" style="--c:#0ea5e9">
      <img src="/img/portal/c-salary.webp" alt="" width="200" height="200" />
      <div><h1>{year}년생 국민연금 수령 나이</h1><p>{short}년생이 노령연금을 받기 시작하는 나이와 연도</p></div>
    </header>

    <div class="tl-result" style="margin-top:1.2rem">
      <div class="tl-result__label">{year}년생 노령연금 수급 개시</div>
      <div class="tl-result__big">만 {pAge}세 · {start}년</div>
      <div class="tl-result__sub">{left > 0 ? `${THIS_YEAR}년 기준 ${left}년 남았어요.` : left === 0 ? '올해 받기 시작하는 나이가 됩니다.' : `${start}년에 이미 받을 수 있는 나이가 됐어요.`} 생일이 속한 달의 다음 달부터 지급됩니다.</div>
    </div>

    <div class="pp-facts pp-facts--4" style="margin-top:0.8rem">
      <div><span>정상 수령</span><b>만 {pAge}세</b></div>
      <div><span>조기 수령 가능</span><b>만 {early.age}세부터</b></div>
      <div><span>연기 수령 한도</span><b>만 {late.age}세까지</b></div>
      <div><span>만 60세 되는 해</span><b>{year + 60}년</b></div>
    </div>

    <section class="pt-sec">
      <div class="pt-sec__head"><div><h2>받는 나이에 따른 지급률</h2><p>정상 수령액을 100%로 봤을 때</p></div></div>
      <div class="tl-wrap">
        <table class="tl-table">
          <thead><tr><th>받기 시작하는 나이</th><th>연도</th><th>구분</th><th>지급률</th></tr></thead>
          <tbody>
            {opts.map((o) => (
              <tr>
                <td>만 {o.age}세</td><td>{o.year}년</td><td>{o.kind}</td>
                <td class={o.rate === 100 ? 'is-on' : ''}><b>{o.rate}%</b></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pp-note">※ 조기 수령은 한 달에 0.5%(1년 6%)씩 줄고, 연기 수령은 한 달에 0.6%(1년 7.2%)씩 늘어납니다. 표는 1년 단위로 계산한 값이며 실제로는 월 단위로 적용됩니다. 조기 수령은 가입 기간 10년 이상이고 일정 수준을 넘는 소득이 없어야 신청할 수 있습니다. 실제 받을 금액은 가입 기간과 낸 보험료에 따라 달라지므로 국민연금공단의 '내 연금 알아보기'에서 확인하세요. 제도가 바뀌면 기준이 달라질 수 있습니다.</p>
    </section>

    <section class="pt-sec pt-prose">
      <h2>{year}년생이 알아 둘 것</h2>
      <p>{year}년생은 <b>{myBand.label}</b> 구간에 해당해 만 {pAge}세부터 노령연금을 받습니다. 국민연금 보험료는 만 60세가 되기 전까지, 곧 {year + 60}년 생일 전 달까지 내는 것이 원칙입니다{pAge > 60 ? `. 그래서 보험료 납부가 끝나는 만 60세와 연금을 받기 시작하는 만 ${pAge}세 사이에 ${pAge - 60}년의 공백이 생깁니다. 가입 기간이 모자라거나 더 늘리고 싶다면 만 60세 이후에도 임의계속가입으로 보험료를 더 낼 수 있습니다` : ''}.</p>
      <p>노령연금을 받으려면 가입 기간이 10년(120개월) 이상이어야 합니다. 10년을 채우지 못한 채 수령 나이가 되면 그동안 낸 보험료에 이자를 더한 반환일시금을 받게 됩니다.</p>
    </section>

    <div class="pt-ad"><AdSlot slot="pension-mid" /></div>

    <section class="pt-sec">
      <div class="pt-sec__head"><div><h2>출생연도별 수령 나이</h2></div></div>
      <div class="tl-wrap">
        <table class="tl-table">
          <thead><tr><th>출생연도</th><th>노령연금</th><th>조기 수령</th></tr></thead>
          <tbody>{PENSION_BANDS.map((b) => <tr><td class={b.age === pAge ? 'is-on' : ''}>{b.label}</td><td>만 {b.age}세</td><td>만 {b.age - 5}세부터</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="pt-sec pt-prose">
      <h2>자주 묻는 질문</h2>
      {faq.map((f) => (<><p><b>{f.q}</b><br />{f.a}</p></>))}
    </section>

    <section class="pt-sec pp-links">
      <a class="pp-link" href="/blog/national-pension-start-age-by-birth-year/"><span><b>국민연금, 몇 살부터 받나</b><span>조기·연기 수령과 일하면서 받을 때 달라지는 점</span></span><svg class="pp-link__go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a>
      <a class="pp-link" href={`/born/${year}/`}><span><b>{year}년생 나이·띠·학번</b><span>올해 챙길 것까지 한 번에</span></span><svg class="pp-link__go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a>
      <a class="pp-link" href={`/health-check/${year}/`}><span><b>{year}년생 건강검진</b><span>{THIS_YEAR}년 대상 여부와 암검진</span></span><svg class="pp-link__go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a>
      <a class="pp-link" href="/insurance/"><span><b>4대보험 계산기</b><span>월급에서 국민연금이 얼마나 빠지는지</span></span><svg class="pp-link__go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a>
    </section>

    <section class="pt-sec">
      <div class="pt-sec__head"><div><h2>다른 출생연도</h2></div><a class="pt-more" href="/pension-age/">전체 보기 →</a></div>
      <div class="pt-chips">
        {[-3, -2, -1, 1, 2, 3].map((k) => year + k).filter((y) => y >= BORN_FROM && y <= BORN_TO).map((y) => <a class="pt-chip" href={`/pension-age/${y}/`}>{y}년생</a>)}
      </div>
    </section>
  </div>
</BaseLayout>
