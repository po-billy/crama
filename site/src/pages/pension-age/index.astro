---
// 국민연금 수령 나이 — 출생연도별 수급 개시 나이 표와 연도별 페이지 목록.
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { THIS_YEAR, pensionAge, bornYears, BORN_FROM, BORN_TO } from '../../lib/people';
import { PENSION_BANDS } from '../../lib/life';
import '../../styles/portal.css';

const startsNow = bornYears().filter((y) => y + pensionAge(y) === THIS_YEAR);
const startsNext = bornYears().filter((y) => y + pensionAge(y) === THIS_YEAR + 1);
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
  { '@type': 'Question', name: '국민연금은 몇 살부터 받나요?', acceptedAnswer: { '@type': 'Answer', text: '출생연도에 따라 다릅니다. 1952년생 이전 만 60세, 1953~56년생 61세, 1957~60년생 62세, 1961~64년생 63세, 1965~68년생 64세, 1969년생 이후는 만 65세부터 노령연금을 받습니다.' } },
  { '@type': 'Question', name: `${THIS_YEAR}년에 국민연금을 받기 시작하는 출생연도는?`, acceptedAnswer: { '@type': 'Answer', text: startsNow.length ? `${startsNow.join(', ')}년생이 ${THIS_YEAR}년에 수급 개시 나이가 됩니다.` : `${THIS_YEAR}년에 새로 수급 개시 나이가 되는 출생연도는 없습니다. 수급 개시 나이가 한 살씩 늦춰지는 구간이라 그렇습니다.` } },
] };
---
<BaseLayout title="국민연금 수령 나이 조회 — 출생연도별 수급 개시 나이·조기 수령" description="국민연금(노령연금)을 받기 시작하는 나이는 출생연도에 따라 만 60~65세로 다릅니다. 출생연도를 누르면 내 수령 나이와 연도, 조기·연기 수령 시 지급률을 바로 확인할 수 있습니다." jsonLd={jsonLd}>
  <div class="pt pt-narrow">
    <nav class="pt-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/hub/">생활 조회</a> › 국민연금 수령 나이</nav>
    <header class="pt-hubhero" style="--c:#0ea5e9">
      <img src="/img/portal/c-salary.webp" alt="" width="200" height="200" />
      <div><h1>국민연금 수령 나이</h1><p>출생연도만 누르면 언제부터 받는지 알려드려요</p></div>
    </header>

    <section class="pt-sec">
      <div class="tl-card">
        <div class="tl-row">
          <label class="tl-field">출생연도로 찾기<input id="pa-year" type="number" inputmode="numeric" min={BORN_FROM} max={BORN_TO} placeholder="예: 1968" /></label>
          <button type="button" class="tl-btn" id="pa-go">수령 나이 보기</button>
        </div>
      </div>
    </section>

    <section class="pt-sec">
      <div class="pt-sec__head"><div><h2>출생연도별 수령 나이</h2></div></div>
      <div class="tl-wrap">
        <table class="tl-table">
          <thead><tr><th>출생연도</th><th>노령연금</th><th>조기 수령</th><th>연기 수령 한도</th></tr></thead>
          <tbody>{PENSION_BANDS.map((b) => <tr><td><b>{b.label}</b></td><td>만 {b.age}세</td><td>만 {b.age - 5}세부터</td><td>만 {b.age + 5}세까지</td></tr>)}</tbody>
        </table>
      </div>
      <p class="pp-note">※ 국민연금법의 출생연도별 기준입니다. 노령연금은 가입 기간 10년 이상이어야 받을 수 있고, 제도가 바뀌면 기준이 달라질 수 있습니다. 실제 받을 금액은 국민연금공단의 '내 연금 알아보기'에서 확인하세요.</p>
    </section>

    {(startsNow.length > 0 || startsNext.length > 0) && (
      <section class="pt-sec">
        <div class="pt-sec__head"><div><h2>곧 받기 시작하는 출생연도</h2></div></div>
        <div class="pt-chips">
          {startsNow.map((y) => <a class="pt-chip" href={`/pension-age/${y}/`}>{y}년생 · {THIS_YEAR}년부터</a>)}
          {startsNext.map((y) => <a class="pt-chip" href={`/pension-age/${y}/`}>{y}년생 · {THIS_YEAR + 1}년부터</a>)}
        </div>
      </section>
    )}

    <div class="pt-ad"><AdSlot slot="pension-index" /></div>

    <section class="pt-sec pt-prose">
      <h2>조기 수령과 연기 수령</h2>
      <p><b>조기노령연금</b>은 정해진 나이보다 최대 5년 일찍 받는 제도입니다. 가입 기간이 10년 이상이고 일정 수준을 넘는 소득이 없어야 하며, 1년 일찍 받을 때마다 6%씩 줄어 5년을 당기면 70%를 받습니다. 한 번 줄어든 비율은 평생 유지됩니다.</p>
      <p><b>연기연금</b>은 받는 시기를 최대 5년 늦추는 제도입니다. 1년 늦출 때마다 7.2%씩 늘어 5년을 늦추면 136%를 받습니다. 어느 쪽이 유리한지는 건강 상태, 다른 소득, 필요한 생활비에 따라 달라집니다. 자세한 설명은 <a href="/blog/national-pension-start-age-by-birth-year/">국민연금, 내 출생연도는 몇 살부터 받나</a>에 있습니다.</p>
    </section>

    <section class="pt-sec">
      <div class="pt-sec__head"><div><h2>출생연도별 보기</h2></div></div>
      <div class="pt-chips">{bornYears().map((y) => <a class="pt-chip" href={`/pension-age/${y}/`}>{y}</a>)}</div>
    </section>
  </div>
  <script is:inline define:vars={{ from: BORN_FROM, to: BORN_TO }}>
    (() => {
      const inp = document.getElementById('pa-year'); if (!inp) return;
      const go = () => { const y = Number(inp.value); if (!(y >= from && y <= to)) { inp.focus(); return; } location.href = '/pension-age/' + y + '/'; };
      document.getElementById('pa-go').addEventListener('click', go);
      inp.addEventListener('keydown', (e) => { if (e.key === 'Enter') go(); });
    })();
  </script>
</BaseLayout>
