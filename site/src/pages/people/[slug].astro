---
// 인물 상세 — 공개된 사실 정보(생년월일·직업)와 거기서 계산되는 나이·띠·별자리만 다룬다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import PersonChip from '../../components/PersonChip.astro';
import { PEOPLE, PEOPLE_UPDATED, THIS_YEAR, parts, personZodiac, personStar, birthLabel, initial, topic, starRange, checkupTarget, BORN_FROM, BORN_TO, type Person } from '../../lib/people';
import '../../styles/portal.css';

export function getStaticPaths() {
  return PEOPLE.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Person };
const { y, m, d } = parts(p.birth);
const z = personZodiac(p), s = personStar(p);
const sameYear = PEOPLE.filter((x) => x.slug !== p.slug && parts(x.birth).y === y).slice(0, 12);
const sameDay = PEOPLE.filter((x) => x.slug !== p.slug && parts(x.birth).m === m && parts(x.birth).d === d).slice(0, 8);
const hasBorn = y >= BORN_FROM && y <= BORN_TO;
const yearAgeNow = THIS_YEAR - y;
const title = `${p.name} 나이·생일·띠·별자리 (${y}년생)`;
const description = `${p.name}(${p.job})${topic(p.name)} ${birthLabel(p)}생으로 ${THIS_YEAR}년 기준 만 ${yearAgeNow - 1}~${yearAgeNow}세, ${z.name}, ${s.name}입니다. 같은 해에 태어난 인물도 함께 확인하세요.`;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Person', name: p.name, ...(p.en ? { alternateName: p.en } : {}),
  birthDate: p.birth, jobTitle: p.job, sameAs: [`https://www.wikidata.org/wiki/${p.id}`],
};
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="pt pt-narrow">
    <nav class="pt-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/people/">인물</a> › {hasBorn ? <a href={`/born/${y}/`}>{y}년생</a> : `${y}년생`} › {p.name}</nav>

    <header class="pp-prof">
      {p.img
        ? <img class="pp-ava" src={p.img} alt={`${p.name} 사진`} width="240" height="240" />
        : <span class="pp-ava pp-ava--txt" aria-hidden="true">{initial(p.name)}</span>}
      <div>
        <h1>{p.name}</h1>
        {p.en && <p class="pp-prof__en">{p.en}</p>}
        <div class="pp-tags">{p.jobs.map((j) => <span class="pp-tag">{j}</span>)}</div>
      </div>
    </header>

    <div class="pp-facts pp-facts--4">
      <div><span>생년월일</span><b>{y}.{String(m).padStart(2, '0')}.{String(d).padStart(2, '0')}</b></div>
      <div><span>나이</span><b id="pp-age" data-birth={p.birth}>만 {yearAgeNow}세</b></div>
      <a href={`/people/zodiac/${z.slug}/`}><span>띠</span><b>{z.emoji} {z.name}</b></a>
      <a href={`/people/star/${s.slug}/`}><span>별자리</span><b>{s.emoji} {s.name}</b></a>
    </div>

    <section class="pt-sec pt-prose">
      <p>
        {p.name}{topic(p.name)} <b>{birthLabel(p)}</b>에 태어난 {p.job}입니다. <span id="pp-age-line">{THIS_YEAR}년 기준 연 나이는 {yearAgeNow}세</span>이고,
        세는 나이로는 {yearAgeNow + 1}세입니다. {y}년생은 <a href={`/people/zodiac/${z.slug}/`}>{z.name}</a>이며,
        생일 {m}월 {d}일은 <a href={`/people/star/${s.slug}/`}>{s.name}</a>({starRange(s)})에 해당합니다.
        <span id="pp-bday-line"></span>
      </p>
    </section>

    {hasBorn && (
      <section class="pt-sec pp-links">
        <a class="pp-link" href={`/born/${y}/`}>
          <span><b>{y}년생 모아보기</b><span>만 나이·띠·학번·같은 해 인물을 한 번에</span></span>
          <svg class="pp-link__go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </a>
        <a class="pp-link" href={`/health-check/${y}/`}>
          <span><b>{y}년생 건강검진 대상 확인</b><span>{THIS_YEAR}년 {checkupTarget(y) ? '대상 연도예요' : '대상이 아닌 연도예요'} · 자세히 보기</span></span>
          <svg class="pp-link__go" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      </section>
    )}

    {sameYear.length > 0 && (
      <section class="pt-sec">
        <div class="pt-sec__head"><div><h2>같은 해 태어난 인물</h2><p>{y}년생</p></div>{hasBorn && <a class="pt-more" href={`/born/${y}/`}>더보기 →</a>}</div>
        <div class="pp-row">{sameYear.map((x) => <PersonChip p={x} />)}</div>
      </section>
    )}

    <div class="pt-ad"><AdSlot slot="people-mid" /></div>

    {sameDay.length > 0 && (
      <section class="pt-sec">
        <div class="pt-sec__head"><div><h2>생일이 같은 인물</h2><p>{m}월 {d}일</p></div></div>
        <div class="pp-row">{sameDay.map((x) => <PersonChip p={x} sub="birth" />)}</div>
      </section>
    )}

    <p class="pp-note">
      ※ 생년월일·직업은 <a href={`https://www.wikidata.org/wiki/${p.id}`} target="_blank" rel="noopener nofollow">위키데이터</a>의 공개 정보를 바탕으로 정리했습니다({PEOPLE_UPDATED} 기준). 띠는 양력 출생연도 기준이라 음력 설 이전 출생자는 실제와 다를 수 있습니다.
      {p.credit && <> 사진: <a href={p.credit.url} target="_blank" rel="noopener nofollow">{p.credit.artist}</a>, {p.credit.license}, 위키미디어 코먼스.</>}
      {' '}정보가 틀렸거나 삭제를 원하시면 <a href="/contact/">문의</a>로 알려주세요.
    </p>
  </div>

  <script is:inline>
    (() => {
      // 오늘 날짜 기준 만 나이 + 다음 생일까지 남은 날
      var el = document.getElementById('pp-age'); if (!el) return;
      var b = el.dataset.birth.split('-').map(Number), n = new Date();
      var age = n.getFullYear() - b[0] - ((n.getMonth() + 1 < b[1] || (n.getMonth() + 1 === b[1] && n.getDate() < b[2])) ? 1 : 0);
      el.textContent = '만 ' + age + '세';
      var line = document.getElementById('pp-age-line'); if (line) line.textContent = '오늘 기준 만 나이는 ' + age + '세';
      var today = new Date(n.getFullYear(), n.getMonth(), n.getDate());
      var next = new Date(n.getFullYear(), b[1] - 1, b[2]); if (next < today) next = new Date(n.getFullYear() + 1, b[1] - 1, b[2]);
      var dd = Math.round((next - today) / 864e5);
      var bl = document.getElementById('pp-bday-line'); if (bl) bl.textContent = dd === 0 ? ' 오늘이 생일입니다.' : ' 다음 생일까지 ' + dd + '일 남았습니다.';
    })();
  </script>
</BaseLayout>
