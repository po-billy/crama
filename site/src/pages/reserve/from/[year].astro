---
// 전역연도별 예비군 — "2023년 전역 예비군 몇년차" 검색을 받는다.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReserveDetail from '../../../components/ReserveDetail.astro';
import { RESERVE_YEAR, MAX_GRADE, FROM_YEARS, gradeOf, stageOf, RESERVE_FAQ } from '../../../lib/reserve';

export function getStaticPaths() {
  return FROM_YEARS.map((y) => ({ params: { year: String(y) } }));
}
const dy = Number(Astro.params.year);
const grade = gradeOf(dy);
const st = stageOf(grade);
const gLabel = grade <= 0 ? '0년차' : grade > MAX_GRADE ? '예비군 만료' : `${grade}년차`;
const title = `${dy}년 전역 예비군 몇 년차? ${RESERVE_YEAR}년 ${gLabel} 훈련 정리`;
const desc = `${dy}년에 전역했다면 ${RESERVE_YEAR}년 예비군 ${gLabel}예요. ${st.summary} 예비군은 ${dy + MAX_GRADE}년 12월 31일에 끝나요.`;
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: RESERVE_FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const idx = FROM_YEARS.indexOf(dy);
const newer = FROM_YEARS[idx - 1];
const older = FROM_YEARS[idx + 1];
---
<BaseLayout title={title} description={desc} jsonLd={jsonLd}>
  <div class="wrap rp">
    <nav class="rp-crumb"><a href="/">홈</a> › <a href="/reserve/">예비군 연차 계산기</a> › <b>{dy}년 전역</b></nav>
    <h1>{dy}년 전역, {RESERVE_YEAR}년 예비군 {gLabel}</h1>
    <ReserveDetail grade={grade} dischargeYear={dy} />
    <div class="rp-pn">
      {older ? <a href={`/reserve/from/${older}/`}>← {older}년 전역</a> : <span></span>}
      <a href="/reserve/">계산기</a>
      {newer ? <a href={`/reserve/from/${newer}/`}>{newer}년 전역 →</a> : <span></span>}
    </div>
  </div>
  <style>
    .rp { max-width: 40rem; }
    .rp-crumb { font-size: 0.8rem; color: var(--muted); margin: 0.4rem 0 1.1rem; }
    .rp-crumb a { color: var(--muted); text-decoration: none; }
    .rp h1 { font-family: var(--font-serif); font-size: clamp(1.4rem, 4.5vw, 2rem); margin: 0 0 1rem; }
    .rp-pn { display: flex; justify-content: space-between; padding-top: 1.2rem; border-top: 1px solid var(--line); margin-bottom: 1.5rem; }
    .rp-pn a { font-size: 0.88rem; font-weight: 700; color: var(--accent); text-decoration: none; }
  </style>
</BaseLayout>
