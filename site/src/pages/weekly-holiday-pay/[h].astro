---
// 주 근무시간별 주휴수당 — "주 20시간 주휴수당", "주 15시간 주휴수당" 검색어용. 주휴시간 = 주 소정근로시간 ÷ 40 × 8(최대 8시간).
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/portal.css';

const HOURS = Array.from({ length: 26 }, (_, i) => i + 15);
export function getStaticPaths() { return Array.from({ length: 26 }, (_, i) => i + 15).map((h) => ({ params: { h: String(h) }, props: { h } })); }
const { h } = Astro.props as { h: number };
const WAGES = [{ y: 2026, w: 10_320 }, { y: 2027, w: 10_700 }];
const hol = Math.min(8, (h * 8) / 40);
const won = (n: number) => `${Math.round(n).toLocaleString('ko-KR')}원`;
const rows = WAGES.map((x) => ({ ...x, weekly: hol * x.w, month: hol * x.w * (365 / 7 / 12), pay: (h + hol) * x.w }));
const title = `주 ${h}시간 주휴수당 — 주 ${won(rows[0].weekly)}, 한 달 약 ${won(rows[0].month)} (2026·2027 최저시급)`;
const desc = `일주일에 ${h}시간 일하면 주휴시간은 ${hol}시간이에요. 2026년 최저시급 10,320원 기준 주휴수당은 주 ${won(rows[0].weekly)}, 2027년 10,700원이면 ${won(rows[1].weekly)}이에요. 받는 조건과 월 환산액까지.`;
const faq = [
  { q: `주 ${h}시간 일하면 주휴수당은 얼마인가요?`, a: `주휴시간은 ${h} ÷ 40 × 8 = ${hol}시간입니다. 최저시급 기준 2026년 ${won(rows[0].weekly)}, 2027년 ${won(rows[1].weekly)}입니다(내 시급이 더 높으면 시급 × ${hol}시간).` },
  { q: '주휴수당을 받는 조건은?', a: '일주일 소정근로시간이 15시간 이상이고, 그 주에 정해진 근무일을 모두 출근해야 합니다. 다음 주에도 계속 일하기로 되어 있어야 합니다. 5인 미만 사업장도 똑같이 적용됩니다.' },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title={title} description={desc} jsonLd={jsonLd}>
  <div class="pt pt-narrow" style="--c:#10b981">
    <nav class="pt-crumb" aria-label="현재 위치"><a href="/">홈</a> › <a href="/wage/">시급 → 월급</a> › 주 {h}시간 주휴수당</nav>
    <h1 style="font-size:1.7rem;font-weight:800;letter-spacing:-0.02em;margin:0 0 0.9rem">주 {h}시간 일하면 주휴수당은</h1>
    <div class="tl-result">
      <div class="tl-result__label">주휴시간 {hol}시간 · 2026 최저시급 10,320원 기준</div>
      <div class="tl-result__big">주 {won(rows[0].weekly)}</div>
      <div class="tl-result__sub">한 달 약 {won(rows[0].month)} · 주휴 포함 주급 {won(rows[0].pay)}</div>
    </div>
    <section class="pt-sec">
      <div class="tl-wrap"><table class="tl-table">
        <thead><tr><th>기준</th><th>주휴수당(주)</th><th>주휴수당(월)</th><th>주급(주휴 포함)</th></tr></thead>
        <tbody>{rows.map((r) => <tr><td>{r.y}년 {r.w.toLocaleString('ko-KR')}원</td><td>{won(r.weekly)}</td><td>{won(r.month)}</td><td>{won(r.pay)}</td></tr>)}</tbody>
      </table></div>
      <p class="pp-note">※ 주휴시간 = 주 소정근로시간 ÷ 40 × 8(최대 8시간). 월 환산은 한 달 평균 4.345주. 시급이 최저시급보다 높으면 내 시급으로 다시 계산하세요.</p>
    </section>
    <section class="pt-sec">
      <div class="pt-chips">
        {HOURS.filter((x) => Math.abs(x - h) <= 5 && x !== h).map((x) => <a class="pt-chip" href={`/weekly-holiday-pay/${x}/`}>주 {x}시간</a>)}
        <a class="pt-chip" href="/tools/hourly-wage-calculator/">내 시급으로 계산</a>
        <a class="pt-chip" href="/blog/2027-minimum-wage-10700-monthly-pay/">2027 최저시급</a>
      </div>
    </section>
    <section class="pt-sec pt-prose">
      <h2>자주 묻는 질문</h2>
      {faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
    </section>
  </div>
</BaseLayout>
